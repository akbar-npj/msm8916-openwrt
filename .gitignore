# Build output
bin/

# OpenWrt source tree
openwrt/

# Temporary build cache (if you ever create it)
dl/

# Recovery images (build output of ./build-recovery.sh)
msm89xx/recovery/*.img

# ...but the recovery initramfs is a frozen rootfs and IS checked in,
# including the static busybox that lives under its bin/ directory.
!msm89xx/recovery/irfs/bin/
!msm89xx/recovery/irfs/bin/*

# A rootfs unpacked into the repo root while building a recovery image
# (hmuf02v5 / mifib-v12).  Leading slash = repo root only, so it never
# shadows msm89xx/base-files/etc or packages/*/root/usr.  lib64 and var are
# symlinks (-> lib, -> tmp), hence no trailing slash on those two.
/etc/
/lib/
/lib64
/rom/
/sbin/
/usr/
/var

# Python
__pycache__/
*.pyc
.python-version

# Editor
.vscode/
.idea/

# Local notes
pr_description.md

#Book Keeping Directory
GitIgnore
ghidra_proj/
ghidra_scripts/
scratch/

# Firmware bundles built by msm89xx/image/generate_firmware.sh
.fwbuild/
