#!/bin/sh /etc/rc.common
# Copyright (C) 2007 OpenWrt.org
#
# Overridden by this project: run bluetoothd with --compat.
#
# bluez's SDP server only creates the local SDP Unix socket (/var/run/sdp) in
# compat mode (see bluez src/sdpd-server.c:init_server(): "if (!compat) {
# unix_sock = -1; return 0; }").  Without that socket there is no way to
# register an SDP record from userspace -- `sdptool add` fails with
# "Failed to connect to SDP server ... No such file or directory" -- which
# blocks the bt-spp server from advertising its Serial Port service.
#
# SDP_SERVER_COMPAT only gates the Unix socket; it changes nothing else.

#start after dbus (60)
START=62
USE_PROCD=1
PROG=/usr/bin/bluetoothd

start_service() {
	ln -snf /etc/bluetooth/keys/ /var/lib/bluetooth
	procd_open_instance
	procd_set_param command "$PROG" -n --compat
	procd_close_instance
}
