+/*
+ * Send GET_STATS with whatever mask the caller asks for and hand the raw
+ * response back untouched.  The normal path refuses anything but class A
+ * (see the check at the top of wcn36xx_smd_get_stats), so this exists only to
+ * find out what the firmware actually returns for the other masks -- class B
+ * in particular, which the firmware does implement.  Nothing in the driver
+ * calls it except the debugfs node.
+ *
+ * Returns the response length in bytes, or a negative error.
+ */
+int wcn36xx_smd_get_stats_raw(struct wcn36xx *wcn, u32 sta_index,
+			      u32 stats_mask, void *out, size_t out_len)
+{
+	struct wcn36xx_hal_stats_req_msg msg_body;
+	int ret;
+
+	mutex_lock(&wcn->hal_mutex);
+	INIT_HAL_MSG(msg_body, WCN36XX_HAL_GET_STATS_REQ);
+	msg_body.sta_id = sta_index;
+	msg_body.stats_mask = stats_mask;
+	PREPARE_HAL_BUF(wcn->hal_buf, msg_body);
+
+	ret = wcn36xx_smd_send_and_wait(wcn, msg_body.header.len);
+	if (ret)
+		goto out;
+
+	ret = wcn36xx_smd_rsp_status_check(wcn->hal_buf, wcn->hal_rsp_len);
+	if (ret)
+		goto out;
+
+	ret = wcn->hal_rsp_len;
+	if (ret > out_len)
+		ret = out_len;
+	memcpy(out, wcn->hal_buf, ret);
+out:
+	mutex_unlock(&wcn->hal_mutex);
+
+	return ret;
+}
