--- a/drivers/net/wireless/ath/wcn36xx/debug.c
+++ b/drivers/net/wireless/ath/wcn36xx/debug.c
@@ -219,6 +219,55 @@
 	.write = write_file_recal,
 };
 
+/*
+ * Ask the firmware for a stats block by mask and dump whatever comes back.
+ * The driver only ever parses class A, so this is the only way to see what
+ * the other masks (summary, class B, per-STA) actually return.
+ *
+ * Write "mask" or "mask,sta" in hex, e.g. "0x4" or "0x20,0".  The raw
+ * response, header included, goes to the kernel log as a hex dump.
+ *
+ * Measured on a mifib-v12: the firmware serves every mask, status 0 --
+ * summary 132 B, class A 68 B, class B 116 B, class C 60 B, class D 36 B,
+ * per-STA 60 B, header included.  On an idle link class B and class D are
+ * byte-identical across a 10 s gap, and the only fields that move in summary
+ * and class C are load-driven, not periodic: nothing increments at the beacon
+ * rate.  So there is no beacon or DTIM counter to poll, and this node is for
+ * inspection only.
+ */
+static ssize_t write_file_stats(struct file *file, const char __user *user_buf,
+				size_t count, loff_t *ppos)
+{
+	struct wcn36xx *wcn = file->private_data;
+	u8 raw[512];
+	char buf[32];
+	u32 mask = 0;
+	u32 sta = 0;
+	int ret;
+
+	if (count >= sizeof(buf))
+		return -EINVAL;
+	if (copy_from_user(buf, user_buf, count))
+		return -EFAULT;
+	buf[count] = '\0';
+
+	if (sscanf(buf, "%x,%u", &mask, &sta) < 1)
+		mask = HAL_GLOBAL_CLASS_A_STATS_INFO;
+
+	ret = wcn36xx_smd_get_stats_raw(wcn, sta, mask, raw, sizeof(raw));
+	wcn36xx_info("stats raw, mask 0x%x sta %u, %d bytes\n", mask, sta, ret);
+	if (ret > 0)
+		print_hex_dump(KERN_INFO, "wcn36xx stats: ", DUMP_PREFIX_OFFSET,
+			       16, 1, raw, ret, false);
+
+	return count;
+}
+
+static const struct file_operations fops_wcn36xx_stats = {
+	.open = simple_open,
+	.write = write_file_stats,
+};
