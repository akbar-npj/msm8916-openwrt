--- a/drivers/net/wireless/ath/wcn36xx/pmc.c
+++ b/drivers/net/wireless/ath/wcn36xx/pmc.c
@@ -20,11 +20,41 @@
 
 #define WCN36XX_BMPS_FAIL_THREHOLD 3
 
+/*
+ * Concurrency: BMPS is a per-BSS firmware power mode that assumes the radio
+ * is dedicated to a single station.  When more than one interface is running
+ * (e.g. AP + STA), keep the radio awake -- qcacld disables BMPS in
+ * concurrency for the same reason.
+ *
+ * mac80211 already forces PS off whenever an AP vif is running, so this is a
+ * belt-and-braces guard covering the window in which a second interface is
+ * brought up while the station is already in BMPS.
+ */
+static bool wcn36xx_has_concurrent_vifs(struct wcn36xx *wcn)
+{
+	struct wcn36xx_vif *tmp;
+	int count = 0;
+
+	list_for_each_entry(tmp, &wcn->vif_list, list) {
+		if (++count > 1)
+			return true;
+	}
+
+	return false;
+}
+
