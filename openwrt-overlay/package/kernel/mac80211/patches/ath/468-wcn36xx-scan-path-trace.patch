+/*
+ * Diagnostic tracing of the scan path.  Off by default; enable with
+ *   insmod wcn36xx scan_trace=1   or
+ *   echo 1 > /sys/module/wcn36xx/parameters/scan_trace
+ * Used to find which firmware call in the scan path revives a stalled AP
+ * downlink (issue #122).
+ */
+extern bool wcn36xx_scan_trace;
+
+#define WCN36XX_TRACE(fmt, ...)						\
+	do {								\
+		if (wcn36xx_scan_trace)					\
+			pr_info("wcn36xx-trace: " fmt, ##__VA_ARGS__);	\
+	} while (0)
