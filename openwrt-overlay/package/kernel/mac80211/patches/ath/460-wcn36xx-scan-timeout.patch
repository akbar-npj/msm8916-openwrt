+/*
+ * The firmware is not obliged to answer a scan request.  When it stays silent
+ * wcn->scan_req is never cleared and every later scan is rejected with -EBUSY,
+ * which leaves the station unable to associate until the module is reloaded.
+ * Bound the wait and complete the scan ourselves.
+ */
+#define WCN36XX_SCAN_TIMEOUT_MS	15000
+
+static void wcn36xx_scan_timeout_work(struct work_struct *work)
+{
+	struct wcn36xx *wcn = container_of(to_delayed_work(work),
+					   struct wcn36xx, scan_timeout);
+	struct cfg80211_scan_info scan_info = {
+		.aborted = true,
+	};
+
+	mutex_lock(&wcn->scan_lock);
+	if (!wcn->scan_req) {
+		mutex_unlock(&wcn->scan_lock);
+		return;
+	}
+	wcn->scan_req = NULL;
+	mutex_unlock(&wcn->scan_lock);
+
+	wcn36xx_warn("scan did not complete in %d ms, aborting\n",
+		     WCN36XX_SCAN_TIMEOUT_MS);
+	ieee80211_scan_completed(wcn->hw, &scan_info);
+}
+
 static int wcn36xx_hw_scan(struct ieee80211_hw *hw,
 			   struct ieee80211_vif *vif,
 			   struct ieee80211_scan_request *hw_req)
 {
 	struct wcn36xx *wcn = hw->priv;
+	int ret;
 
 	if (!wcn36xx_firmware_get_feat_caps(wcn->fw_feat_caps, SCAN_OFFLOAD)) {
 		/* fallback to mac80211 software scan */
@@ -684,7 +716,19 @@
 	mutex_unlock(&wcn->scan_lock);
 
 	wcn36xx_smd_update_channel_list(wcn, &hw_req->req);
-	return wcn36xx_smd_start_hw_scan(wcn, vif, &hw_req->req);
+
+	ret = wcn36xx_smd_start_hw_scan(wcn, vif, &hw_req->req);
+	if (ret) {
+		/* A refused scan is never followed by an indication. */
+		mutex_lock(&wcn->scan_lock);
+		wcn->scan_req = NULL;
+		mutex_unlock(&wcn->scan_lock);
+		return ret;
+	}
+
+	schedule_delayed_work(&wcn->scan_timeout,
+			      msecs_to_jiffies(WCN36XX_SCAN_TIMEOUT_MS));
+	return 0;
 }
 
