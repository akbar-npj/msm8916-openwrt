+/*
+ * Interface combinations.
+ *
+ * The firmware supports up to 2 BSSIDs, and this is a single radio with a
+ * single operating channel, so every interface shares one channel.
+ * Declaring combinations lets mac80211 accept a second interface:
+ *
+ *   - two APs (multi-SSID), or
+ *   - one AP plus one station (concurrent AP+STA).
+ *
+ * Without any combination mac80211 treats the wiphy as single-interface-only
+ * and rejects a second interface with -EBUSY.
+ *
+ * ADHOC/MESH are deliberately left out: mac80211 rejects any combination that
+ * permits more than one IBSS interface, and listing them makes wiphy
+ * registration fail.
+ */
+static const struct ieee80211_iface_limit wcn36xx_iface_limits_ap[] = {
+	{
+		.max = 2,
+		.types = BIT(NL80211_IFTYPE_AP),
+	},
+};
+
+static const struct ieee80211_iface_limit wcn36xx_iface_limits_ap_sta[] = {
+	{
+		.max = 1,
+		.types = BIT(NL80211_IFTYPE_AP),
+	},
+	{
+		.max = 1,
+		.types = BIT(NL80211_IFTYPE_STATION),
+	},
+};
+
+static const struct ieee80211_iface_combination wcn36xx_iface_combinations[] = {
+	{
+		.num_different_channels = 1,
+		.max_interfaces = 2,
+		.n_limits = ARRAY_SIZE(wcn36xx_iface_limits_ap),
+		.limits = wcn36xx_iface_limits_ap,
+	},
+	{
+		.num_different_channels = 1,
+		.max_interfaces = 2,
+		.n_limits = ARRAY_SIZE(wcn36xx_iface_limits_ap_sta),
+		.limits = wcn36xx_iface_limits_ap_sta,
+	},
+};
+
