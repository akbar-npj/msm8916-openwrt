--- a/drivers/net/wireless/ath/wcn36xx/smd.c
+++ b/drivers/net/wireless/ath/wcn36xx/smd.c
@@ -36,6 +36,18 @@
 	.value = val \
 }
 
+/*
+ * Firmware rate-adaptation start rate, sent as
+ * ENABLE_DYNAMIC_RA_START_RATE when the MAC starts.  135 (MCS 7) is the
+ * WCN3620 default after the PMF throughput A/B; the generic table's 133
+ * (MCS 5) held the AP at MCS 1 when PMF blocked ADDBA.  The 3680 table has
+ * its own tuned value and is never overridden.  -1 keeps the table value.
+ */
+static int ra_start_rate = 135;
+module_param(ra_start_rate, int, 0644);
+MODULE_PARM_DESC(ra_start_rate,
+		 "WCN3620 RA start rate (-1 keeps the table value, default 135)");
+
 static struct wcn36xx_cfg_val wcn36xx_cfg_vals[] = {
 	WCN36XX_CFG_VAL(CURRENT_TX_ANTENNA, 1),
 	WCN36XX_CFG_VAL(CURRENT_RX_ANTENNA, 1),
@@ -638,9 +650,20 @@
 		cfg_elements = ARRAY_SIZE(wcn36xx_cfg_vals);
 	}
 
+	wcn36xx_info("rf_id 0x%x, %s cfg table (%d entries), ra_start_rate override %d\n",
+		     wcn->rf_id,
+		     wcn->rf_id == RF_IRIS_WCN3680 ? "wcn3680" : "generic",
+		     cfg_elements, ra_start_rate);
+
 	for (i = 0; i < cfg_elements; i++) {
-		ret = put_cfg_tlv_u32(wcn, &len, cfg_vals[i].cfg_id,
-				      cfg_vals[i].value);
+		u32 value = cfg_vals[i].value;
+
+		if (ra_start_rate >= 0 &&
+		    wcn->rf_id != RF_IRIS_WCN3680 &&
+		    cfg_vals[i].cfg_id == WCN36XX_HAL_CFG_ENABLE_DYNAMIC_RA_START_RATE)
+			value = ra_start_rate;
+
+		ret = put_cfg_tlv_u32(wcn, &len, cfg_vals[i].cfg_id, value);
 		if (ret)
 			goto out;
 	}
