#!/bin/sh /etc/rc.common

# ims-profile-watch: re-create the "ims" WDS profile after a runtime modem boot.
#
# The AP-boot case is handled synchronously by S94 ims-profile; this daemon only
# has to notice the modem restarting later (crash recovery, Stage 3 SSR) and
# redo the profile + the imsdcm restart.  See
# Docs/Modem Stability/220_VOLTE_ENABLEMENT_SOP.md (F29/F30, S23).

START=97
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/ims-profile-watch
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
