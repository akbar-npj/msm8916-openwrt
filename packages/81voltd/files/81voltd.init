#!/bin/sh /etc/rc.common

# 81voltd: QMI IMS Data service (IMSD, service 770) for VoLTE.
#
# The modem (hybrid IMS mode) asks the AP over QRTR to bring up the "ims" PDN;
# 81voltd creates the bearer via ModemManager and reports the IP back. It needs
# ModemManager on D-Bus and qrtr-ns running, so it starts late and respawns
# until ModemManager is available.

START=96
STOP=10
USE_PROCD=1

start_service() {
	local linkup_reply linkup_delay

	# ufi-voice ships imsdcm, the newer implementation of the same QMI
	# service 770. Two servers for one service fight over the modem's IMSD
	# requests: the bearer gets created and removed in a loop and IMS never
	# registers. imsdcm wins whenever it is installed; 81voltd stays for
	# images that do not carry ufi-voice.
	if [ -x /usr/sbin/imsdcm ]; then
		logger -t 81voltd "imsdcm is installed, leaving service 770 to it"
		return 0
	fi

	# How to answer the modem's IMSD 0x23 link-up announcement:
	#   down (default) -> err_code 13, modem must send 0x20 Start Connection
	#   up             -> success, 81voltd starts the "ims" PDN itself
	linkup_reply="$(uci -q get 81voltd.config.linkup_reply)"
	linkup_delay="$(uci -q get 81voltd.config.linkup_delay)"

	procd_open_instance
	procd_set_param command /usr/bin/81voltd
	[ -n "$linkup_reply" ] && procd_set_param env IMSD_LINKUP_REPLY="$linkup_reply"
	[ -n "$linkup_delay" ] && procd_set_param env IMSD_LINKUP_DELAY="$linkup_delay"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger modemmanager
}
