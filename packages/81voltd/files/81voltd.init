#!/bin/sh /etc/rc.common

# 81voltd: QMI IMS Data service (IMSD, service 770) for VoLTE.
#
# The modem (hybrid IMS mode) asks the AP over QRTR to bring up the "ims" PDN;
# 81voltd creates the bearer via ModemManager and reports the IP back. It needs
# ModemManager on D-Bus and qrtr-ns running, so it starts late and respawns
# until ModemManager is available.

START=96
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/81voltd
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger modemmanager
}
