#!/bin/sh
# Create the `ims` WDS profile the moment the modem's QMI port appears.
#
# The modem's IMS stack reads the WDS profile table once, early in its boot,
# and the carrier MCFG declares the ims PDN with Override_Type:API, so no ims
# profile is materialised for it. A profile created after the modem has booted
# (the init.d fallback runs at START=94) is invisible to the IMS stack and IMS
# never registers.
#
# The wwan_port uevent is emitted as the port is created, which is the earliest
# point the AP can talk QMI to a freshly booted modem -- and the point at which
# the proven SSR recipe creates the profile (about 2 s after the restart).

[ "$ACTION" = "add" ] || exit 0
[ "$DEVTYPE" = "wwan_port" ] || exit 0
[ "$DEVNAME" = "wwan0qmi0" ] || exit 0

exec /usr/sbin/ims-profile-setup
