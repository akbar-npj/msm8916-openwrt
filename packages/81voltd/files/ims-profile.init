#!/bin/sh /etc/rc.common

# ims-profile: create the "ims" WDS profile at every modem boot.
#
# Runs before 81voltd (S96) so the profile exists by the time the modem's IMS
# stack reads the WDS profile table.  See
# Docs/Modem Stability/220_VOLTE_ENABLEMENT_SOP.md (F29/F30, S23).
#
# Deliberately synchronous and not a procd service: procd restarts an instance
# that exits (which created a new profile every 5 s), and backgrounding the
# helper loses it when the init shell exits.  Blocking here is what we want --
# it also removes the race between this helper and 81voltd.

START=94
STOP=10

start() {
	/usr/sbin/ims-profile-setup
}

stop() {
	return 0
}
