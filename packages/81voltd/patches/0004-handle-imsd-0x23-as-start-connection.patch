EXPERIMENT: handle IMSD message 0x23 as an implicit Start Connection.

The DPM.2.0.2 modem sends 0x23 (not the documented 0x20) once per
boot, carrying its per-boot IMS interface link-local IPv6 address.
Treat it as "bring up the ims PDN": create the bearer with APN ims /
IPv6 and answer with a start-connection response, so the modem gets a
connection handle and (hopefully) starts its IMS enabler.

--- a/qvd-server.c
+++ b/qvd-server.c
@@ -18,6 +18,8 @@
 
 #define IMSD_START_CONNECTION 0x20
 #define IMSD_STOP_CONNECTION 0x21
+/* DPM.2.0.2 sends this at every modem boot instead of 0x20. */
+#define IMSD_START_CONNECTION_ALT 0x23
 
 #define IMSD_CONNECTION_CHANGED 0x20
 
@@ -343,6 +345,60 @@
 	connect_data->subscription_id = req.subscription;
 }
 
+/*
+ * The DPM.2.0.2 firmware sends message 0x23 on the IMS data service at every
+ * modem boot instead of the documented 0x20 Start Connection.  Its single
+ * TLV (0x01) carries the modem's per-boot IMS interface link-local IPv6
+ * address, not an APN.  Treat it as an implicit "bring up the ims PDN"
+ * request: create the bearer with the default IMS APN and answer with a
+ * start-connection response so the modem gets a connection handle.
+ */
+static void process_start_connection_alt(QVDServer *server, QVDMessage *msg)
+{
+	QVDConnection *conn;
+	GError *err = NULL;
+	struct imsd_no_op_req req;
+	struct qvd_connect_data *connect_data;
+	gint *client;
+	guint node, port;
+
+	g_info("Req: message 0x23, treating as Start Connection (experiment)\n");
+
+	// Decoding is required before a response can be sent; the payload layout
+	// is unknown, so consume it with the permissive no-op request.
+	qvd_message_decode(msg, &req, imsd_no_op_req_ei, &err);
+	if (err != NULL) {
+		g_printerr("IMSD 0x23: failed to decode request: %s\n", err->message);
+		g_clear_error(&err);
+		encode_error(msg, 1);
+		return;
+	}
+
+	// Register the client for indications.
+	g_object_get(msg, "peer-node", &node, "peer-port", &port, NULL);
+	client = g_malloc(sizeof(gint));
+	*client = (node << 16) | port;
+	g_hash_table_add(server->clients, client);
+
+	connect_data = g_malloc(sizeof(*connect_data));
+	connect_data->msg = msg;
+	connect_data->server = g_object_ref(server);
+
+	conn = qvd_modem_get_connection(server->modem, "ims", MM_BEARER_IP_FAMILY_IPV6,
+					0xffff, NULL, on_connection_opened, connect_data);
+	if (conn == NULL) {
+		g_printerr("IMSD 0x23: modem not present\n");
+		g_clear_error(&err);
+		encode_error(msg, 1);
+		g_free(connect_data);
+		return;
+	}
+
+	connect_data->conn = conn;
+	connect_data->connection_id = 1;
+	connect_data->subscription_id = 1;
+}
+
 static void process_stop_connection(QVDServer *server, QVDMessage *msg)
 {
 	QVDConnection *conn;
@@ -405,6 +461,8 @@
 
 	if (msg_id == IMSD_START_CONNECTION)
 		process_start_connection(server, msg);
+	else if (msg_id == IMSD_START_CONNECTION_ALT)
+		process_start_connection_alt(server, msg);
