 /*
- * EXPERIMENT: the DPM.2.0.2 IMS data client announces its own link-local
- * address with message 0x23 at every boot.  Answering it with success makes
- * the modem assume a data path exists and it then goes silent.  Reply with the
- * documented "connection down" result (err_status 0, err_code 13) instead and
- * see whether it then sends the documented 0x20 Start Connection request.
+ * The DPM.2.0.2 IMS data client announces an IMS link with message 0x23
+ * instead of sending the documented 0x20 Start Connection.
+ *
+ * TLV 0x01 of that request, as observed on MPSS.DPM.2.0.2 (31 bytes), is
+ *   u16 unknown (0x238b) | u32 connection (1) | u8 addr_len | addr
+ * where the address is the modem's own link-local (fe80::/64) endpoint.
+ *
+ * The reply is selectable so both hypotheses can be A/B tested without a
+ * rebuild:
+ *   IMSD_LINKUP_REPLY=down (default) reply err_code 13 ("connection down")
+ *                          and do not start a PDN ourselves; the modem is
+ *                          then expected to send 0x20 Start Connection.
+ *   IMSD_LINKUP_REPLY=up   reply success and bring the "ims" PDN up after
+ *                          90 s (previous behaviour).
  */
 static void process_link_up(QVDServer *server, QVDMessage *msg)
 {
@@ -401,31 +425,70 @@
