+static gboolean link_up_start_connection(gpointer data)
+{
+	QVDServer *server = QVD_SERVER(data);
+	struct qvd_connect_data *cd;
+	QVDConnection *conn;
+
+	if (server->modem == NULL) {
+		g_printerr("IMSD link-up: no modem yet, retrying in 90s\n");
+		return G_SOURCE_CONTINUE;
+	}
+
+	g_info("IMSD link-up: starting the \"ims\" PDN\n");
+
+	cd = g_malloc(sizeof(*cd));
+	cd->msg = NULL;
+	cd->server = g_object_ref(server);
+	cd->connection_id = 0;
+	cd->subscription_id = 0;
+
+	conn = qvd_modem_get_connection(server->modem, "ims",
+					MM_BEARER_IP_FAMILY_IPV4, 0xffff,
+					NULL, on_connection_opened, cd);
+	if (conn == NULL) {
+		g_printerr("IMSD link-up: modem not present\n");
+		g_object_unref(cd->server);
+		g_free(cd);
+		return G_SOURCE_CONTINUE;
+	}
+	cd->conn = conn;
+
+	g_object_unref(server);
+	return G_SOURCE_REMOVE;
+}
+
+/*
+ * EXPERIMENT: the DPM.2.0.2 IMS data client announces its own link-local
+ * address with message 0x23 at every boot.  Answering it with success makes
+ * the modem assume a data path exists and it then goes silent.  Reply with the
+ * documented "connection down" result (err_status 0, err_code 13) instead and
+ * see whether it then sends the documented 0x20 Start Connection request.
+ */
+static void process_link_up(QVDServer *server, QVDMessage *msg)
+{
+	struct imsd_no_op_req req;
+	struct imsd_no_op_resp resp = {
+		.res = { .err_status = 0, .err_code = 0, },
+	};
+	GError *err = NULL;
+	guint node, port;
+	gint *client;
+
+	g_object_get(msg, "peer-node", &node, "peer-port", &port, NULL);
+	client = g_malloc(sizeof(gint));
+	*client = (node << 16) | port;
+	g_hash_table_add(server->clients, client);
+
+	g_info("IMSD link-up (0x23): answering SUCCESS (err_code 0)\n");
+
+	qvd_message_decode(msg, &req, imsd_no_op_req_ei, &err);
+	if (err != NULL) {
+		g_printerr("IMSD link-up: decode: %s\n", err->message);
+		err = NULL;
+	}
+
+	qvd_message_respond(msg, &resp, imsd_no_op_resp_ei, &err);
+	if (err != NULL)
+		g_printerr("IMSD link-up: respond: %s\n", err->message);
+
+	/*
+	 * This firmware never sends the documented 0x20 Start Connection, so
+	 * bring the IMS PDN up ourselves.  It has to happen after the modem has
+	 * registered (MM refuses to create a bearer before that), which is why
+	 * the work is deferred to a timer instead of done inline here.
+	 */
+	g_timeout_add_seconds(90, link_up_start_connection, g_object_ref(server));
+
+	g_object_unref(msg);
+}
