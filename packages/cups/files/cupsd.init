#!/bin/sh /etc/rc.common

START=90
STOP=10
USE_PROCD=1

PROG=/usr/sbin/cupsd
CONF=/etc/cups/cupsd.conf

start_service() {
    [ -f "$PROG" ] || return 1
    
    mkdir -p /var/spool/cups /var/log/cups /var/cache/cups /var/run/cups /etc/cups/ppd
    chown -R nobody:nogroup /var/spool/cups /var/log/cups /var/cache/cups /var/run/cups 2>/dev/null || true
    sed -i 's/^SystemGroup .*/SystemGroup root/' /etc/cups/cups-files.conf 2>/dev/null || true
    
    procd_open_instance
    procd_set_param command "$PROG" -F
    procd_set_param respawn
    procd_close_instance
}

stop_service() {
    killall cupsd 2>/dev/null || true
}
