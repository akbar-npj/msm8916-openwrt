{
	"luci-app-wifi-sta": {
		"description": "Grant access to Station Mode configuration",
		"read": {
			"uci": [ "wifista", "wireless", "uplink" ],
			"ubus": {
				"service": [ "list" ]
			},
			"file": {
				"/etc/config/wifista": [ "read" ],
				"/usr/sbin/wifi-sta-up": [ "exec" ],
				"/etc/init.d/wifi-sta-late": [ "exec" ],
				"/usr/sbin/iw": [ "exec" ],
				"/usr/bin/iwinfo": [ "exec" ],
				"/sbin/logread": [ "exec" ],
				"/tmp/uplink.json": [ "read" ]
			}
		},
		"write": {
			"uci": [ "wifista", "uplink" ],
			"ubus": {
			"service": [ "list" ]
			},
			"file": {
				"/etc/config/wifista": [ "write" ],
				"/usr/sbin/wifi-sta-up": [ "exec" ],
				"/etc/init.d/wifi-sta-late": [ "exec" ],
				"/etc/init.d/uplink-manager": [ "exec" ]
			}
		}
	}
}
