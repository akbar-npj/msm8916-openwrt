#!/bin/sh /etc/rc.common
#
# uf896-simsel watchdog - re-apply AT+SIMSEL whenever the modem reconnects.
# Board-gated to UF896 (v1.1); on every other board this service is a no-op.

START=62
USE_PROCD=1

. /lib/functions.sh

boot() { start; }

start_service() {
    # Only the UF896 selects its SIM over AT+SIMSEL.
    case "$(board_name)" in
        *uf896*) ;;
        *) return 0 ;;
    esac

    config_load uf896-simsel
    local enabled
    config_get_bool enabled simsel enabled 0
    [ "$enabled" -eq 1 ] || return 0

    procd_open_instance
    procd_set_param command /usr/sbin/uf896-simsel monitor
    procd_set_param respawn
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger uf896-simsel
}
