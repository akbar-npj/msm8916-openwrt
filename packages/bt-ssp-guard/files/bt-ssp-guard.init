#!/bin/sh /etc/rc.common
# /etc/init.d/bt-ssp-guard
# Keep the WCNSS BT controller's Secure Simple Pairing feature bit set.
# The BT NVM is RAM-only, so this runs once per boot (a silent no-op when the
# firmware default is already good).  See /usr/sbin/bt-ssp-guard for details.

START=96
STOP=10

USE_PROCD=1
PROG=/usr/sbin/bt-ssp-guard

start_service() {
	# No `respawn`: this is a one-shot.  The script waits internally (up to
	# 90 s) for hci0 to come up, so procd does not block the boot sequence.
	procd_open_instance
	procd_set_param command "$PROG" repair --wait
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	killall bt-ssp-guard 2>/dev/null || true
}
