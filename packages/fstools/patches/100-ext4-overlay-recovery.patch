--- a/mount_root.c	2026-05-23 21:29:55.000000000 +0545
+++ b/mount_root.c	2026-08-30 00:18:06.683899083 +0545
@@ -26,6 +26,30 @@
 
 #define BUFLEN 64
 
+static int format_ext4(struct volume *v)
+{
+	char cmd[512];
+	if (!v || !v->blk) return -1;
+	ULOG_WARN("Formatting overlay filesystem on %s as EXT4\n", v->blk);
+	snprintf(cmd, sizeof(cmd), "export PATH=/usr/sbin:/usr/bin:/sbin:/bin; mkfs.ext4 -q -F -O ^has_journal -L rootfs_data %s >/dev/kmsg 2>&1", v->blk);
+	if (system(cmd) != 0) return -1;
+	sync();
+	volume_init(v);
+	return (volume_identify(v) == FS_EXT4) ? 0 : -1;
+}
+
+static void check_ext4(struct volume *v)
+{
+	char cmd[512];
+	if (!v || !v->blk) return;
+	ULOG_INFO("Checking EXT4 overlay on %s\n", v->blk);
+	snprintf(cmd, sizeof(cmd), "export PATH=/usr/sbin:/usr/bin:/sbin:/bin; e2fsck -p %s >/dev/kmsg 2>&1", v->blk);
+	if (system(cmd) > 2) {
+		ULOG_ERR("e2fsck failed, re-formatting %s as EXT4...\n", v->blk);
+		format_ext4(v);
+	}
+}
+
 /*
  * Called in the early (PREINIT) stage, when we immediately need some writable
