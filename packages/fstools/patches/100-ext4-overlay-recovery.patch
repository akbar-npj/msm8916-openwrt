+enum ext4_check_result {
+	EXT4_OK,
+	EXT4_REPAIRED,
+	EXT4_FORMAT_REQUIRED,
+	EXT4_FAILED,
+};
+
+static int run_command(const char *fmt, ...)
+{
+	char cmd[512];
+	va_list ap;
+	int status;
+
+	va_start(ap, fmt);
+	vsnprintf(cmd, sizeof(cmd), fmt, ap);
+	va_end(ap);
+
+	ULOG_INFO("Executing: %s\n", cmd);
+
+	status = system(cmd);
+
+	if (status == -1) {
+        ULOG_ERR("system() failed\n");
+        return -1;
+        }
+
+	if (!WIFEXITED(status)) {
+        ULOG_ERR("Command terminated abnormally\n");
+        return -1;
+        }
+
+	return WEXITSTATUS(status);
+}
+
+static enum ext4_check_result check_ext4(struct volume *v)
+{
+	int rc;
+
+	/* NOTE:
+	 * Assumes struct volume has a member named 'blk'
+	 * containing the block device path.
+	 */
+	if (!v || !v->blk)
+		return EXT4_FAILED;
+
+	ULOG_INFO("Checking overlay filesystem on %s\n", v->blk);
+
+	rc = run_command(
+		"e2fsck -fy %s >/dev/kmsg 2>&1",
+		v->blk);
+
+	switch (rc) {
+	case 0:
+		ULOG_INFO("Overlay filesystem is clean\n");
+		return EXT4_OK;
+
+	case 1:
+	case 2:
+	case 3:
+		ULOG_INFO("Overlay filesystem repaired successfully\n");
+		return EXT4_REPAIRED;
+
+	default:
+		/*
+		 * e2fsck returns a bitmask:
+		 *   1 = filesystem errors corrected
+		 *   2 = system should be rebooted
+		 *   4 = filesystem errors left uncorrected
+		 *   8 = operational error
+		 *  16 = usage/syntax error
+		 *  32 = canceled by user
+		 * 128 = shared library error
+		 */
+		if (rc & 4) {
+			ULOG_WARN("Overlay filesystem is corrupted beyond repair\n");
+			return EXT4_FORMAT_REQUIRED;
+		}
+
+		ULOG_ERR("e2fsck failed (exit code %d)\n", rc);
+		return EXT4_FAILED;
+	}
+}
