#!/bin/sh /etc/rc.common

START=95
STOP=10

NAME=msm-firmware-dumper
PROG="/usr/bin/msm-firmware-dumper"
FLAG="/lib/firmware/DUMPED"

start() {
    [ -f "$FLAG" ] && return 0

	local timeout=30
	while [ $timeout -gt 0 ]; do
		if [ -d /overlay/upper ] || grep -q -E ' (overlay|/overlay) ' /proc/mounts || [ -w /lib/firmware ]; then
			logger -t "$NAME" "Writable rootfs/overlay detected, proceeding"
			break
		fi
		sleep 1
		timeout=$((timeout - 1))
	done
	
	logger -t "$NAME" "Starting firmware dump"
	
	if FLAG="$FLAG" $PROG; then
		logger -t "$NAME" "Firmware dump successful"
		sync
		/etc/init.d/rmtfs restart 2>/dev/null || true
		sleep 1
		for rproc in /sys/class/remoteproc/remoteproc*; do
			[ -d "$rproc" ] && echo start > "$rproc/state" 2>/dev/null || true
		done
		# WCNSS takes several seconds after the firmware dump before the
		# wiphy is enumerable.  Without this wait `wifi config` runs too
		# early, generates no radio, and the defaults below have nothing
		# to apply -- observed on a fresh sysupgrade -n.
		_wait=20
		while [ "$_wait" -gt 0 ] && ! ls /sys/class/ieee80211/phy* >/dev/null 2>&1; do
			sleep 1
			_wait=$((_wait - 1))
		done
		if ! uci -q get wireless.radio0.path >/dev/null; then
			rm -f /etc/config/wireless
			/sbin/wifi config 2>/dev/null || true
		fi
		# This is the config that actually sticks on a fresh flash: the
		# uci-defaults copy ran before the firmware existed, so it had no
		# radio to configure.  Re-apply the 20 dBm / WPA2 defaults here.
		[ -x /usr/sbin/wifi-defaults ] && /usr/sbin/wifi-defaults
		/sbin/wifi reload 2>/dev/null || true
	else
		logger -t "$NAME" "Firmware dump FAILED"
		return 1
	fi
}
