USE_PROCD=1
START=95
STOP=01


start_service() {
    # Fill in the modem ports and the SIM-derived country prefix first: the
    # LED helper below is a one-shot that needs readport.  Backgrounded
    # because it polls ModemManager for up to ~30 s while it enumerates; the
    # helper waits for the result.
    [ -x /usr/sbin/sms_manager_autoconfig ] && /usr/sbin/sms_manager_autoconfig >/dev/null 2>&1 &

    procd_open_instance
    procd_set_param command /bin/sh "/sbin/sms_manager_led.sh"
    procd_close_instance
}


service_triggers()
{
        procd_add_reload_trigger "sms_manager"
}


stop_service() {
	for KILLPID in `ps | grep 'sms_manager' | awk ' { print $1;}'`; do 
  	kill -9 $KILLPID >/dev/null 2>&1 &
	done
	sleep 1
	return 0
}


restart_service() {
    stop_service
    start_service
}
