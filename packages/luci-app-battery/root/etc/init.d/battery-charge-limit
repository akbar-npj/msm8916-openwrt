#!/bin/sh /etc/rc.common
#
# Procd init for the battery-charge-limit monitor.
# Stops charging at 85% (configurable in the script) to extend battery life,
# while the device keeps drawing from the USB/VBUS supply path.

START=97
STOP=10

USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/battery-charge-limit
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	# Leave charging enabled (default) on stop.
	for d in /sys/class/power_supply/*; do
		[ -w "$d/charge_enabled" ] && echo 1 > "$d/charge_enabled" 2>/dev/null
	done
}
