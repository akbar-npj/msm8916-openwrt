#!/bin/sh /etc/rc.common
#
# Procd init for the battery-removal guard.
#
# The PM8916 LBC cannot carry the system on VBUS alone: once the pack is
# pulled the AP runs on borrowed time and then browns out, which leaves
# the filesystem unsynced.  battery-guard watches POWER_SUPPLY_PROP_PRESENT
# and shuts the system down cleanly instead of letting the rail collapse.

START=97
STOP=10

USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/battery-guard
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
