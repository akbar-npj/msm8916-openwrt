#!/bin/sh /etc/rc.common

START=96
STOP=10
USE_PROCD=1

start_service()
{
        procd_open_instance

        procd_set_param command /usr/sbin/battery-led-monitor

        # Restart the monitor if it unexpectedly exits.
        procd_set_param respawn 3600 5 5

        procd_set_param stdout 1
        procd_set_param stderr 1

        procd_close_instance
}

stop_service()
{
        for led in /sys/class/leds/green:bat /sys/class/leds/red:bat; do
                [ -e "$led/trigger" ] || continue
                echo none > "$led/trigger" 2>/dev/null
                echo 0 > "$led/brightness" 2>/dev/null
        done
}
