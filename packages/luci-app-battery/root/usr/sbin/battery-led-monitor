#!/bin/sh
#
# Battery gauge LEDs.
#
#   mifib-v12   green:bat / red:bat
#   mf800b      green:charging / red:charging
#
#   green blink 1000/1000   charging
#   green solid             charge complete
#   red fast blink 150/150  gauge present but unreadable (driver/thermistor fault)
#   both off                discharging normally, no battery, or no gauge
#
# The pair carries CHARGE STATE ONLY.  Capacity is deliberately not encoded:
# a percentage cannot be read off a blink pattern, and LuCI already reports it
# with the runtime estimate (Status -> Overview and the Battery page).  The one
# exception is the unreadable gauge, which is a fault rather than a level.
#
# mf800b binds red:charging to the kernel trigger "pm8916-bms-vm-charging", so
# the first write here takes the lamp over (trigger=none) and the green half
# carries the charging indication instead -- the same green = charging /
# red = fault pairing mifib-v12 uses.
#
# The gauge only exists once the PMIC VADC and the BMS have probed, so "no
# battery" and "battery broken" are deliberately different states.

case "${1:-}" in
        -h|--help)
                cat <<'USAGE'
Usage: battery-led-monitor [--help]

Drive the battery green/red pair from /sys/class/power_supply.  Started by
procd (/etc/init.d/battery-led-monitor); takes no arguments.

States:
  green blink 1000/1000   charging
  green solid             charge complete
  red fast blink 150/150  battery device present but capacity unreadable
  both off                discharging, no battery device, or no gauge

Capacity is not shown on the LEDs -- use LuCI (Status -> Overview, Battery).
USAGE
                exit 0
                ;;
esac

POLL=5
BLINK_ON=1000
BLINK_OFF=1000
FAST_ON=150
FAST_OFF=150

pick_led()
{
        for n in "$@"; do
                [ -e "/sys/class/leds/$n/trigger" ] && { echo "/sys/class/leds/$n"; return 0; }
        done

        return 1
}

GREEN=$(pick_led green:bat green:charging) || GREEN=""
RED=$(pick_led red:bat red:charging) || RED=""

led_set()
{
        local led="$1" mode="$2" on="${3:-500}" off="${4:-500}"

        [ -n "$led" ] && [ -e "$led/trigger" ] || return 0

        case "$mode" in
                off)
                        echo none > "$led/trigger" 2>/dev/null
                        echo 0 > "$led/brightness" 2>/dev/null
                        ;;
                on)
                        echo none > "$led/trigger" 2>/dev/null
                        echo 1 > "$led/brightness" 2>/dev/null
                        ;;
                blink)
                        echo timer > "$led/trigger" 2>/dev/null
                        echo "$on" > "$led/delay_on" 2>/dev/null
                        echo "$off" > "$led/delay_off" 2>/dev/null
                        ;;
        esac
}

find_battery()
{
        local p

        for p in /sys/class/power_supply/*; do
                [ -d "$p" ] || continue
                [ "$(cat "$p/type" 2>/dev/null)" = "Battery" ] || continue
                echo "$p"
                return 0
        done

        return 1
}

apply()
{
        case "$1" in
                none|idle)
                        led_set "$GREEN" off
                        led_set "$RED" off
                        ;;
                charging)
                        led_set "$RED" off
                        led_set "$GREEN" blink "$BLINK_ON" "$BLINK_OFF"
                        ;;
                full)
                        led_set "$RED" off
                        led_set "$GREEN" on
                        ;;
                error)
                        led_set "$GREEN" off
                        led_set "$RED" blink "$FAST_ON" "$FAST_OFF"
                        ;;
        esac
}

LAST=""

while true; do
        # Track AC transitions for the runtime estimate on the LuCI battery page.
        /usr/sbin/battery-session tick 2>/dev/null

        BAT="$(find_battery)"

        if [ -z "$BAT" ]; then
                STATE="none"
        else
                CAP="$(cat "$BAT/capacity" 2>/dev/null)"
                STATUS="$(cat "$BAT/status" 2>/dev/null)"

                if ! echo "$CAP" | grep -qE '^[0-9]+$'; then
                        STATE="error"
                else
                        case "$STATUS" in
                                Charging)     STATE="charging" ;;
                                Full)         STATE="full" ;;
                                # VBUS present but the charger is holding off:
                                # either the pack is topped up or the 85 %
                                # limit paused it.  "Not charging" while
                                # unplugged reads as Discharging, so this is
                                # still "plugged and done".
                                "Not charging") STATE="full" ;;
                                *)            STATE="idle" ;;
                        esac
                fi
        fi

        if [ "$STATE" != "$LAST" ]; then
                apply "$STATE"
                logger -t battery-led-monitor \
                        "battery LED: $STATE${CAP:+ (capacity ${CAP}%, $STATUS)}"
                LAST="$STATE"
        fi

        sleep "$POLL"
done
