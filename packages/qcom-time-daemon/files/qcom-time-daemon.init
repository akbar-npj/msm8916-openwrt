#!/bin/sh /etc/rc.common
# /etc/init.d/qcom-time-daemon
# Qualcomm QMI Time Synchronization & Keepalive Daemon for MSM8916

START=65
STOP=10

USE_PROCD=1
PROG=/usr/sbin/qcom-time-daemon

start_service() {
	local board=""
	[ -f /tmp/sysinfo/board_name ] && board="$(cat /tmp/sysinfo/board_name 2>/dev/null)"
	[ -z "$board" ] && [ -f /proc/device-tree/compatible ] && board="$(cat /proc/device-tree/compatible 2>/dev/null)"
	case "$board" in
		*hmu05*|*HMU05*) ;;
		*) return 0 ;;
	esac

	procd_open_instance
	procd_set_param command "$PROG"
	# -r 0: no periodic ATS_USER re-anchor (stock-Android behaviour).
	#
	# Stock Android's time_daemon is purely indication-driven: it sends ONE
	# ATS_USER SET (QMI 0x20) at boot, then sits in poll(..., -1) and issues a
	# GET (0x21) only when the modem pushes a NITZ/tod indication.  It never
	# performs a periodic write.  Evidence: time_daemon_decompiled.c
	# FUN_000113d0 (boot SET, 5000 ms), FUN_00011670 (indication cb, sends
	# nothing), FUN_000120d0 (refresh GET, 1000 ms); live strace shows
	# poll([...], 3, -1) -- infinite timeout.
	#
	# A non-zero -r makes this daemon send an extra QMI 0x20 WRITE every N
	# seconds: a modem-touching mechanism Android does not have, and one that
	# resets the BAM-DMUX autosuspend timer.  The previous "-r 60 is required
	# for parity" justification cited the 900 s SCLK sleep-manager maintenance
	# timer, which is a RETRACTED premise -- measured a2_power.c:1189 fatal
	# times are 172.353 / 918.195 / 1823.753 / 2729.267 s, so there is no fixed
	# 900 s timer to desync.  See Docs/Modem Stability/README.md.
	procd_append_param command -r 0
	procd_append_param command -v
	procd_set_param respawn 30 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	killall qcom-time-daemon 2>/dev/null || true
}
