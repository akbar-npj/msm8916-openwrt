#!/bin/sh /etc/rc.common
# /etc/init.d/qcom-time-daemon
# Qualcomm QMI Time Synchronization & Keepalive Daemon for MSM8916

START=65
STOP=10

USE_PROCD=1
PROG=/usr/sbin/qcom-time-daemon

start_service() {
	local board=""
	[ -f /tmp/sysinfo/board_name ] && board="$(cat /tmp/sysinfo/board_name 2>/dev/null)"
	[ -z "$board" ] && [ -f /proc/device-tree/compatible ] && board="$(cat /proc/device-tree/compatible 2>/dev/null)"
	case "$board" in
		*hmu05*|*HMU05*) ;;
		*) return 0 ;;
	esac

	procd_open_instance
	procd_set_param command "$PROG"
	# -r 60: re-anchor the baseband ATS_USER offset every 60s.
	#
	# This MUST stay > 0. With -r 0 the daemon anchors the modem ATS/SCLK clock
	# once at boot and never again, so the Hexagon SCLK drift accumulator runs
	# free and the ~900s sleep-manager maintenance timer misfires, desyncing the
	# WTR1605 Rx demodulator (RX freezes, TX continues, modem stays registered).
	# Commit 96cc13c set this to 0 in the name of "stock Android parity", but
	# stock Android's tod_update_ind_cb actively re-anchors on every NITZ update
	# (docs Stock_Android_Analysis/17 §Mechanism 1, 39 §Root Cause 1) - passive
	# tracking is the opposite of parity. Observed stall: uptime 904-937s.
	procd_append_param command -r 60
	procd_append_param command -v
	procd_set_param respawn 30 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	killall qcom-time-daemon 2>/dev/null || true
}
