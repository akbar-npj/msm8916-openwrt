#!/bin/sh
# diag-bind-watch - keep the SMD DIAG <-> rpmsg_chrdev bridge alive.
#
# Part of the `diag-bind` OpenWrt package. Run by /etc/init.d/diag-bind.
#
# Binds once at start, then polls. The modem on this platform restarts (SSR)
# roughly every 900 s; each SSR destroys and re-creates the rpmsg DIAG device,
# which drops the rpmsg_chrdev binding and removes /dev/rpmsg0 + /dev/rpmsg1.
# This loop re-runs the idempotent `diag-bind` whenever the device is present
# but not bound, so an unattended capture survives every restart.
#
# It only acts when the device is UNBOUND, so a capture that holds /dev/rpmsg0
# open is never disturbed. /usr/sbin/diag-bind is itself idempotent, so a call
# while already bound is a no-op.

BUS=/sys/bus/rpmsg
DRV=rpmsg_chrdev
DIAG=remoteproc0:smd-edge.DIAG.-1.-1
CNTL=remoteproc0:smd-edge.DIAG_CNTL.-1.-1
STATUS=/root/diag-bind.status
INTERVAL="${DIAG_BIND_INTERVAL:-2}"

log() { logger -t diag-bind "$1"; }

# /root is on the ext4 overlay: a write here is a flash write.  On a persistent
# bind failure the watch loop retries every $INTERVAL, so rewriting the status
# file each retry would hammer the eMMC.  Write it only when the state CHANGES
# (the file then records when the state last changed, not the last check).
LAST_STATE=""
write_status() {   # $1=state  $2=detail
	[ "$1" = "$LAST_STATE" ] && return 0
	LAST_STATE="$1"
	{
		echo "state=$1"
		echo "time=$(date +%Y-%m-%dT%H:%M:%S)"
		echo "$2"
	} > "$STATUS"
}

# Wait (up to 60 s) for the SMD DIAG device to appear at boot.
wait_dev() {
    i=0
    while [ ! -d "$BUS/devices/$DIAG" ] && [ "$i" -lt 60 ]; do
        sleep 1
        i=$((i+1))
    done
    [ -d "$BUS/devices/$DIAG" ]
}

# True when $1 exists and is bound to rpmsg_chrdev.
bound() {
    d=$BUS/devices/$1
    [ -d "$d" ] || return 1
    cur=$(basename "$(readlink "$d/driver" 2>/dev/null)" 2>/dev/null)
    [ "$cur" = "$DRV" ]
}

rebind() {
    out=$(/usr/sbin/diag-bind 2>&1)
    rc=$?
    if [ "$rc" -eq 0 ]; then
        log "bridge (re)established: $(echo "$out" | tr '\n' ' ')"
        write_status bound "$out"
    else
        log "diag-bind failed (rc=$rc): $(echo "$out" | tr '\n' ' ')"
        write_status failed "$out"
    fi
}

# --- start ---
if wait_dev; then
    if bound "$DIAG"; then
        write_status bound "(already bound at start)"
        log "bridge already bound at start"
    else
        rebind
    fi
else
    log "SMD DIAG device never appeared; will keep watching"
fi

# --- watch for the next SSR ---
while :; do
    sleep "$INTERVAL"
    if [ -d "$BUS/devices/$DIAG" ]; then
        bound "$DIAG" || rebind
    fi
done
