#!/bin/sh /etc/rc.common
# diag-bind - keep the SMD DIAG <-> rpmsg_chrdev bridge alive across modem SSRs.
#
# The modem restarts (SSR) roughly every 900 s on this platform. Each restart
# destroys and re-creates the rpmsg DIAG device, dropping the rpmsg_chrdev
# binding and removing /dev/rpmsg0 + /dev/rpmsg1. This service re-establishes
# it so captures (diag-efs, diag-logtool) survive unattended.
#
# START=11 matches the F3 boot-capture service so the bridge is up around modem
# power-up. The two coexist: both bind, and /usr/sbin/diag-bind is idempotent.

START=11
STOP=89
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/diag-bind-watch
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	:
}
