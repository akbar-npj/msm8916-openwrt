#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: BSD-3-Clause
START=96
USE_PROCD=1

start_service() {
	local enabled recordings_dir
	local max_recording_seconds max_recording_file_kib recording_budget_kib max_storage_kib min_free_kib
	config_load auto-answer
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || return 0
	config_get recordings_dir main recordings_dir /root/voice-recordings
	config_get max_recording_seconds main max_recording_seconds 300
	config_get max_recording_file_kib main max_recording_file_kib 512
	config_get recording_budget_kib main recording_budget_kib 2048
	config_get max_storage_kib main max_storage_kib 16384
	config_get min_free_kib main min_free_kib 4096
	procd_open_instance
	procd_set_param command /usr/sbin/auto-answer "$recordings_dir" \
		"$max_recording_seconds" "$max_recording_file_kib" "$recording_budget_kib" \
		"$max_storage_kib" "$min_free_kib"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	# Allow pending playback, child shutdown and two call cleanup attempts.
	procd_set_param term_timeout 70
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger auto-answer
}
