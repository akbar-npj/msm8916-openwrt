#!/bin/sh

changed=0

set_opt() {
	local key=$1
	local val=$2

	if ! uci -q get "luci.$key" 2>/dev/null; then
		uci set "luci.$key=$val"
		changed=1
	fi
}
set_opt themes.Feelgood /luci-static/feelgood
set_opt themes.FeelgoodHighContrast /luci-static/feelgood
set_opt theme_feelgood.color dark
set_opt theme_feelgood.nav horizontal

# Make Feelgood the active theme on a fresh install (first boot after a flash
# that does not keep configuration, e.g. sysupgrade -n).  luci-base already
# ships luci.main.mediaurlbase (= /luci-static/bootstrap), so set_opt only sets
# it when absent and would never switch -- force it here.  Do NOT touch it when
# the package is merely being upgraded (PKG_UPGRADE=1), so a users manual theme
# choice survives an apk upgrade.
if [ "$PKG_UPGRADE" != 1 ]; then
	uci set "luci.main.mediaurlbase=/luci-static/feelgood"
	changed=1
fi

if [ $changed = 1 ]; then
	uci commit luci
fi

exit 0
