#!/bin/sh /etc/rc.common
# Experimental: opt in after checking carrier/firmware compatibility.
START=95
STOP=10
USE_PROCD=1

start_service() {
	local enabled
	config_load qcom-ims
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || return 0
	procd_open_instance
	procd_set_param command /usr/sbin/81voltd
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
	procd_open_instance registration
	procd_set_param command /usr/sbin/qcom-ims-settings enable
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger qcom-ims
}
