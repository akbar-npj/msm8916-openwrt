config qcom-carrier-autocfg 'main'
	# RAT policy written to network.modem.allowedmode, '|'-separated.
	# 'auto' uses the carrier table's Mode column -- custom-apns.tsv wins over
	# the built-in table.  Set '4g' to keep every carrier on LTE (a call is
	# then VoLTE or it fails, never a CS call on UMTS, which is silent on this
	# voice path), or '3g|4g' to give every carrier the 3G/2G fallback.
	option allowed_mode 'auto'
	# Preferred RAT while more than one is allowed.  Ignored for a single-RAT
	# policy.  Empty = none.
	option preferred_mode '4g'
