#!/bin/sh /etc/rc.common

# Keep the "updates available" banner fed.  See /usr/sbin/update-notify.

START=99
STOP=10
USE_PROCD=1

boot() {
	# Surface a "firmware upgrade complete" notice as soon as the device is
	# back up, without waiting for the daemon's first scheduled run.
	/usr/sbin/update-notify --boot >/dev/null 2>&1 || true
	start "$@"
}

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/update-notify --daemon
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
