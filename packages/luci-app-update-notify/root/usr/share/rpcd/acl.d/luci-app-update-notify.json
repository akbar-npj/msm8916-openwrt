{
    "luci-app-update-notify": {
        "description": "Read cached update counts (packages and firmware) for the dashboard notice, and run the firmware upgrade",
        "read": {
            "file": {
                "/tmp/update-notify.json": [ "read" ],
                "/tmp/firmware-upgrade-notify.json": [ "read" ],
                "/tmp/firmware-upgrade.bin": [ "stat" ],
                "/usr/sbin/firmware-upgrade": [ "exec" ],
                "/usr/sbin/firmware-upgrade upgrade": [ "exec" ],
                "/usr/sbin/firmware-upgrade download": [ "exec" ]
            }
        }
    }
}
