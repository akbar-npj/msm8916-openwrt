#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
#
# update-notify -- keep /tmp/update-notify.json current so the LuCI dashboard
# can show "N package updates available".
#
# Why a daemon and not a boot script: the check needs a working uplink, and on
# these dongles that means the modem is attached and the bearer is up, which is
# minutes after boot and can come and go.  A failed check keeps the previous
# answer and retries in 15 minutes instead of waiting for the next full cycle.
#
# The result is a tiny JSON file rather than a ubus call: the LuCI side then
# needs only a file read ACL, and the banner still works when the daemon is
# stopped (it simply shows the last known state).
#
# Log: logread -e update-notify

set -u

OUT=/tmp/update-notify.json
FIRM_OUT=/tmp/firmware-upgrade-notify.json
INTERVAL=${INTERVAL:-21600}   # 6 h between successful checks
RETRY=${RETRY:-900}           # 15 min after a failed one
FIRST_DELAY=${FIRST_DELAY:-300}

log() {
	logger -t update-notify "$1"
}

MODE="${1:---once}"

case "$MODE" in
	-h|--help)
		cat <<'USAGE'
Usage: update-notify [--once | --daemon | --help]

  --once     Refresh the index and rewrite /tmp/update-notify.json.  Exits
             non-zero when the index could not be refreshed (offline).
  --daemon   Refresh now, then every INTERVAL seconds (default 6 h).  A failed
             refresh keeps the previous result and retries after RETRY
             seconds (default 15 min).  Started by /etc/init.d/update-notify.
  --help     Show this help and exit.

Environment: INTERVAL, RETRY, FIRST_DELAY (seconds).
Log: logread -e update-notify
USAGE
		exit 0
		;;
	--once|--daemon)
		;;
	*)
		echo "update-notify: unknown option '$1' (try --help)" >&2
		exit 1
		;;
esac

# Print the number of packages apk could upgrade.
#
# Ask the solver, not the index.  `apk list --upgradable` reports every package
# with a newer version in the feed, including ones /etc/apk/world pins to the
# version already installed -- base-files, kernel and libc are pinned that way
# in the image, and a hand pin behaves the same.  `--world` does not filter
# those out: in apk-tools 3.0.5 it only adds the world packages to the
# selection, and `apk list --installed --world` prints exactly the same set as
# `apk list --installed`.  Counting the list therefore advertised an update
# that `apk upgrade` then refused to install.
#
# `apk upgrade --simulate` runs the real solver against those constraints, so
# a pinned package simply does not appear.  It also prints one line per
# package, so the same package in two feeds (the stock OpenWrt one and our own
# distfeeds) cannot be counted twice.
count_upgradable() {
	local plan

	plan="$(apk upgrade --simulate 2>/dev/null)" || return 1

	# "(2/3) Upgrading nano (9.2-r1 -> 9.3-r1)".  Only upgrades count: an
	# "Installing" line is a new dependency pulled in by an upgrade, not an
	# update of anything the user has.
	printf '%s\n' "$plan" | grep -c '^([0-9][0-9]*/[0-9][0-9]*) Upgrading ' || true
}

firmware_check() {
	# Optional: only meaningful when msm89xx-firmware-upgrade is installed.
	# Writes /tmp/firmware-upgrade-notify.json for the dashboard banner; when
	# the package is absent we still record that so the UI can explain it.
	if ! command -v firmware-upgrade >/dev/null 2>&1; then
		printf '{"available":false,"installed":false,"checked":%s}\n' "$(date +%s)" > "$FIRM_OUT"
		return 0
	fi

	# firmware-upgrade check fetches the manifest and prints a single JSON line;
	# on failure (offline) it prints nothing, so keep the previous answer.
	firmware-upgrade check > "$FIRM_OUT.tmp" 2>/dev/null && [ -s "$FIRM_OUT.tmp" ] && \
		mv -f "$FIRM_OUT.tmp" "$FIRM_OUT" || {
		rm -f "$FIRM_OUT.tmp"
		log "firmware-upgrade check failed; keeping previous result"
	}
	return 0
}

check_once() {
	local count

	# A stale index would report yesterday's answer, so refresh first.  No
	# route, no DNS or an untrusted key all land here.
	if ! apk update >/dev/null 2>&1; then
		log "apk update failed (offline?); keeping the previous result"
		return 1
	fi

	# A solver failure means the world is inconsistent or an index is broken;
	# reporting 0 would silently hide every update, so keep the last answer.
	if ! count="$(count_upgradable)"; then
		log "could not work out the upgrade plan; keeping the previous result"
		return 1
	fi

	printf '{"count":%s,"checked":%s}\n' "$count" "$(date +%s)" > "$OUT.tmp" &&
		mv -f "$OUT.tmp" "$OUT" || {
			rm -f "$OUT.tmp"
			log "could not write $OUT"
			return 1
		}

	log "$count package update(s) available"
	firmware_check
	return 0
}

if [ "$MODE" != "--daemon" ]; then
	check_once
	exit $?
fi

# --daemon
delay="$FIRST_DELAY"
while :; do
	sleep "$delay"
	if check_once; then
		delay="$INTERVAL"
	else
		delay="$RETRY"
	fi
done
