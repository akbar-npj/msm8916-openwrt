#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
#
# update-notify -- keep /tmp/update-notify.json current so the LuCI dashboard
# can show "N package updates available".
#
# Why a daemon and not a boot script: the check needs a working uplink, and on
# these dongles that means the modem is attached and the bearer is up, which is
# minutes after boot and can come and go.  A failed check keeps the previous
# answer and retries in 15 minutes instead of waiting for the next full cycle.
#
# The result is a tiny JSON file rather than a ubus call: the LuCI side then
# needs only a file read ACL, and the banner still works when the daemon is
# stopped (it simply shows the last known state).
#
# Log: logread -e update-notify

set -u

OUT=/tmp/update-notify.json
FIRM_OUT=/tmp/firmware-upgrade-notify.json
HOTFIX_OUT=/tmp/hotfix-notify.json
INTERVAL=${INTERVAL:-21600}   # 6 h between successful checks
RETRY=${RETRY:-900}           # 15 min after a failed one
FIRST_DELAY=${FIRST_DELAY:-300}

log() {
	logger -t update-notify "$1"
}

# Current firmware version as reported by the image (DISTRIB_RELEASE, e.g.
# 25.12.6-r2); matches the manifest version scheme.
current_version() {
	. /etc/openwrt_release 2>/dev/null
	echo "${DISTRIB_RELEASE:-unknown}" | tr ' ' '-'
}

MODE="${1:---once}"

case "$MODE" in
	-h|--help)
		cat <<'USAGE'
Usage: update-notify [--once | --daemon | --boot | --help]

  --once     Refresh the index and rewrite /tmp/update-notify.json.  Exits
             non-zero when the index or one of the manifests could not be
             fetched (offline, or an uplink that is not fully up yet).
  --daemon   Refresh now, then every INTERVAL seconds (default 6 h).  A failed
             refresh keeps the previous result and retries after RETRY
             seconds (default 15 min).  Started by /etc/init.d/update-notify.
  --boot     Lightweight post-reboot hook: only turn a pending firmware-upgrade
             marker into /tmp/firmware-upgrade-just-upgraded.json.  Needs no
             network.  Run by /etc/init.d/update-notify at boot.
  --help     Show this help and exit.

Environment: INTERVAL, RETRY, FIRST_DELAY (seconds).
Log: logread -e update-notify
USAGE
		exit 0
		;;
	--once|--daemon|--boot)
		;;
	*)
		echo "update-notify: unknown option '$1' (try --help)" >&2
		exit 1
		;;
esac

# Print the number of packages apk could upgrade.
#
# Ask the solver, not the index.  `apk list --upgradable` reports every package
# with a newer version in the feed, including ones /etc/apk/world pins to the
# version already installed -- base-files, kernel and libc are pinned that way
# in the image, and a hand pin behaves the same.  `--world` does not filter
# those out: in apk-tools 3.0.5 it only adds the world packages to the
# selection, and `apk list --installed --world` prints exactly the same set as
# `apk list --installed`.  Counting the list therefore advertised an update
# that `apk upgrade` then refused to install.
#
# `apk upgrade --simulate` runs the real solver against those constraints, so
# a pinned package simply does not appear.  It also prints one line per
# package, so the same package in two feeds (the stock OpenWrt one and our own
# distfeeds) cannot be counted twice.
count_upgradable() {
	local plan rc steps

	plan="$(apk upgrade --simulate 2>/dev/null)"; rc=$?

	# apk 3.0.5 exits 1 when ONE package in an otherwise good plan cannot be
	# resolved -- measured 2026-11-02: the feed carried a kernel built for a
	# different vermagic, every kmod upgrade conflicted, apk printed the full
	# plan and then "1 error", and the old `|| return 1` threw the whole
	# answer away.  The dashboard banner then never updated again.
	# Only treat it as a failure when nothing resembling a plan came back.
	steps="$(printf '%s\n' "$plan" | grep -c '^([0-9][0-9]*/[0-9][0-9]*) ' || true)"
	[ "$rc" -eq 0 ] || [ "$steps" -gt 0 ] || return 1

	# "(2/3) Upgrading nano (9.2-r1 -> 9.3-r1)".  Only upgrades count: an
	# "Installing" line is a new dependency pulled in by an upgrade, not an
	# update of anything the user has.
	printf '%s\n' "$plan" | grep -c '^([0-9][0-9]*/[0-9][0-9]*) Upgrading ' || true
}

firmware_check() {
	# Optional: only meaningful when msm89xx-firmware-upgrade is installed.
	# Writes /tmp/firmware-upgrade-notify.json for the dashboard banner; when
	# the package is absent we still record that so the UI can explain it.
	if ! command -v firmware-upgrade >/dev/null 2>&1; then
		printf '{"available":false,"installed":false,"checked":%s}\n' "$(date +%s)" > "$FIRM_OUT"
		return 0
	fi

	# firmware-upgrade check fetches the manifest and prints a single JSON line;
	# on failure (offline) it prints nothing, so keep the previous answer.
	# The failure is reported to the caller: check_once() runs this AFTER a
	# successful "apk update", so a fetch that still fails means the uplink is
	# only half up -- exactly the first minutes after boot, when the station
	# has associated but DNS or the route is not there yet.  Swallowing it
	# here would park the next attempt 6 hours away.
	firmware-upgrade check > "$FIRM_OUT.tmp" 2>/dev/null && [ -s "$FIRM_OUT.tmp" ] && \
		mv -f "$FIRM_OUT.tmp" "$FIRM_OUT" && return 0
	rm -f "$FIRM_OUT.tmp"
	log "firmware-upgrade check failed; keeping previous result"
	return 1
}

hotfix_check() {
	# Package hotfixes built for THIS exact image (releases/<version>/hotfix.json).
	# Same rule as firmware_check: a failed fetch keeps the previous answer.
	# Deliberately uplink-agnostic -- it runs right after a successful apk
	# refresh, so a WiFi STA uplink works exactly like a modem bearer.
	if ! command -v firmware-upgrade >/dev/null 2>&1; then
		return 0
	fi

	if firmware-upgrade hotfix check > "$HOTFIX_OUT.tmp" 2>/dev/null && [ -s "$HOTFIX_OUT.tmp" ]; then
		mv -f "$HOTFIX_OUT.tmp" "$HOTFIX_OUT"
		log "hotfix check: $(jsonfilter -e '@.count' -i "$HOTFIX_OUT" 2>/dev/null) for this build"
		return 0
	fi
	rm -f "$HOTFIX_OUT.tmp"
	log "hotfix check failed; keeping previous result"
	return 1
}

# If a firmware-upgrade run left a pending marker (written just before
# sysupgrade and preserved across it by /etc/sysupgrade.conf), we have just
# booted back up after an upgrade.  Surface that for the dashboard's
# "Upgrade complete" banner and clear the marker so it only fires once.
firmware_just_upgraded() {
	local marker="/etc/firmware-upgrade-state.json"
	[ -f "$marker" ] || return 0
	local pending from to
	pending="$(jsonfilter -e '@.pending' -i "$marker" 2>/dev/null)"
	[ "$pending" = "true" ] || { rm -f "$marker"; return 0; }
	from="$(jsonfilter -e '@.from' -i "$marker" 2>/dev/null)"
	to="$(current_version)"
	printf '{"upgraded":true,"from":"%s","to":"%s","ts":%s}\n' \
		"$from" "$to" "$(date +%s)" > /tmp/firmware-upgrade-just-upgraded.json.tmp \
		&& mv -f /tmp/firmware-upgrade-just-upgraded.json.tmp \
		       /tmp/firmware-upgrade-just-upgraded.json
	rm -f "$marker"
	return 0
}

check_once() {
	local count rc

	# Detect a just-completed firmware upgrade first: this needs no network,
	# so it works even on a failed refresh below.
	firmware_just_upgraded

	# A stale index would report yesterday's answer, so refresh first.  No
	# route, no DNS or an untrusted key all land here.
	if ! apk update >/dev/null 2>&1; then
		log "apk update failed (offline?); keeping the previous result"
		return 1
	fi

	# A solver failure means the world is inconsistent or an index is broken;
	# reporting 0 would silently hide every update, so keep the last answer.
	if ! count="$(count_upgradable)"; then
		log "could not work out the upgrade plan; keeping the previous result"
		return 1
	fi

	printf '{"count":%s,"checked":%s}\n' "$count" "$(date +%s)" > "$OUT.tmp" &&
		mv -f "$OUT.tmp" "$OUT" || {
			rm -f "$OUT.tmp"
			log "could not write $OUT"
			return 1
		}

	log "$count package update(s) available"

	# The package count is fresh either way, but a failed manifest fetch still
	# has to shorten the next cycle to RETRY: it is the normal state for the
	# first minutes after boot, and waiting 6 h for the next look is what made
	# the banner appear only after a manual restart.
	rc=0
	firmware_check || rc=1
	hotfix_check || rc=1
	return "$rc"
}

if [ "$MODE" = "--boot" ]; then
	# Lightweight post-reboot hook: only surface a completed upgrade, no index
	# refresh (which would need a working uplink).  Started by the init script.
	firmware_just_upgraded
	exit 0
fi

if [ "$MODE" != "--daemon" ]; then
	check_once
	exit $?
fi

# --daemon
delay="$FIRST_DELAY"
while :; do
	sleep "$delay"
	if check_once; then
		delay="$INTERVAL"
	else
		delay="$RETRY"
	fi
done
