#!/bin/sh /etc/rc.common
#
# START=96 so the dashboard comes up after lcd-control (95) has seeded the
# backlight.  A VT console is bound to fb0 on this board; leave it in place
# (unbinding it would remove the serial-console fallback) - the renderer paints
# every refresh, so any console repaint is corrected within one interval.

START=96
STOP=10
USE_PROCD=1

PROG=/usr/sbin/lcd-dashboardd

start_service() {
	config_load lcd-dashboard
	local enabled
	config_get_bool enabled main enabled 1
	[ "$enabled" -eq 0 ] && return 0

	# Board gate: no framebuffer, no dashboard.
	[ -c /dev/fb0 ] || return 0

	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
