config dashboard 'main'
	option enabled '1'
	option refresh '5'

# Panel orientation in degrees clockwise: 0 (normal), 90, 180 or 270.
	option rotation '0'

# Android-style 3-band theme (default)
	option color_top_bg '#3fb34f'
	option color_top_fg '#ffffff'
	option color_mid_bg '#101010'
	option color_bottom_bg '#1e6fe0'
	option color_bottom_fg '#ffffff'
	option color_tile_on '#3fb34f'
	option color_tile_off '#c62828'
	option color_popup_bg '#b71c1c'
	option color_popup_fg '#ffffff'

# Which source each zone shows.  Valid sources:
#   none signal operator sim wifi traffic battery vpn cpu_temp sms missed ssid key ip custom1 custom2
	option top_left 'signal'
	option top_right 'operator'
	option tile1 'sim'
	option tile2 'wifi'
	option tile3 'traffic'
	option tile4 'battery'
	option bottom1 'ssid'
	option bottom2 'key'

	option custom1 ''
	option custom2 ''

config notification 'notification'
	option enabled '1'
	option duration '6'
