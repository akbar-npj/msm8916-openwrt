#!/bin/sh /etc/rc.common
# /etc/init.d/bt-spp
# Bluetooth Serial Port Profile (SPP) server.
#
# Runs after bluetoothd (S62).  Registers the "Serial Port" SDP record (which
# needs bluetoothd --compat to expose the local SDP socket at /var/run/sdp)
# and then starts `bt-spp serve` on the configured RFCOMM channel.
#
# The SPP *client* is on demand: run `bt-spp connect --bdaddr <addr>` yourself.

START=97
STOP=10

USE_PROCD=1
PROG=/usr/sbin/bt-spp

register_sdp() {
	local i=0

	# Wait for the local SDP socket (bluetoothd --compat) and hci0.
	while [ "$i" -lt 60 ]; do
		[ -S /var/run/sdp ] && hciconfig hci0 2>/dev/null | grep -q 'UP' && break
		sleep 1
		i=$((i + 1))
	done

	if [ ! -S /var/run/sdp ]; then
		logger -t bt-spp "no local SDP socket (/var/run/sdp); is bluetoothd running with --compat?"
		return 1
	fi

	# The SDP database lives in bluetoothd and resets on its restart, so this
	# runs each boot.  Skip if the record is already there (avoid duplicates).
	if sdptool records local 2>/dev/null | grep -q 'Serial Port'; then
		return 0
	fi

	if sdptool add SP >/dev/null 2>&1; then
		logger -t bt-spp "registered the Serial Port SDP record"
	else
		logger -t bt-spp "sdptool add SP failed"
		return 1
	fi
}

start_service() {
	local enabled channel bridge host port

	config_load bt-spp
	config_get_bool enabled server enabled 1
	[ "$enabled" -eq 1 ] || return 0
	config_get channel server channel 1
	config_get bridge server bridge shell
	config_get host server tcp_host 127.0.0.1
	config_get port server tcp_port 5000

	register_sdp

	procd_open_instance
	procd_set_param command "$PROG" serve \
		--channel "$channel" --bridge "$bridge" \
		--tcp-host "$host" --tcp-port "$port"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	killall bt-spp 2>/dev/null || true
}
