config spp 'server'
	# Run the SPP server at boot (listens on RFCOMM channel 1 and waits for
	# an incoming connection from a paired peer).
	option enabled '1'
	option channel '1'
	# 'shell'  -> a login shell on a pty (a serial console over Bluetooth)
	# 'tcp'    -> connect OUT to tcp_host:tcp_port and bridge the bytes
	option bridge 'shell'
	option tcp_host '127.0.0.1'
	option tcp_port '5000'

config spp 'client'
	# The client is on demand, not a boot service.  These are the defaults
	# used when you run:  bt-spp connect --bdaddr <addr>
	# (or drive it explicitly with bt-spp connect ... on the command line).
	option enabled '0'
	option bdaddr ''
	option channel '1'
	# 'shell' -> a login shell on a pty; 'tcp' -> a local TCP listener on
	# tcp_port that is bridged to the remote BT serial device.
	option bridge 'tcp'
	option tcp_port '5001'
