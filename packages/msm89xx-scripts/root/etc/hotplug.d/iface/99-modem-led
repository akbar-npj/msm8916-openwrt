#!/bin/sh

#
# HMUF02-V5: the blue lamp (GPIO73) is the Wi-Fi one and wifi-led-monitor owns
# it; its LTE lamp is green and modem-led-monitor follows the signal state.
# This data-activity blink is for the four-lamp boards only.
#
case "$(cat /tmp/sysinfo/board_name 2>/dev/null)" in
	*hmuf02v5*) exit 0 ;;
esac

LED="/sys/class/leds/blue:wan"
[ -d "$LED" ] || LED="/sys/class/leds/blue:wlan"

[ -d "$LED" ] || exit 0

blue_beacon()
{
        echo timer > "$LED/trigger" 2>/dev/null
        echo 500 > "$LED/delay_on" 2>/dev/null
        echo 9500 > "$LED/delay_off" 2>/dev/null
}

blue_connected_idle()
{
        echo timer > "$LED/trigger" 2>/dev/null
        echo 1000 > "$LED/delay_on" 2>/dev/null
        echo 1000 > "$LED/delay_off" 2>/dev/null
}

case "$ACTION:$INTERFACE" in

        ifup:modem)
                blue_connected_idle
                logger -t modem-blue-led \
                        "LTE interface up: blue IDLE (1000ms)"
                ;;

        ifdown:modem)
                blue_beacon
                logger -t modem-blue-led \
                        "LTE interface down: blue BEACON (500ms ON / 9500ms OFF)"
                ;;

esac

exit 0
