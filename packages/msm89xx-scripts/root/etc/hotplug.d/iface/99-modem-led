#!/bin/sh

#
# The data-activity blink belongs to the 'data' role.  On HMUF02-V5 the blue
# lamp is the Wi-Fi one and wifi-led-monitor owns it, so the role resolves to
# no lamp there and this helper exits; elsewhere it is the blue LTE lamp.
#
. /usr/share/msm89xx/leds.sh

LED=$(led_role_lamp data) || exit 0

blue_beacon()
{
        led_apply "$LED" "$(led_role_spec data beacon)"
}

blue_connected_idle()
{
        led_apply "$LED" "$(led_role_spec data idle)"
}

case "$ACTION:$INTERFACE" in

        ifup:modem)
                blue_connected_idle
                logger -t modem-blue-led \
                        "LTE interface up: blue IDLE (1000ms)"
                ;;

        ifdown:modem)
                blue_beacon
                logger -t modem-blue-led \
                        "LTE interface down: blue BEACON (500ms ON / 9500ms OFF)"
                ;;

esac

exit 0
