#!/bin/sh

# The phy index changes on every driver reload (rmmod/modprobe), so accept any
# phy -- there is a single wifi phy on these boards.  The 2 s poll in
# wifi-led-monitor is the authoritative LED driver; this only gives an
# immediate set on radio add/remove.
case "$DEVICENAME" in
	phy*) ;;
	*) exit 0 ;;
esac

#
# Radio auto-enable. Runs on every board.
#
if [ "$ACTION" = "add" ] && [ -f /etc/config/wireless ]; then
	if uci -q get wireless.default_radio0.disabled | grep -q "1"; then
		uci -q set wireless.default_radio0.disabled='0'
		uci -q set wireless.radio0.disabled='0'
		uci -q commit wireless
		wifi reload 2>/dev/null || true
	fi
fi

#
# mf800b has no automatic LED indication: nothing claims its LEDs
# except the power button handler.
#
case "$(cat /tmp/sysinfo/board_name 2>/dev/null)" in
	*mf800b*) exit 0 ;;
esac

LED="/sys/class/leds/green:wlan"
[ -d "$LED" ] || LED="/sys/class/leds/green:wan"
[ -d "$LED" ] || exit 0

case "$ACTION" in
	add)
		echo none > "$LED/trigger" 2>/dev/null || true
		echo 1 > "$LED/brightness" 2>/dev/null || true
		;;
	remove)
		echo none > "$LED/trigger" 2>/dev/null || true
		echo 0 > "$LED/brightness" 2>/dev/null || true
		;;
esac
