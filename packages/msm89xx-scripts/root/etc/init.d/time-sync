#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
#
# Restore the clock at boot (before sysntpd) and keep it saved for the next
# cold boot.  The service body is the daemon loop in /usr/sbin/time-sync.

START=01
STOP=95

USE_PROCD=1
PROG=/usr/sbin/time-sync

start_service() {
	procd_open_instance
	procd_set_param command "$PROG" daemon
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
