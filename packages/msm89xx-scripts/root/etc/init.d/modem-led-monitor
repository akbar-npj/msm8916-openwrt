#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

start_service()
{
        procd_open_instance
        procd_set_param command /usr/sbin/modem-led-monitor
        procd_set_param respawn 3600 5 5
        procd_set_param stdout 1
        procd_set_param stderr 1
        procd_close_instance
}

stop_service()
{
        # Fail-safe: if the health monitor isn't running,
        # show red rather than silently indicating healthy.
        . /usr/share/msm89xx/leds.sh

        led_apply "$(led_role_lamp wan_fault)" on
}
