#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

start_service()
{
        procd_open_instance

        procd_set_param command /usr/sbin/wifi-led-monitor

        # Restart the monitor if it unexpectedly exits.
        #
        # threshold = 3600 seconds
        # timeout   = 5 seconds
        # retry     = 5 times
        procd_set_param respawn 3600 5 5

        procd_set_param stdout 1
        procd_set_param stderr 1

        procd_close_instance
}

stop_service()
{
        #
        # When the service is deliberately stopped, leave the Wi-Fi lamp OFF.
        # The role mapping decides which lamp that is: on the HMUF02-V5 the
        # Wi-Fi lamp is blue on most units and green on the ones whose lamps
        # are wired the other way round.
        #
        . /usr/share/msm89xx/leds.sh

        led_apply "$(led_role_lamp wifi)" off
}
