#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

start_service()
{
        procd_open_instance

        procd_set_param command /usr/sbin/wifi-led-monitor

        # Restart the monitor if it unexpectedly exits.
        #
        # threshold = 3600 seconds
        # timeout   = 5 seconds
        # retry     = 5 times
        procd_set_param respawn 3600 5 5

        procd_set_param stdout 1
        procd_set_param stderr 1

        procd_close_instance
}

stop_service()
{
        #
        # When the service is deliberately stopped, leave the Wi-Fi LED OFF.
        # The lamp is green on the mifib-v12/mf800b and blue on the HMUF02-V5,
        # whose device tree called it blue:wan before the function swap.
        #
        case "$(cat /tmp/sysinfo/board_name 2>/dev/null)" in
                *hmuf02v5*)
                        LED="/sys/class/leds/blue:wlan"
                        [ -d "$LED" ] || LED="/sys/class/leds/blue:wan"
                        ;;
                *)
                        LED="/sys/class/leds/green:wlan"
                        [ -d "$LED" ] || LED="/sys/class/leds/green:wan"
                        ;;
        esac

        if [ -e "$LED/trigger" ]; then
                echo none > "$LED/trigger" 2>/dev/null
                echo 0 > "$LED/brightness" 2>/dev/null
        fi
}
