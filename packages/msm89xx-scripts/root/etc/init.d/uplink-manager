#!/bin/sh /etc/rc.common
START=97
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/uplink-manager
	procd_set_param pidfile /var/run/uplink-manager.pid
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
