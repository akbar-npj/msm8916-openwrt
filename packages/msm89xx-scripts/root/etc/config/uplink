config uplink 'general'
	option enabled '1'
	option policy 'auto'
	option probe_target '1.1.1.1'
	option probe_interval '30'
	option probe_timeout '3'
	option fail_threshold '3'
	option recover_threshold '2'
	option override_metric '40'
	# sta_dns is deliberately unset: the DNS servers the upstream AP hands out
	# in its lease are used.  Set it only to force specific resolvers, e.g.
	#	option sta_dns '1.1.1.1 9.9.9.9'
