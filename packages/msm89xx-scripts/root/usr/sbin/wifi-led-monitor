#!/bin/sh

# --- --help ---------------------------------------------------------------
case "${1:-}" in
	-h|--help)
		cat <<'USAGE'
Usage: wifi-led-monitor [--help]

Drive the board's Wi-Fi LED (green on the mifib-v12/mf800b, blue on the
HMUF02-V5): off when the AP interface has no client, on when it has one,
blinking while the AP is coming up.  Started by procd
(/etc/init.d/wifi-led-monitor); takes no arguments.

Options:
  -h, --help   Show this help and exit
USAGE
		exit 0
		;;
esac

#
# Which lamp reports Wi-Fi is a role, not a colour.  /etc/config/leds maps the
# role to a physical label; 'auto' keeps the board default (HMUF02-V5 uses the
# blue lamp, the other boards the green one).  A unit whose lamps are wired
# differently is recorded with led-probe, which writes that config.
#
. /usr/share/msm89xx/leds.sh

LED=$(led_role_lamp wifi) || LED=""

# Red half of the same pair (mifib-v12, after the 2026-10-22 DT rename).
LED_RED=$(led_role_lamp wifi_fault) || LED_RED=""

# Lamp name for the log lines ("green" or "blue").
LAMP="${LED##*/}"
LAMP="${LAMP%%:*}"

#
# The AP vif name embeds the phy index, which changes every time the driver is
# reloaded (rmmod/modprobe) or the radio restarted.  The STA self-heal watchdog
# reloads the driver in normal operation, so "phy0-ap0" is not a safe
# assumption -- discover the AP vif by pattern instead (the station vif is
# already discovered the same way by sta_if()).
#
ap_if()
{
	local n

	for n in /sys/class/net/*; do
		case "${n##*/}" in
			*-ap*) echo "${n##*/}"; return 0 ;;
		esac
	done

	return 1
}

POLL_INTERVAL=2

wifi_led_off()
{
	led_apply "$LED" "$(led_role_spec wifi down)"
}

wifi_led_on()
{
	led_apply "$LED" "$(led_role_spec wifi ap_ready)"
}

wifi_led_blink()
{
	led_apply "$LED" "$(led_role_spec wifi client)"
}

#
# AP+STA: the radio is serving its own AP *and* associated upstream.  That is
# the one state where this box is a repeater, so it gets its own much faster
# toggle, distinguishable at a glance from "a client joined the AP".
#
wifi_led_blink_fast()
{
	led_apply "$LED" "$(led_role_spec wifi ap_sta)"
}

#
# Red half of the Wi-Fi pair: solid = the AP should be up but is not,
# blink = the radio was switched off on purpose (so it is not a fault).
#
set_red()
{
	case "$1" in
		off)   led_apply "$LED_RED" "$(led_role_spec wifi_fault ok)" ;;
		on)    led_apply "$LED_RED" "$(led_role_spec wifi_fault fault)" ;;
		blink) led_apply "$LED_RED" "$(led_role_spec wifi_fault radio_off)" ;;
	esac
}

wifi_radio_disabled()
{
        [ "$(uci -q get wireless.radio0.disabled)" = "1" ]
}

wifi_ap_present()
{
	local if

	if="$(ap_if)" || return 1
	[ -d "/sys/class/net/$if" ] || return 1

	return 0
}

wifi_ap_up()
{
	local if

	if="$(ap_if)" || return 1

	# The interface must be administratively/radio operational.
	#
	# For mac80211 AP interfaces operstate may be "up" or "unknown",
	# so don't rely solely on /sys/class/net/.../operstate.
	iw dev "$if" info >/dev/null 2>&1 || return 1

	return 0
}

#
# The station vif is created by wifi-sta-up (it is deliberately NOT a
# wifi-iface), so discover it instead of assuming phy0-sta0.
#
sta_if()
{
        local n

        for n in /sys/class/net/*; do
                case "${n##*/}" in
                        *-sta*) echo "${n##*/}"; return 0 ;;
                esac
        done

        return 1
}

#
# A transient "Connected" is not enough.  wcn36xx reports the link as soon as
# the AssocResp arrives -- roughly 100 ms BEFORE the 4-way handshake completes --
# and tears it down again when the handshake fails.  Sampling that window made
# the LED flicker between "AP ready" and "AP+STA active" once a minute while a
# station with a stale key kept retrying.  Requiring an address means the
# uplink actually works, not that an association was merely attempted.
#
sta_uplink_active()
{
        local i

        i="$(sta_if)" || return 1
        [ -n "$i" ] || return 1

        iw dev "$i" link 2>/dev/null | grep -q "^Connected" || return 1
        ip -4 addr show dev "$i" 2>/dev/null | grep -q "inet "
}

wifi_has_clients()
{
	local if

	if="$(ap_if)" || return 1
	iw dev "$if" info >/dev/null 2>&1 || return 1

	iw dev "$if" station dump 2>/dev/null |
		grep -q '^Station '

	return $?
}

#
# Boot/service startup state:
#
# Keep green OFF until we have confirmed that the Wi-Fi AP exists.
#
wifi_led_off

LAST=""

while true; do

        if ! wifi_ap_up; then

                STATE="wifi-down"

        elif sta_uplink_active; then

                STATE="ap-sta"

        elif wifi_has_clients; then

                STATE="client-connected"

        else

                STATE="ap-ready"

        fi

        #
        # Only reprogram the LED when state changes.
        #
        if [ "$STATE" != "$LAST" ]; then

                case "$STATE" in

                        wifi-down)
                                wifi_led_off

                                if wifi_radio_disabled; then
                                        set_red blink
                                        logger -t wifi-led-monitor \
                                                "Wi-Fi radio disabled: red BLINK"
                                else
                                        set_red on
                                        logger -t wifi-led-monitor \
                                                "Wi-Fi AP unavailable: red ON, $LAMP OFF"
                                fi
                                ;;

                        ap-ready)
                                set_red off
                                wifi_led_on
                                logger -t wifi-led-monitor \
                                        "Wi-Fi AP ready, no clients: $LAMP ON"
                                ;;

                        ap-sta)
                                set_red off
                                wifi_led_blink_fast
                                logger -t wifi-led-monitor \
                                        "Wi-Fi AP+STA active: $LAMP FAST BLINK"
                                ;;

                        client-connected)
                                set_red off
                                wifi_led_blink
                                logger -t wifi-led-monitor \
                                        "Wi-Fi client connected: $LAMP BLINK"
                                ;;

                esac

                LAST="$STATE"
        fi

        sleep "$POLL_INTERVAL"

done
