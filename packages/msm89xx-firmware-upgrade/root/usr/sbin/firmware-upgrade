#!/bin/sh
# firmware-upgrade - check for, download, verify and apply a published firmware
# image for this board.  Works with the firmware.json manifest that the release
# pipeline publishes next to the images.
#
#   firmware-upgrade check     -> JSON {available,blocked,current,latest,board,url,
#                                        sha256,size,min_version,notes}
#   firmware-upgrade status    -> one-line human summary
#   firmware-upgrade download  -> fetch + verify, print the temp image path
#   firmware-upgrade upgrade   -> download + verify, then sysupgrade (keep config)
#   firmware-upgrade upgrade --no-keep -> download + verify, then sysupgrade -n (erase settings)
#
# Safety model:
#   * only an entry whose key matches /tmp/sysinfo/board_name is ever used
#   * the image sha256 (from the manifest) is checked before any flash
#   * sysupgrade keeps the config (no -n) so the overlay and the modem
#     firmware that live there survive the upgrade
#
# Set FIRMWARE_MANIFEST_URL to test against a specific manifest.

. /lib/functions.sh

PKG_CFG="firmware"
PAGES_BASE="https://akbar-npj.github.io/msm8916-openwrt"

# Manifest candidates, tried in order:
#   1. the version-independent root manifest -- this is what lets a device on
#      25.12.6 discover a 25.12.7 release; a URL derived from our own version
#      would pin us to releases/25.12.6 forever.
#   2. this device's own release dir -- the only path that existed before the
#      root manifest was published, so older Pages trees still work.
_ver="$(. /etc/openwrt_release 2>/dev/null; echo "$DISTRIB_RELEASE")"
_base="${_ver%-r*}"
# Testing / fork override: FIRMWARE_MANIFEST_URL=/path/or/url.  A single URL,
# so the fallback list below is bypassed.
MANIFEST_URL="${FIRMWARE_MANIFEST_URL:-}"
if [ -n "$MANIFEST_URL" ]; then
  MANIFEST_URLS="$MANIFEST_URL"
else
  MANIFEST_URLS="$PAGES_BASE/firmware.json
$PAGES_BASE/releases/${_base}/targets/msm89xx/msm8916/firmware.json"
fi

TMP="$(mktemp -d /tmp/firmware-upgrade.XXXXXX)"
DL="/tmp/firmware-upgrade.bin"
# Machine-readable progress for the LuCI page: one line, rewritten in place.
#   phase=<download|verify|flash|done|failed> bytes=<n> total=<n>
# The UI turns this into a progress bar; it is never read by the CLI itself.
PROGRESS="/tmp/firmware-upgrade.progress"
# Same idea for "hotfix apply", but a SEPARATE file: $PROGRESS means "an image
# is being downloaded and flashed", and the page shows a finished bar for a
# phase=done it finds there.  A hotfix must not leave that behind.
#   phase=<hinstall|hdone|hfailed> done=<n> total=<n> pkg=<name>
HF_PROGRESS="/tmp/firmware-upgrade.hotfix"
cleanup() { rm -rf "$TMP"; }
trap cleanup EXIT

log() { logger -t firmware-upgrade "$*"; echo "$*" >&2; }

progress() { printf 'phase=%s bytes=%s total=%s\n' "$1" "${2:-0}" "${3:-0}" > "$PROGRESS"; }
hf_progress() { printf 'phase=%s done=%s total=%s pkg=%s\n' "$1" "${2:-0}" "${3:-0}" "${4:-}" > "$HF_PROGRESS"; }

# No 'stat' on the target: busybox is built without that applet here
# ("stat: applet not found"), so a stat -c %s probe silently returns 0 and the
# progress bar never moves.  wc -c is a core applet and reads the file's current
# length even while wget is still appending to it.
file_size() {
	local s
	# The '<' redirect is the shell's, so 2>/dev/null on wc does not silence a
	# missing file -- check first, or every first tick logs an error into the
	# apply log the user is watching.
	[ -f "$1" ] || { echo 0; return; }
	s="$(wc -c < "$1" 2>/dev/null | tr -d ' ')"
	[ -n "$s" ] || s=0
	echo "$s"
}

board_name() {
	uci -q get "${PKG_CFG}.board" 2>/dev/null \
		|| cat /tmp/sysinfo/board_name 2>/dev/null \
		|| cat /proc/device-tree/model 2>/dev/null
}

current_version() {
	# DISTRIB_RELEASE (e.g. 25.12.6-r2) matches the manifest version scheme.
	# DISTRIB_REVISION is a git hash and must NOT be used for comparison.
	local ver
	ver="$(. /etc/openwrt_release 2>/dev/null; echo "$DISTRIB_RELEASE")"
	[ -z "$ver" ] && ver="$(. /etc/openwrt_release 2>/dev/null; echo "$DISTRIB_REVISION")"
	[ -z "$ver" ] && ver="$(uci -q get "${PKG_CFG}.version" 2>/dev/null)"
	echo "$ver" | tr ' ' '-'
}

version_greater() {
	local a="$1" b="$2" ra rb na nb xa xb
	[ "$a" = "$b" ] && return 1
	ra="${a%%-*}"; rb="${b%%-*}"
	na="${a##*-}"; nb="${b##*-}"
	while [ -n "$ra" ] || [ -n "$rb" ]; do
		xa="${ra%%.*}"; xb="${rb%%.*}"
		[ "$ra" != "$xa" ] && ra="${ra#*.}" || ra=""
		[ "$rb" != "$xb" ] && rb="${rb#*.}" || rb=""
		xa="${xa:-0}"; xb="${xb:-0}"
		[ "$xa" -gt "$xb" ] 2>/dev/null && return 0
		[ "$xb" -gt "$xa" ] 2>/dev/null && return 1
	done
	na="${na#r}"; nb="${nb#r}"
	[ "${na:-0}" -gt "${nb:-0}" ] 2>/dev/null && return 0
	return 1
}

fetch_field() {
	echo "$MANIFEST" | jsonfilter -e "@.boards['${BOARD}'].$1" 2>/dev/null
}

load_manifest() {
	local u body
	BOARD="$(board_name)"
	MANIFEST=""
	for u in $MANIFEST_URLS; do
		body="$(wget -q -O - "$u" 2>/dev/null)"
		[ -n "$body" ] || continue
		MANIFEST="$body"
		LATEST_VER="$(fetch_field version)"
		# A manifest without our board key (e.g. a targeted single-board
		# release published before this board existed) is not an answer.
		if [ -n "$LATEST_VER" ]; then
			MANIFEST_URL="$u"
			break
		fi
		MANIFEST=""
	done
	[ -n "$MANIFEST" ] || { log "no manifest entry for board '$BOARD' at any known URL"; return 1; }
	LATEST_URL="$(fetch_field sysupgrade)"
	LATEST_SHA="$(fetch_field sha256)"
	LATEST_SIZE="$(fetch_field size)"
	LATEST_NOTES="$(fetch_field notes)"
	LATEST_MIN="$(fetch_field min_version)"
	[ -n "$LATEST_VER" ] || { log "no manifest entry for board '$BOARD'"; return 1; }
	return 0
}

download_and_verify() {
	local out="$DL" sum sz wpid
	# A stale image from a previous run would make the progress bar start at
	# 100% and, worse, could be mistaken for this download by verify_local.
	rm -f "$out"
	progress download 0 "$LATEST_SIZE"
	log "downloading $LATEST_URL"
	# Run wget in the background so the byte count can be reported while it
	# transfers; a synchronous wget gives the UI no progress at all.  The
	# completion sentinel is a file, not 'kill -0': an exited child that has
	# not been reaped is a zombie and still answers kill -0, so polling the
	# pid would loop forever.
	rm -f "$TMP/wget.rc"
	( wget -q -O "$out" "$LATEST_URL"; echo $? > "$TMP/wget.rc" ) &
	wpid=$!
	while [ ! -f "$TMP/wget.rc" ]; do
		progress download "$(file_size "$out")" "$LATEST_SIZE"
		sleep 1
	done
	wait "$wpid" 2>/dev/null
	if [ "$(cat "$TMP/wget.rc" 2>/dev/null)" != "0" ]; then
		progress failed "$(file_size "$out")" "$LATEST_SIZE"
		log "download failed"
		return 1
	fi
	sz="$(file_size "$out")"
	progress verify "$sz" "$LATEST_SIZE"
	sum="$(sha256sum "$out" | awk '{print $1}')"
	if [ "$sum" != "$LATEST_SHA" ]; then
		progress failed "$sz" "$LATEST_SIZE"
		log "sha256 mismatch: got $sum expected $LATEST_SHA"
		return 1
	fi
	log "verified sha256 $sum"
	echo "$out"
}

verify_local() {
	local sum
	[ -f "$DL" ] || return 1
	sum="$(sha256sum "$DL" | awk '{print $1}')"
	[ "$sum" = "$LATEST_SHA" ] || return 1
	return 0
}

mark_pending() {
	local state="/etc/firmware-upgrade-state.json"
	local from to ts
	from="$(current_version)"
	to="$LATEST_VER"
	ts="$(date +%s)"
	cat > "$state" <<JSON
{"pending":true,"from":"$from","to":"$to","ts":$ts}
JSON
	grep -qxF "$state" /etc/sysupgrade.conf 2>/dev/null || echo "$state" >> /etc/sysupgrade.conf
}

do_upgrade() {
	local out min_ok=1 keep="${1:-keep}"
	[ -n "$LATEST_MIN" ] && version_greater "$LATEST_MIN" "$(current_version)" && min_ok=0
	if [ "$min_ok" -eq 0 ]; then
		log "current version is older than the supported minimum ($LATEST_MIN); refusing automatic upgrade"
		return 1
	fi
	# Reuse an image already downloaded and sha256-verified by the UI's download step.
	if verify_local; then
		out="$DL"
		log "reusing verified local image $out"
		progress verify "$(file_size "$out")" "$LATEST_SIZE"
	else
		out="$(download_and_verify)" || return 1
	fi
	mark_pending
	progress flash "$(file_size "$out")" "$LATEST_SIZE"
	# sysupgrade does not report how far the flash has got, so 'flash' is the
	# last phase the UI can show; on success the device reboots from under it.
	if [ "$keep" = "nokeep" ]; then
		log "applying upgrade to $LATEST_VER (sysupgrade -n, settings erased)"
		sysupgrade -n "$out"
	else
		log "applying upgrade to $LATEST_VER (sysupgrade keeps config)"
		sysupgrade "$out"
	fi
	if [ $? -eq 0 ]; then
		progress done "$(file_size "$out")" "$LATEST_SIZE"
	else
		progress failed "$(file_size "$out")" "$LATEST_SIZE"
		return 1
	fi
}


# ---- package hotfixes -------------------------------------------------------
# A hotfix is a package rebuilt for THIS build and published into
# releases/<exact version>/ only, with hotfix.json next to it.  base-files is
# version-pinned in /etc/apk/world by the image build, so it can never arrive
# through "apk upgrade" (the pin wins, apk reports OK and does nothing).  It is
# installed here with an explicit version, from the revision feed passed with
# --repository: that feed is NOT in /etc/apk/repositories.d, so the LuCI
# Software page never offers a pinned package it cannot install.
HOTFIX_URL="$PAGES_BASE/releases/${_ver}/hotfix.json"
# Two KINDS of feed live in a revision dir, and a hotfix can be in either:
#   targets/msm89xx/msm8916/packages   target packages -- base-files, kmod-*
#   packages/aarch64_generic/<feed>    everything else, one dir per feed
# Passing only the target feed makes apk answer "unable to select packages" for
# a package that is published perfectly well: the only candidate it can see is
# the older version already installed, which then "breaks" the requested pin.
HOTFIX_REPO="$PAGES_BASE/releases/${_ver}/targets/msm89xx/msm8916/packages/packages.adb"
HOTFIX_REPO_FEEDS="base luci packages routing"

installed_version() {
	apk list -I "$1" 2>/dev/null | sed -n "s/^$1-\([^ ]*\) .*/\1/p" | sed -n '1p'
}

# One tab-separated line per hotfix newer than what is installed:
#   id <TAB> package <TAB> version <TAB> title <TAB> services
hotfix_list() {
	local body n i id pkg ver title restart inst
	body="$(wget -q -O - "$HOTFIX_URL" 2>&1)" || {
		log "cannot read $HOTFIX_URL: $body"
		case "$body" in
		*SSL*|*ssl*|*certificate*)
			log "a TLS error here usually means the device clock is wrong: run 'date -u' and fix it"
			;;
		esac
		return 1
	}
	[ -n "$body" ] || { log "empty response from $HOTFIX_URL"; return 1; }
	n="$(printf '%s' "$body" | jsonfilter -e '@.hotfixes[*].id' 2>/dev/null | wc -l)"
	[ "$n" -gt 0 ] || return 0
	i=0
	while [ "$i" -lt "$n" ]; do
		id="$(printf '%s' "$body" | jsonfilter -e "@.hotfixes[$i].id" 2>/dev/null)"
		pkg="$(printf '%s' "$body" | jsonfilter -e "@.hotfixes[$i].package" 2>/dev/null)"
		ver="$(printf '%s' "$body" | jsonfilter -e "@.hotfixes[$i].version" 2>/dev/null)"
		title="$(printf '%s' "$body" | jsonfilter -e "@.hotfixes[$i].title" 2>/dev/null)"
		restart="$(printf '%s' "$body" | jsonfilter -e "@.hotfixes[$i].restart[*]" 2>/dev/null | tr '\n' ' ')"
		inst="$(installed_version "$pkg")"
		if [ -z "$inst" ] || [ "$(apk version -t "$inst" "$ver" 2>/dev/null)" = "<" ]; then
			printf '%s\t%s\t%s\t%s\t%s\n' "$id" "$pkg" "$ver" "$title" "$restart"
		fi
		i=$((i + 1))
	done
}

hotfix_check_json() {
	local cur now list count items id pkg ver title restart
	cur="$(current_version)"
	now="$(date +%s)"
	list="$(hotfix_list)" || return 1
	count=0
	items=""
	while IFS="$(printf '\t')" read -r id pkg ver title restart; do
		[ -n "$id" ] || continue
		[ "$count" -gt 0 ] && items="$items,"
		items="$items{\"id\":\"$id\",\"package\":\"$pkg\",\"version\":\"$ver\",\"title\":\"$title\",\"restart\":\"$restart\"}"
		count=$((count + 1))
	done <<-EOF
	$list
	EOF
	printf '{"build":"%s","count":%s,"checked":%s,"items":[%s]}\n' "$cur" "$count" "$now" "$items"
}

# apk aborts the whole transaction if one --repository 404s, and not every
# build produces every feed, so only pass the ones that exist.
hotfix_install() {
	local spec="$1"
	set -- --repository "$HOTFIX_REPO"
	for _f in $HOTFIX_REPO_FEEDS; do
		_u="$PAGES_BASE/releases/${_ver}/packages/aarch64_generic/${_f}/packages.adb"
		wget -q --spider "$_u" 2>/dev/null && set -- "$@" --repository "$_u"
	done
	apk add "$@" "$spec"
}

hotfix_apply_all() {
	local listfile id pkg ver title restart svc was_pinned rc=0 total i=0
	listfile="$TMP/hotfix.list"
	hotfix_list > "$listfile" || { log "hotfix manifest unavailable"; return 1; }
	[ -s "$listfile" ] || { echo "no hotfixes for ${_ver}"; return 0; }
	# The page polls this: apk gives no byte-level progress and the whole
	# transaction takes seconds, so "which fix, how many of how many" is the
	# only progress there is.
	total="$(wc -l < "$listfile")"
	hf_progress hinstall 0 "$total" ""
	while IFS="$(printf '\t')" read -r id pkg ver title restart; do
		[ -n "$id" ] || continue
		i=$((i + 1))
		hf_progress hinstall "$i" "$total" "$pkg"
		log "installing $pkg $ver ($title)"
		# "apk add pkg=ver" also writes pkg=ver into /etc/apk/world.  For a
		# version-pinned package (base-files) that is the point: it moves the
		# pin with the fix.  For an ordinary package it would freeze it -- the
		# image pins only base-files, kernel and libc, so every later update
		# would be refused by that new pin.  Keep a pin only where one existed.
		was_pinned=0
		grep -q "^${pkg}=" /etc/apk/world && was_pinned=1
		if ! hotfix_install "$pkg=$ver"; then
			# apk exits 1 when it cannot write ONE file: base-files ships
			# rom/note, and /rom is the read-only squashfs on every sysupgrade
			# image, so that write always fails while the rest of the package
			# installs cleanly.  Judge by the installed version, not the exit
			# code, or every base-files hotfix would report failure.
			if [ "$(installed_version "$pkg")" != "$ver" ]; then
				rc=1
				break
			fi
			log "$pkg $ver is installed despite apk reporting an error"
		fi
		if [ "$was_pinned" -eq 0 ]; then
			sed -i "s|^${pkg}=.*|${pkg}|" /etc/apk/world
		fi
		for svc in $restart; do
			log "restarting $svc"
			/etc/init.d/"$svc" restart >/dev/null 2>&1 || log "restart of $svc failed"
		done
	done < "$listfile"
	if [ "$rc" -eq 0 ]; then
		hf_progress hdone "$i" "$total" ""
	else
		hf_progress hfailed "$i" "$total" ""
	fi
	return "$rc"
}

case "$1" in

check)
	load_manifest || exit 0
	cur="$(current_version)"
	avail=0; blocked=0
	if version_greater "$LATEST_VER" "$cur"; then
		avail=1
		# do_upgrade refuses anything below min_version, so never advertise an
		# upgrade that pressing the button would then fail to apply.
		if [ -n "$LATEST_MIN" ] && version_greater "$LATEST_MIN" "$cur"; then
			avail=0; blocked=1
			log "update $LATEST_VER is published but needs at least $LATEST_MIN; flash it manually"
		fi
	fi
	now="$(date +%s)"
	echo "{\"available\":$avail,\"blocked\":$blocked,\"current\":\"$cur\",\"latest\":\"$LATEST_VER\",\"board\":\"$BOARD\",\"url\":\"$LATEST_URL\",\"sha256\":\"$LATEST_SHA\",\"size\":$LATEST_SIZE,\"min_version\":\"$LATEST_MIN\",\"notes\":\"$LATEST_NOTES\",\"checked\":$now}"
	;;
	status)
		load_manifest || { echo "no update information for this board"; exit 0; }
		cur="$(current_version)"
		if version_greater "$LATEST_VER" "$cur"; then
			if [ -n "$LATEST_MIN" ] && version_greater "$LATEST_MIN" "$cur"; then
				echo "update $cur -> $LATEST_VER published, but it needs at least $LATEST_MIN (manual flash)"
			else
				echo "update available: $cur -> $LATEST_VER ($LATEST_URL)"
			fi
		else
			echo "up to date ($cur); latest is $LATEST_VER"
		fi
		;;
	download)
		load_manifest || exit 1
		download_and_verify
		;;
	apply)
		# Long download + flash must not run inside the rpcd ubus call:
		# rpcd runs with `-t 30`, so a synchronous exec is killed after 30 s
		# and the download never completes.  Detach the real work and return
		# immediately; the dashboard polls /tmp/firmware-upgrade.bin for
		# progress and /tmp/firmware-upgrade.failed for errors.
		shift
		_keep=keep
		[ "$1" = "--no-keep" ] && _keep=nokeep
		rm -f /tmp/firmware-upgrade.failed "$PROGRESS"
		if [ "$_keep" = nokeep ]; then
			setsid sh -c 'if /usr/sbin/firmware-upgrade upgrade --no-keep >/tmp/firmware-upgrade-apply.log 2>&1; then :; else echo failed >/tmp/firmware-upgrade.failed; fi' >/dev/null 2>&1 &
		else
			setsid sh -c 'if /usr/sbin/firmware-upgrade upgrade >/tmp/firmware-upgrade-apply.log 2>&1; then :; else echo failed >/tmp/firmware-upgrade.failed; fi' >/dev/null 2>&1 &
		fi
		echo started
		;;
	upgrade)
		shift
		_keep=keep
		[ "$1" = "--no-keep" ] && _keep=nokeep
		load_manifest || exit 1
		do_upgrade "$_keep"
		;;
	hotfix)
		case "$2" in
		check) hotfix_check_json ;;
		apply) hotfix_apply_all ;;
		*) echo "usage: $0 hotfix {check|apply}" >&2; exit 1 ;;
		esac
		;;
	*)
		echo "usage: $0 {check|status|download|apply|upgrade|hotfix} [--no-keep]" >&2
		exit 1
		;;
esac
