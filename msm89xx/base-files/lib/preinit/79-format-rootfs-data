#!/bin/sh
# /lib/preinit/79-format-rootfs-data
# Automatically repair or format rootfs_data before mounting.

ROOTFS_DATA="/dev/mmcblk0p15"

preinit_format_rootfs_data() {
	[ -b "$ROOTFS_DATA" ] || return 0

	echo "rootfs_data: checking filesystem..." > /dev/kmsg

	e2fsck -fy "$ROOTFS_DATA" >/dev/kmsg 2>&1
	ret=$?

	case "$ret" in
	0)
		echo "rootfs_data: filesystem clean" > /dev/kmsg
		return 0
		;;

	1|2|3)
		echo "rootfs_data: filesystem repaired successfully" > /dev/kmsg
		return 0
		;;

	*)
		echo "rootfs_data: filesystem unrecoverable (e2fsck=$ret), formatting..." > /dev/kmsg

		if mkfs.ext4 -F -L rootfs_data -O ^has_journal "$ROOTFS_DATA" >/dev/kmsg 2>&1; then
			echo "rootfs_data: format complete" > /dev/kmsg
			sync
			return 0
		else
			echo "rootfs_data: ERROR - format failed" > /dev/kmsg
		fi
		;;
	esac
}

boot_hook_add preinit_mount_root preinit_format_rootfs_data
