#!/bin/sh

# --- --help ---------------------------------------------------------------
case "${1:-}" in
	-h|--help)
		cat <<'USAGE'
Usage: wifi-led-monitor [--help]

Drive the green WLAN LED: off when the AP interface (phy0-ap0) has no client,
on when it has one, blinking while the AP is coming up.  Started by procd
(/etc/init.d/wifi-led-monitor); takes no arguments.

Options:
  -h, --help   Show this help and exit
USAGE
		exit 0
		;;
esac

LED="/sys/class/leds/green:wlan"
[ -d "$LED" ] || LED="/sys/class/leds/green:wan"
# Red half of the same pair (mifib-v12, after the 2026-10-22 DT rename).
LED_RED="/sys/class/leds/red:wlan"
[ -d "$LED_RED" ] || LED_RED=""
WIFI_IF="phy0-ap0"

POLL_INTERVAL=2
BLINK_ON=250
BLINK_OFF=250

set_green_off()
{
        [ -e "$LED/trigger" ] || return 1

        echo none > "$LED/trigger" 2>/dev/null
        echo 0 > "$LED/brightness" 2>/dev/null
}

set_green_on()
{
        [ -e "$LED/trigger" ] || return 1

        echo none > "$LED/trigger" 2>/dev/null
        echo 1 > "$LED/brightness" 2>/dev/null
}

set_green_blink()
{
        [ -e "$LED/trigger" ] || return 1

        echo timer > "$LED/trigger" 2>/dev/null
        echo "$BLINK_ON" > "$LED/delay_on" 2>/dev/null
        echo "$BLINK_OFF" > "$LED/delay_off" 2>/dev/null
}

#
# Red half of the Wi-Fi pair: solid = the AP should be up but is not,
# blink = the radio was switched off on purpose (so it is not a fault).
#
set_red()
{
        [ -n "$LED_RED" ] && [ -e "$LED_RED/trigger" ] || return 0

        case "$1" in
                off)
                        echo none > "$LED_RED/trigger" 2>/dev/null
                        echo 0 > "$LED_RED/brightness" 2>/dev/null
                        ;;
                on)
                        echo none > "$LED_RED/trigger" 2>/dev/null
                        echo 1 > "$LED_RED/brightness" 2>/dev/null
                        ;;
                blink)
                        echo timer > "$LED_RED/trigger" 2>/dev/null
                        echo 500 > "$LED_RED/delay_on" 2>/dev/null
                        echo 500 > "$LED_RED/delay_off" 2>/dev/null
                        ;;
        esac
}

wifi_radio_disabled()
{
        [ "$(uci -q get wireless.radio0.disabled)" = "1" ]
}

wifi_ap_present()
{
        [ -d "/sys/class/net/$WIFI_IF" ] || return 1

        return 0
}

wifi_ap_up()
{
        wifi_ap_present || return 1

        # The interface must be administratively/radio operational.
        #
        # For mac80211 AP interfaces operstate may be "up" or "unknown",
        # so don't rely solely on /sys/class/net/.../operstate.
        iw dev "$WIFI_IF" info >/dev/null 2>&1 || return 1

        return 0
}

wifi_has_clients()
{
        wifi_ap_up || return 1

        iw dev "$WIFI_IF" station dump 2>/dev/null |
                grep -q '^Station '

        return $?
}

#
# Boot/service startup state:
#
# Keep green OFF until we have confirmed that the Wi-Fi AP exists.
#
set_green_off

LAST=""

while true; do

        if ! wifi_ap_up; then

                STATE="wifi-down"

        elif wifi_has_clients; then

                STATE="client-connected"

        else

                STATE="ap-ready"

        fi

        #
        # Only reprogram the LED when state changes.
        #
        if [ "$STATE" != "$LAST" ]; then

                case "$STATE" in

                        wifi-down)
                                set_green_off

                                if wifi_radio_disabled; then
                                        set_red blink
                                        logger -t wifi-led-monitor \
                                                "Wi-Fi radio disabled: red BLINK"
                                else
                                        set_red on
                                        logger -t wifi-led-monitor \
                                                "Wi-Fi AP unavailable: red ON, green OFF"
                                fi
                                ;;

                        ap-ready)
                                set_red off
                                set_green_on
                                logger -t wifi-led-monitor \
                                        "Wi-Fi AP ready, no clients: green ON"
                                ;;

                        client-connected)
                                set_red off
                                set_green_blink
                                logger -t wifi-led-monitor \
                                        "Wi-Fi client connected: green BLINK"
                                ;;

                esac

                LAST="$STATE"
        fi

        sleep "$POLL_INTERVAL"

done
