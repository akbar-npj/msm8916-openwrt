#!/bin/sh
# Late STA bring-up for concurrent AP+STA on wcn36xx.
#
# Usage: wifi-sta-up sta   -- wait for the AP, create the STA vif, run
#                              wpa_supplicant in the FOREGROUND (procd respawns)
#        wifi-sta-up dhcp  -- wait for the STA to associate, run udhcpc in the
#                              FOREGROUND (procd respawns)
#
# Why not a wifi-iface: netifd's wifi script restarts the phy whenever the
# wireless config changes -- and a phy restart with a managed iface present
# crashes the WCNSS firmware (boot_exception_c_handlers.c:108, Data Abort at
# 0x8b6b301c).  Adding the vif with "iw" against an already-beaconing AP is the
# path that was verified working (AP serving a phone while the STA was
# associated to another AP, both carrying traffic).
#
# Why not netifd for the netdev either: netifd has no device object for a vif it
# did not create, so "option device 'phy0-sta0'" fails with NO_DEVICE.  udhcpc
# is run directly instead, with a handler that does not install a default route
# (the LTE link must stay the default).

. /lib/functions.sh

MODE="${1:-sta}"

config_load wifista || exit 0
config_get_bool enabled main enabled 0
# "status" is also useful while disabled (the page shows the state either way).
if [ "$MODE" != "status" ] && [ "$enabled" != 1 ]; then
	exit 0
fi

config_get macaddr main macaddr
config_get_bool dhcp main dhcp 1
config_get timeout_s main wait_ap_timeout 60
config_get radio main radio radio0
config_get recover_after main recover_after 60
config_get hostname main hostname

# ---- saved networks ----------------------------------------------------
# Any number of networks can be saved as wifista.ap sections.  The generated
# wpa_supplicant.conf gets one network block per enabled profile and
# wpa_supplicant picks whichever is in range, moving on to the next when a
# password is rejected (reported to the user, see wifi-sta-wpa-event).
# A single legacy wifista.main.ssid/key pair still works: it is used when no
# ap section exists (the LuCI page migrates it on first save).
#
# The three lists are parallel, newline-terminated, 1-based indexed.
PROFILE_SSID=""
PROFILE_KEY=""
PROFILE_OFF=""

add_profile() {
	PROFILE_SSID="${PROFILE_SSID}$1
"
	PROFILE_KEY="${PROFILE_KEY}$2
"
	PROFILE_OFF="${PROFILE_OFF}$3
"
}

profile_load() {
	local ssid key disabled
	config_get ssid "$1" ssid
	config_get key "$1" key
	config_get_bool disabled "$1" disabled 0
	[ -n "$ssid" ] || return 0
	add_profile "$ssid" "$key" "$disabled"
}
config_foreach profile_load ap

# Legacy single-network fallback.
if [ -z "$PROFILE_SSID" ]; then
	config_get ssid main ssid
	config_get key main key
	[ -n "$ssid" ] && add_profile "$ssid" "$key" 0
fi

# profile_field <list> <index>
profile_field() {
	printf '%s' "$1" | sed -n "$2p"
}

PROFILE_COUNT=$(printf '%s' "$PROFILE_SSID" | grep -c .)
PROFILE_ENABLED=0
ssid=""
_i=1
while [ "$_i" -le "$PROFILE_COUNT" ]; do
	_s="$(profile_field "$PROFILE_SSID" "$_i")"
	_o="$(profile_field "$PROFILE_OFF" "$_i")"
	if [ "$_o" != "1" ]; then
		PROFILE_ENABLED=$((PROFILE_ENABLED + 1))
		[ -n "$ssid" ] || ssid="$_s"
	fi
	_i=$((_i + 1))
done

# Escape a value for a quoted string in wpa_supplicant.conf.
conf_escape() {
	printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

# A UCI field the user cleared ("") would make the arithmetic tests below fail
# with "bad number"; fall back to the default in that case.
case "$recover_after" in ''|*[!0-9]*) recover_after=60 ;; esac
case "$timeout_s" in ''|*[!0-9]*) timeout_s=60 ;; esac

if [ "$MODE" = "dhcp" ] && [ "$dhcp" != 1 ]; then
	exit 0
fi

find_ap() {
	local i
	for i in $(iw dev 2>/dev/null | awk '$1 == "Interface" { print $2 }'); do
		[ "$(iw dev "$i" info 2>/dev/null | awk '/^[[:space:]]*type/ { print $2 }')" = "AP" ] && {
			echo "$i"
			return 0
		}
	done
	return 1
}

find_sta() {
	local i
	# Prefer the vif this service creates; fall back to any managed vif.
	for i in $(iw dev 2>/dev/null | awk '$1 == "Interface" { print $2 }'); do
		case "$i" in
		phy*-sta0) echo "$i"; return 0 ;;
		esac
	done
	for i in $(iw dev 2>/dev/null | awk '$1 == "Interface" { print $2 }'); do
		[ "$(iw dev "$i" info 2>/dev/null | awk '/^[[:space:]]*type/ { print $2 }')" = "managed" ] && {
			echo "$i"
			return 0
		}
	done
	return 1
}

ap_state() {
	ubus call "hostapd.$1" get_status 2>/dev/null |
		jsonfilter -e '@.status' 2>/dev/null
}

# Hostname announced to the upstream network.  Sent as DHCP option 12 when
# dhcp=1, so the upstream DHCP server (and its DNS) can resolve this device by
# name.  Empty config = the system hostname: system.@system[0].hostname, else
# the kernel's, else a plain default.
sta_hostname() {
	local h
	if [ -n "$hostname" ]; then
		printf '%s' "$hostname"
		return 0
	fi
	h="$(uci -q get system.@system[0].hostname 2>/dev/null)"
	[ -n "$h" ] || h="$(cat /proc/sys/kernel/hostname 2>/dev/null)"
	printf '%s' "${h:-OpenWrt}"
}

# Channel of the upstream BSS for a given SSID, read from a scan on the STA vif.
# Scanning from a managed vif is exactly what wpa_supplicant does, so this is the
# same operation, just earlier.
scan_channel() {
	local iface="$1" want="$2"
	iw dev "$iface" scan 2>/dev/null | awk -v want="$want" '
		/^BSS / { ssid = ""; ch = "" }
		/^[[:space:]]*SSID: / {
			ssid = $0
			sub(/^[[:space:]]*SSID: /, "", ssid)
		}
		# iw prints "DS Parameter set: channel N" in the plain beacon block and
		# "\t\t * primary channel: N" under HT operation -- match both.
		/DS Parameter set:/ { ch = $NF }
		/primary channel:/ { ch = $NF }
		ssid == want && ch != "" { print ch; exit }
	'
}

# Read the channel the AP is actually beaconing on.
ap_channel() {
	iw dev "$1" info 2>/dev/null | awk '/^[[:space:]]*channel/ { print $2; exit }'
}

# A failed scan plus channel='auto' is a dead AP: hostapd's ACS needs a scan,
# and when that fails the AP comes up with neither a channel nor an SSID, so
# nothing on the radio works until the next boot.  Station Mode is what makes a
# scan failure likely -- wcn36xx can lose one and then answer every later scan
# with -EBUSY for the rest of the boot -- so while it is enabled the radio must
# have a concrete channel.  Adopt the channel the AP is already beaconing on
# when there is one (that costs nothing); otherwise pin 6 and restart the radio
# so the AP can actually start.
ensure_fixed_channel() {
	local radio="$1" cur ap ch action=""

	cur="$(uci -q get "wireless.${radio}.channel")"
	[ "$cur" = "auto" ] || return 0

	ap="$(find_ap)"
	ch=""
	[ -n "$ap" ] && ch="$(ap_channel "$ap")"
	if [ -z "$ch" ]; then
		ch=6
		# An AP with no channel needs a reconfigure to pick the new one;
		# no AP at all means the radio is down and needs a plain start.
		if [ -n "$ap" ]; then action=reload; else action=up; fi
	fi

	logger -t wifi-sta "radio '$radio' had channel 'auto'; pinning it to $ch (a failed ACS scan would leave the AP with no channel at all)"
	uci set "wireless.${radio}.channel=$ch"
	uci commit wireless

	# Nothing to restart when the AP is already beaconing on that channel.
	[ "$action" = "reload" ] && wifi reload >/dev/null 2>&1
	[ "$action" = "up" ] && wifi up >/dev/null 2>&1

	return 0
}

# Channel of the first saved network that is visible in a scan on the STA
# vif.  Sets UP_CH and UP_SSID (empty when none is in range).
scan_any_channel() {
	local iface="$1" i s off ch
	UP_CH=""
	UP_SSID=""
	i=1
	while [ "$i" -le "$PROFILE_COUNT" ]; do
		s="$(profile_field "$PROFILE_SSID" "$i")"
		off="$(profile_field "$PROFILE_OFF" "$i")"
		if [ "$off" != "1" ] && [ -n "$s" ]; then
			ch="$(scan_channel "$iface" "$s")"
			if [ -n "$ch" ]; then
				UP_CH="$ch"
				UP_SSID="$s"
				return 0
			fi
		fi
		i=$((i + 1))
	done
	return 1
}

bring_up_sta() {
	# An enabled service with no saved network is a legitimate state: the
	# operator saves the form first and picks the networks from a scan
	# afterwards.  procd respawns us (threshold 0 = never give up), so a bare
	# exit 1 turns into a 5-second log-spam loop -- back off for five minutes
	# instead.  Saving a network restarts us immediately through the
	# config.change trigger, so the wait never delays a working setup.
	[ "$PROFILE_ENABLED" -ge 1 ] || {
		logger -t wifi-sta "no saved network configured; station mode idle"
		sleep 300
		exit 1
	}

	# Never leave the radio on channel 'auto' while we are about to scan: if
	# the scan is lost, ACS cannot run either and the AP never gets a channel.
	ensure_fixed_channel "${radio:-radio0}"

	# Wait for the AP to finish starting.  hostapd restarts the phy at boot, so
	# the vif exists well before it is ENABLED; creating the STA in that window
	# is exactly what we are avoiding.
	local waited=0 ap="" phy sta_if conf
	while [ "$waited" -lt "$timeout_s" ]; do
		ap="$(find_ap)"
		if [ -n "$ap" ] && [ "$(ap_state "$ap")" = "ENABLED" ]; then
			break
		fi
		ap=""
		sleep 1
		waited=$((waited + 1))
	done

	[ -n "$ap" ] || {
		logger -t wifi-sta "AP did not reach ENABLED in ${timeout_s}s; not starting STA"
		exit 1
	}

	phy="$(iw dev "$ap" info 2>/dev/null | awk '/wiphy/ { print "phy" $2; exit }')"
	[ -n "$phy" ] || { logger -t wifi-sta "cannot resolve phy for $ap"; exit 1; }

	sta_if="${phy}-sta0"

	# A stale vif from a previous run must go, or "interface add" fails -EEXIST.
	iw dev "$sta_if" del 2>/dev/null
	if [ -n "$macaddr" ]; then
		iw phy "$phy" interface add "$sta_if" type managed addr "$macaddr"
	else
		iw phy "$phy" interface add "$sta_if" type managed
	fi || { logger -t wifi-sta "failed to create $sta_if"; exit 1; }
	# A down netdev cannot scan (iw returns ENETDOWN) and mac80211 will not let
	# it associate either; wpa_supplicant brings it up itself only later.
	ip link set "$sta_if" up 2>/dev/null

	# ---- channel sync -------------------------------------------------
	# One radio, one channel: the STA can only join an upstream that sits on
	# the same channel as our AP (the driver refuses otherwise -- verified:
	# "Authentication request to the driver failed" loop, no crash).  So scan
	# for the saved networks now, and if the first one in range is elsewhere,
	# move OUR AP -- with the STA vif deleted first, because a phy restart with
	# a managed iface present is the firmware crash.
	radio="${radio:-radio0}"
	scan_any_channel "$sta_if"
	up_ch="$UP_CH"
	up_ssid="$UP_SSID"
	ap_ch="$(ap_channel "$ap")"

	if [ -n "$up_ch" ] && [ -n "$ap_ch" ] && [ "$up_ch" != "$ap_ch" ]; then
		logger -t wifi-sta "upstream '$up_ssid' is on channel $up_ch, AP is on $ap_ch; moving the AP"
		iw dev "$sta_if" del 2>/dev/null
		uci set "wireless.${radio}.channel=$up_ch"
		uci commit wireless
		wifi reload >/dev/null 2>&1

		# Wait for the AP to come back on the new channel before re-creating
		# the STA vif.
		w=0
		while [ "$w" -lt 30 ]; do
			ap="$(find_ap)"
			[ -n "$ap" ] && [ "$(ap_channel "$ap")" = "$up_ch" ] &&
				[ "$(ap_state "$ap")" = "ENABLED" ] && break
			sleep 1
			w=$((w + 1))
		done
		[ -n "$ap" ] || { logger -t wifi-sta "AP did not come back after channel change"; exit 1; }
		logger -t wifi-sta "AP moved to channel $up_ch; re-creating $sta_if"

		iw dev "$sta_if" del 2>/dev/null
		if [ -n "$macaddr" ]; then
			iw phy "$phy" interface add "$sta_if" type managed addr "$macaddr"
		else
			iw phy "$phy" interface add "$sta_if" type managed
		fi || { logger -t wifi-sta "failed to re-create $sta_if"; exit 1; }
		ip link set "$sta_if" up 2>/dev/null
	elif [ -n "$up_ch" ]; then
		logger -t wifi-sta "upstream '$up_ssid' on channel $up_ch matches the AP"
	else
		logger -t wifi-sta "WARNING: none of the $PROFILE_ENABLED saved network(s) seen in the scan; leaving the channel alone"
	fi

	conf="/var/run/wpa_supplicant-${sta_if}.conf"
	# A fresh start: passwords may have changed, so stale "wrong password"
	# flags from a previous run must not survive.
	rm -f /var/run/wifi-sta-wrongkey
	{
		echo "ctrl_interface=/var/run/wpa_supplicant"
		_i=1
		while [ "$_i" -le "$PROFILE_COUNT" ]; do
			_s="$(profile_field "$PROFILE_SSID" "$_i")"
			_k="$(profile_field "$PROFILE_KEY" "$_i")"
			_o="$(profile_field "$PROFILE_OFF" "$_i")"
			if [ "$_o" != "1" ] && [ -n "$_s" ]; then
				# A newline inside an SSID cannot be written as a quoted string;
				# skip that profile rather than emit a broken conf.
				if [ "$(printf '%s' "$_s" | wc -l)" != "0" ]; then
					logger -t wifi-sta "skipping a saved network: newline in SSID"
				else
					echo "network={"
					echo "	ssid=\"$(conf_escape "$_s")\""
					[ -n "$_k" ] && echo "	psk=\"$(conf_escape "$_k")\""
					echo "}"
				fi
			fi
			_i=$((_i + 1))
		done
	} > "$conf"
	# A leftover socket makes wpa_supplicant exit with "ctrl_iface exists".
	rm -f "/var/run/wpa_supplicant/${sta_if}"

	logger -t wifi-sta "$sta_if created on $phy ($ap ENABLED after ${waited}s); $PROFILE_ENABLED saved network(s), primary '$ssid'"

	exec wpa_supplicant -D nl80211 -i "$sta_if" -c "$conf"
}

run_dhcp() {
	local sta_if i=0
	# The STA instance owns the vif; wait for it to exist and associate.
	while [ "$i" -lt 90 ]; do
		sta_if="$(find_sta)"
		[ -n "$sta_if" ] && iw dev "$sta_if" link 2>/dev/null | grep -q "^Connected" && break
		sta_if=""
		sleep 1
		i=$((i + 1))
	done

	[ -n "$sta_if" ] || { logger -t wifi-sta "dhcp: no associated STA vif after 90s"; exit 1; }

	logger -t wifi-sta "dhcp: $sta_if associated after ${i}s; starting udhcpc (hostname '$(sta_hostname)')"
	# -f: stay in the foreground (procd supervises).  The handler installs the
	# address only, never a default route.  -x hostname: announces our name to
	# the upstream DHCP server (option 12) -- the configured one, else the
	# system hostname.
	exec udhcpc -f -i "$sta_if" -p "/var/run/udhcpc-${sta_if}.pid" \
		-s /usr/sbin/wifi-sta-dhcp.sh \
		-x "hostname:$(sta_hostname)"
}

# Kill matching processes.  pgrep -f is used instead of pkill because busybox
# pkill does not reliably support -f here.
kill_matching() {
	pgrep -f "$1" 2>/dev/null | while read -r p; do
		[ "$p" != "$" ] && kill "$p" 2>/dev/null
	done
}

# Tear the STA down and let procd bring it back.  Deleting the vif alone is NOT
# enough: wpa_supplicant keeps running on the dead netdev (verified), so the
# instance would never be respawned and would never re-create the vif.
recycle_sta() {
	local sta_if="$1"
	[ -n "$sta_if" ] && iw dev "$sta_if" del 2>/dev/null
	kill_matching "wpa_supplicant -D nl80211 -i ${sta_if:-phy}"
	kill_matching "udhcpc -f -i ${sta_if:-phy}"
	sleep 10
}

run_watchdog() {
	local sta_if ap ap_ch up_ch down=0 miss=0

	while true; do
		sleep 15

		sta_if="$(find_sta)"
		if [ -n "$sta_if" ] && iw dev "$sta_if" link 2>/dev/null | grep -q "^Connected"; then
			down=0
			miss=0
			continue
		fi

		down=$((down + 15))
		[ "$down" -lt "$recover_after" ] && continue

		if [ -z "$sta_if" ]; then
			logger -t wifi-sta "watchdog: STA vif missing for ${down}s; recycling"
			recycle_sta ""
			down=0
			continue
		fi

		# Disconnected long enough to be a real problem.  Is the channel the
		# reason?  (One radio: the STA can only join an upstream that sits on
		# the same channel as our AP.)
		ap="$(find_ap)"
		ap_ch="$(ap_channel "$ap")"
		scan_any_channel "$sta_if"
		up_ch="$UP_CH"

		if [ -n "$up_ch" ] && [ -n "$ap_ch" ] && [ "$up_ch" != "$ap_ch" ]; then
			logger -t wifi-sta "watchdog: down ${down}s and upstream '$UP_SSID' moved to channel $up_ch (AP on $ap_ch); recycling the STA"
			recycle_sta "$sta_if"
		else
			# Upstream simply absent / wrong PSK / AP channel already right:
			# nothing to fix here, and logging every minute would flood the
			# ring buffer.  First occurrence, then one in five (~5 min).
			# A rejected password is reported by wifi-sta-wpa-event instead.
			miss=$((miss + 1))
			if [ "$miss" -eq 1 ] || [ $((miss % 5)) -eq 0 ]; then
				logger -t wifi-sta "watchdog: down ${down}s, no channel mismatch (upstream=${UP_SSID:-not seen} ch=${up_ch:-none} ap=${ap_ch:-none}); leaving it to wpa_supplicant"
			fi
		fi
		down=0
	done
}

# Machine-readable state for the LuCI page: key=value lines, nothing else.
# "key=value", one per line.  An SSID may legally contain a newline, which would
# break the line protocol (and could inject a second key), so fold CR/LF to
# spaces before printing.
kv() {
	printf '%s=%s\n' "$1" "$(printf '%s' "$2" | tr '\n\r' '  ')"
}

run_status() {
	local ap sta link sta_ch ap_ch

	kv enabled "$enabled"
	kv ssid "$ssid"
	kv macaddr "$macaddr"
	kv dhcp "$dhcp"
	kv radio "$radio"
	kv recover_after "$recover_after"
	# Saved networks (enabled profiles) and any whose password was rejected
	# since the last start (space-separated SSIDs).
	kv profiles "$PROFILE_ENABLED"
	wk=""
	[ -f /var/run/wifi-sta-wrongkey ] &&
		wk="$(tr '\n' ' ' < /var/run/wifi-sta-wrongkey | sed 's/ *$//')"
	kv wrong_key "$wk"
	# Effective announce-hostname (configured value or the system default) so
	# the LuCI page can show what would actually be sent.
	kv hostname "$(sta_hostname)"

	ap="$(find_ap)"
	sta="$(find_sta)"
	kv ap_iface "$ap"
	kv sta_iface "$sta"

	if [ -n "$ap" ]; then
		ap_ch="$(ap_channel "$ap")"
		kv ap_state "$(ap_state "$ap")"
		kv ap_channel "$ap_ch"
		# "ssid <name>" -- a hidden SSID prints the bare word, so require the
		# space and let the empty result through.
		kv ap_ssid "$(iw dev "$ap" info 2>/dev/null | sed -n 's/^[[:space:]]*ssid //p' | head -n 1)"
		kv ap_clients "$(iw dev "$ap" station dump 2>/dev/null | grep -c '^Station')"
	fi

	if [ -n "$sta" ]; then
		# Read the link block once: it is parsed several times below, and a
		# flap between two separate "iw" calls would produce a mixed answer.
		link="$(iw dev "$sta" link 2>/dev/null)"

		if printf '%s\n' "$link" | grep -q '^Connected'; then
			sta_ch="$(iw dev "$sta" info 2>/dev/null | awk '/^[[:space:]]*channel/ { print $2; exit }')"
			kv sta_connected 1
			# "SSID: my: net" must keep its colon; -F': ' would cut it to "my".
			kv sta_ssid "$(printf '%s\n' "$link" | sed -n 's/^[[:space:]]*SSID: //p' | head -n 1)"
			kv sta_bssid "$(printf '%s\n' "$link" | awk '/^Connected to/ { print $3; exit }')"
			kv sta_channel "$sta_ch"
			# Field after the label, not $2/$3: iw may print the signal as
			# "-55 [-60, -58] dBm", and older builds put "tx bitrate:" on the
			# same line as "signal:".
			kv sta_signal "$(printf '%s\n' "$link" | awk '/signal:/ { for (i = 1; i <= NF; i++) if ($i == "signal:") { print $(i + 1) " dBm"; exit } }')"
			kv sta_bitrate "$(printf '%s\n' "$link" | awk '/tx bitrate:/ { for (i = 1; i <= NF; i++) if ($i == "bitrate:") { print $(i + 1) " " $(i + 2); exit } }')"
		else
			kv sta_connected 0
		fi

		kv sta_ip "$(ip -4 -br addr show "$sta" 2>/dev/null | awk '{ print $3; exit }')"
	fi

	# Do the two roles sit on the same channel?  (One radio: they must.)
	# Reuse the values already printed so the two answers cannot disagree.
	if [ -n "$ap" ] && [ -n "$sta" ]; then
		if [ -n "$ap_ch" ] && [ -n "$sta_ch" ] && [ "$sta_ch" = "$ap_ch" ]; then
			kv channel_match 1
		else
			kv channel_match 0
		fi
	fi
}

case "$MODE" in
sta)  bring_up_sta ;;
dhcp) run_dhcp ;;
watchdog) run_watchdog ;;
status)   run_status ;;
*)    echo "usage: $0 sta|dhcp|watchdog|status" >&2; exit 1 ;;
esac
