#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
#
# apk-key-refresh -- keep the akbar-npj custom-feed signing key in sync with
# the canonical key published at a stable, version-independent URL, and warn
# when the feed's kernel does not match the device's (kmod-* packages are
# vermagic-locked to one kernel build).
#
# Why: the CI release job signs the package feed with a persistent key (the
# repository secret APK_SIGNING_KEY).  An image embeds that key at build time,
# but a device flashed with an older image -- or one built before the key was
# pinned -- can carry a stale key and then reject every feed with
# "UNTRUSTED signature" on `apk update`.  Fetching the key from the stable URL
# at boot lets any device self-heal without a reflash.
#
# The install is intentionally conservative: the fetched file must be a
# well-formed PEM public key, and the on-disk key is only replaced when it
# actually differs (so we do not churn the overlay on every boot).
#
# Four callers, and the contract every one of them relies on: the refresh is
# best-effort and NEVER blocks or fails the caller -- it only warns (syslog
# and stderr) when the key was stale or a refresh attempt failed:
#   /etc/init.d/apk-key-refresh     boot, retries through the modem delay
#   /etc/hotplug.d/iface/99-...     any interface coming up
#   /etc/apk/commit_hooks.d/10-...  before an apk package commit
#   /etc/profile.d/99-...           interactive apk update/add/upgrade/fix

# --- --help ---------------------------------------------------------------
case "${1:-}" in
	-h|--help)
		cat <<'USAGE'
Usage: apk-key-refresh [--help]

Fetch the akbar-npj package-feed signing key from the canonical URL and install
it in /etc/apk/keys when it differs from the copy on disk.  Run at boot by
procd (/etc/init.d/apk-key-refresh) so a device carrying a stale key self-heals
without a reflash.  Also warns when the feed's kernel package differs from the
installed one (kmod-* installs would fail on the vermagic constraint).

Environment overrides:
  KEY_URL    key URL                (default: the project's public-key.pem)
  KEY_FILE   install path           (default: /etc/apk/keys/akbar-npj-v25.12.6.pem)
  RETRIES    attempts at boot       (default 15)
  DELAY      seconds between tries  (default 20)

Options:
  -h, --help   Show this help and exit

Log:  logread -e apk-key-refresh
USAGE
		exit 0
		;;
esac

KEY_URL="${KEY_URL:-https://akbar-npj.github.io/msm8916-openwrt/public-key.pem}"
KEY_FILE="${KEY_FILE:-/etc/apk/keys/akbar-npj-v25.12.6.pem}"
TMP_FILE="/tmp/.apk-key-refresh.$$"

# Boot-time retries: the modem may not be attached yet when we start.
RETRIES="${RETRIES:-15}"
DELAY="${DELAY:-20}"

# Every message goes to syslog AND to stderr: the boot-time caller only
# needs the log, but the apk commit hook and the interactive-shell wrapper
# must show the user a stale key or a failed refresh attempt (they never
# propagate a failure -- the apk command always continues).
log() {
	logger -t apk-key-refresh "$1"
	echo "apk-key-refresh: $1" >&2
}

# Fetch URL -> TMP_FILE.  Prefer OpenWrt's uclient-fetch, fall back to BusyBox wget.
fetch() {
	if command -v uclient-fetch >/dev/null 2>&1; then
		uclient-fetch -q -T 15 -O "$TMP_FILE" "$KEY_URL" 2>/dev/null && return 0
	fi
	if command -v wget >/dev/null 2>&1; then
		wget -q -T 15 -O "$TMP_FILE" "$KEY_URL" 2>/dev/null && return 0
	fi
	return 1
}

# Validate + install TMP_FILE.  Returns:
#   0 = key installed (changed)
#   2 = already current (no change)
#   1 = not a valid key (kept the existing one)
install_key() {
	[ "$(head -n1 "$TMP_FILE" 2>/dev/null)" = "-----BEGIN PUBLIC KEY-----" ] || return 1
	grep -q -- "-----END PUBLIC KEY-----" "$TMP_FILE" 2>/dev/null || return 1
	[ "$(wc -c < "$TMP_FILE" 2>/dev/null)" -ge 100 ] || return 1

	if [ -f "$KEY_FILE" ] && cmp -s "$TMP_FILE" "$KEY_FILE"; then
		return 2
	fi

	mkdir -p "$(dirname "$KEY_FILE")"
	cat "$TMP_FILE" > "$KEY_FILE"
	return 0
}

# --- kernel/feed consistency -------------------------------------------------
# kmod-* packages are built against one exact kernel: the vermagic is part of
# the kernel package version (kernel-<kver>~<hash>-r<N>), so a kmod taken from
# a feed built for a different kernel cannot be installed -- apk just fails
# with an opaque "unable to satisfy dependencies" on the kernel constraint.
# Compare the feed's available kernel package with the installed one and warn.
# Same contract as the key refresh: warn, never block.  The check reads apk's
# index cache, so it reflects the last `apk update` -- a stale cache can only
# MISS a mismatch, never report a false one.
kernel_check() {
	installed=$(apk list -I 2>/dev/null | awk '$1 ~ /^kernel-[0-9]/ { print $1; exit }')
	available=$(apk list -a 2>/dev/null | awk '$1 ~ /^kernel-[0-9]/ { print $1; exit }')

	[ -n "$installed" ] && [ -n "$available" ] || return 0
	[ "$installed" = "$available" ] && return 0

	log "WARNING: package-feed kernel mismatch: the feed provides $available, but this device has $installed installed"
	log "kmod-* packages from this feed will NOT install (kernel vermagic mismatch) -- reflash the matching image, or use packages built for your kernel"
}

trap 'rm -f "$TMP_FILE"' EXIT

i=0
rc=1
while [ "$i" -lt "$RETRIES" ]; do
	if fetch; then
		install_key
		case "$?" in
			0)
				log "the feed signing key was stale; installed the updated key"
				rc=0
				;;
			2)
				rc=0
				;;
			*)
				log "WARNING: data from $KEY_URL is not a valid public key; keeping the existing key (it may be stale)"
				;;
		esac
		rm -f "$TMP_FILE"
		[ "$rc" = 0 ] && break
	fi
	i=$((i + 1))
	[ "$i" -lt "$RETRIES" ] && sleep "$DELAY"
done

if [ "$rc" != 0 ]; then
	log "WARNING: could not refresh the feed signing key from $KEY_URL (offline?); the on-disk key may be stale"
	log "if apk reports UNTRUSTED signature, run: apk-key-refresh && apk update"
fi

kernel_check

exit "$rc"
