#!/bin/sh
# Modem Bearer Stall Watchdog & Carrier Keepalive
#
# Resolves carrier-side user-plane stalls (traffic-channel-dormant) safely:
# 1. Configurable low-rate keepalive (10s default) with confirmed RX counter increments.
# 2. Stage 1 non-disruptive wakeup: qmicli --wds-go-active with RX verification.
# 3. Stage 2 serialized netifd fallback: ifdown modem -> sleep 3 -> ifup modem.
# 4. Zero mmcli --disable/enable, zero --set-power-state-low, zero AT+CFUN (eliminates SSR risk).
# 5. Shared recovery lock (/var/lock/modem-bearer.lock) with cooldown timer.
# 6. Comprehensive telemetry logging (WDS dormancy, Bearer ID, Cell ID, RX/TX).

LOCKFILE="/var/lock/modem-bearer.lock"

# Default baseline fallback values
STALL_TIMEOUT=30
CHECK_INTERVAL=5
COOLDOWN_SECS=60
KEEPALIVE_ENABLED=1
KEEPALIVE_INTERVAL=10
KEEPALIVE_TARGET="1.1.1.1"

LAST_TX=0
LAST_RX=0
STALL_COUNT=0
LAST_KEEPALIVE=0
LAST_RECOVERY=0

logger -t modem-stall-watchdog "Started modem bearer stall watchdog and carrier keepalive service (interval=${KEEPALIVE_INTERVAL}s)"

while true; do
    # Dynamically load UCI configuration
    ENABLED=$(uci -q get modem-watchdog.general.enabled || echo 1)
    if [ "$ENABLED" != "1" ] || [ -f /tmp/disable_modem_watchdog ]; then
        STALL_COUNT=0
        sleep "$CHECK_INTERVAL"
        continue
    fi

    STALL_TIMEOUT=$(uci -q get modem-watchdog.general.stall_timeout || echo 30)
    CHECK_INTERVAL=$(uci -q get modem-watchdog.general.check_interval || echo 5)
    COOLDOWN_SECS=$(uci -q get modem-watchdog.general.cooldown_seconds || echo 60)
    KEEPALIVE_ENABLED=$(uci -q get modem-watchdog.keepalive.enabled || echo 1)
    KEEPALIVE_INTERVAL=$(uci -q get modem-watchdog.keepalive.interval || echo 10)
    KEEPALIVE_TARGET=$(uci -q get modem-watchdog.keepalive.target || echo "1.1.1.1")

    # 1. Check if modem remoteproc is running
    RPROC=$(cat /sys/devices/platform/soc@0/4080000.remoteproc/remoteproc/remoteproc0/state 2>/dev/null)
    if [ "$RPROC" != "running" ]; then
        STALL_COUNT=0
        sleep "$CHECK_INTERVAL"
        continue
    fi

    # 2. Ensure BAM-DMUX maintains proven 30s autosuspend configuration
    BAM_CTRL="/sys/devices/platform/soc@0/4080000.remoteproc/4080000.remoteproc:bam-dmux/power/control"
    BAM_DELAY="/sys/devices/platform/soc@0/4080000.remoteproc/4080000.remoteproc:bam-dmux/power/autosuspend_delay_ms"
    if [ -f "$BAM_DELAY" ] && [ "$(cat "$BAM_DELAY" 2>/dev/null)" != "30000" ]; then
        echo auto > "$BAM_CTRL" 2>/dev/null || true
        echo 30000 > "$BAM_DELAY" 2>/dev/null || true
        logger -t modem-stall-watchdog "Restored BAM-DMUX control=auto and autosuspend=30000"
    fi

    # 3. Check if wwan0 interface is up in netifd
    IF_UP=$(ubus call network.interface.modem status 2>/dev/null | jsonfilter -e '@.up' 2>/dev/null)
    if [ "$IF_UP" != "true" ]; then
        STALL_COUNT=0
        sleep "$CHECK_INTERVAL"
        continue
    fi

    # 4. Check if QMI packet service remains connected
    WDS_STATUS=$(qmicli -p -d /dev/wwan0qmi0 --wds-get-packet-service-status 2>/dev/null | awk -F"'" '/Connection status:/ {print $2}')
    if [ "$WDS_STATUS" != "connected" ]; then
        STALL_COUNT=0
        sleep "$CHECK_INTERVAL"
        continue
    fi

    NOW=$(date +%s)

    # 5. Low-rate keepalive (if enabled and link is up)
    if [ "$KEEPALIVE_ENABLED" = "1" ] && [ ! -f /tmp/disable_modem_keepalive ]; then
        if [ $((NOW - LAST_KEEPALIVE)) -ge "$KEEPALIVE_INTERVAL" ]; then
            LAST_KEEPALIVE="$NOW"
            RX_PRE=$(cat /sys/class/net/wwan0/statistics/rx_packets 2>/dev/null || echo 0)
            ping -c 1 -W 2 -I wwan0 "$KEEPALIVE_TARGET" >/dev/null 2>&1 || true
            RX_POST=$(cat /sys/class/net/wwan0/statistics/rx_packets 2>/dev/null || echo 0)
            if [ "$RX_POST" -gt "$RX_PRE" ]; then
                logger -t modem-keepalive "Keepalive verified: RX incremented ($RX_PRE -> $RX_POST) via $KEEPALIVE_TARGET"
            else
                logger -t modem-keepalive "Keepalive warning: probe sent to $KEEPALIVE_TARGET but RX counter did not increment (RX=$RX_PRE)"
            fi
        fi
    fi

    # 6. Check traffic counters
    CUR_TX=$(cat /sys/class/net/wwan0/statistics/tx_packets 2>/dev/null || echo 0)
    CUR_RX=$(cat /sys/class/net/wwan0/statistics/rx_packets 2>/dev/null || echo 0)

    # Initialize counters on first run
    if [ "$LAST_TX" -eq 0 ] && [ "$LAST_RX" -eq 0 ]; then
        LAST_TX="$CUR_TX"
        LAST_RX="$CUR_RX"
        sleep "$CHECK_INTERVAL"
        continue
    fi

    DELTA_TX=$((CUR_TX - LAST_TX))
    DELTA_RX=$((CUR_RX - LAST_RX))

    LAST_TX="$CUR_TX"
    LAST_RX="$CUR_RX"

    # Stall accumulation logic:
    if [ "$DELTA_RX" -gt 0 ]; then
        # Actual incoming packets received: link healthy, reset stall counter
        STALL_COUNT=0
    elif [ "$DELTA_TX" -gt 0 ]; then
        # Outgoing packets sent, but zero incoming packets received: accumulate stall duration
        STALL_COUNT=$((STALL_COUNT + CHECK_INTERVAL))
        logger -t modem-stall-watchdog "Unbalanced traffic detected: TX+$DELTA_TX, RX+$DELTA_RX (stall duration: ${STALL_COUNT}s/${STALL_TIMEOUT}s)"

        if [ "$STALL_COUNT" -ge "$STALL_TIMEOUT" ]; then
            # Verify if connectivity is actually stalled before taking action
            RX_TEST_PRE=$(cat /sys/class/net/wwan0/statistics/rx_packets 2>/dev/null || echo 0)
            if ping -c 1 -W 2 -I wwan0 1.1.1.1 >/dev/null 2>&1 || ping -c 1 -W 2 -I wwan0 8.8.8.8 >/dev/null 2>&1; then
                RX_TEST_POST=$(cat /sys/class/net/wwan0/statistics/rx_packets 2>/dev/null || echo 0)
                if [ "$RX_TEST_POST" -gt "$RX_TEST_PRE" ]; then
                    logger -t modem-stall-watchdog "Connectivity probe succeeded and RX incremented; clearing stall counter."
                    STALL_COUNT=0
                    sleep "$CHECK_INTERVAL"
                    continue
                fi
            fi

            # Check cooldown period
            NOW=$(date +%s)
            if [ $((NOW - LAST_RECOVERY)) -lt "$COOLDOWN_SECS" ]; then
                logger -t modem-stall-watchdog "Recovery skipped: within cooldown period ($((NOW - LAST_RECOVERY))s < ${COOLDOWN_SECS}s)"
                sleep "$CHECK_INTERVAL"
                continue
            fi

            # Execute recovery under shared lock
            (
                flock -x 200

                # Log comprehensive telemetry
                WDS_DORMANCY=$(qmicli -p -d /dev/wwan0qmi0 --wds-get-dormancy-status 2>/dev/null | awk -F"'" '/Dormancy Status:/ {print $2}')
                BEARER_ID=$(mmcli -m any --output-keyvalue 2>/dev/null | awk -F': ' '/modem.generic.bearers/ {print $2}' | tr -d ' \r\n')
                CELL_ID=$(qmicli -p -d /dev/wwan0qmi0 --nas-get-cell-location-info 2>/dev/null | awk -F"'" '/Global Cell ID:/ {print $2}')
                logger -t modem-stall-watchdog "User-plane stall confirmed (${STALL_COUNT}s). Telemetry: WDS dormancy='${WDS_DORMANCY:-unknown}', Bearer='${BEARER_ID:-none}', Cell ID='${CELL_ID:-unknown}', TX=$CUR_TX, RX=$CUR_RX"

                # Stage 1: Attempt wds-go-active
                logger -t modem-stall-watchdog "Stage 1 recovery: executing 'qmicli -d /dev/wwan0qmi0 --wds-go-active'..."
                GO_ACTIVE_RES=$(qmicli -p -d /dev/wwan0qmi0 --wds-go-active 2>&1)
                GO_ACTIVE_RC=$?
                logger -t modem-stall-watchdog "Result of wds-go-active: rc=$GO_ACTIVE_RC, output='${GO_ACTIVE_RES}'"

                # Wait for RX recovery after wds-go-active
                WAKE_RECOVERED=0
                i=0
                while [ "$i" -lt 6 ]; do
                    sleep 1
                    RX_CHECK_PRE=$(cat /sys/class/net/wwan0/statistics/rx_packets 2>/dev/null || echo 0)
                    if ping -c 1 -W 1 -I wwan0 1.1.1.1 >/dev/null 2>&1 || ping -c 1 -W 1 -I wwan0 8.8.8.8 >/dev/null 2>&1; then
                        RX_CHECK_POST=$(cat /sys/class/net/wwan0/statistics/rx_packets 2>/dev/null || echo 0)
                        if [ "$RX_CHECK_POST" -gt "$RX_CHECK_PRE" ]; then
                            WAKE_RECOVERED=1
                            break
                        fi
                    fi
                    i=$((i + 1))
                done

                if [ "$WAKE_RECOVERED" -eq 1 ]; then
                    logger -t modem-stall-watchdog "Stage 1 SUCCESS: RX traffic successfully recovered via wds-go-active. No network teardown required."
                else
                    # Stage 2: Serialized ifdown -> short delay -> ifup
                    logger -t modem-stall-watchdog "Stage 1 insufficient (RX did not recover). Escalating to Stage 2: serialized ifdown modem -> short delay -> ifup modem..."
                    ifdown modem

                    # Wait for netifd teardown
                    i=0
                    while [ "$i" -lt 15 ]; do
                        st=$(ubus call network.interface.modem status 2>/dev/null)
                        u=$(echo "$st" | jsonfilter -e '@.up' 2>/dev/null)
                        p=$(echo "$st" | jsonfilter -e '@.pending' 2>/dev/null)
                        [ "$u" = "false" ] && [ "$p" = "false" ] && break
                        sleep 1
                        i=$((i + 1))
                    done

                    # Short settling gap
                    sleep 3

                    ifup modem

                    # Wait for netifd bringup
                    i=0
                    while [ "$i" -lt 25 ]; do
                        st=$(ubus call network.interface.modem status 2>/dev/null)
                        u=$(echo "$st" | jsonfilter -e '@.up' 2>/dev/null)
                        [ "$u" = "true" ] && break
                        sleep 1
                        i=$((i + 1))
                    done

                    logger -t modem-stall-watchdog "Stage 2 completed: serialized ifdown/ifup finished."
                fi
            ) 200>"$LOCKFILE"

            LAST_RECOVERY=$(date +%s)
            LAST_TX=$(cat /sys/class/net/wwan0/statistics/tx_packets 2>/dev/null || echo 0)
            LAST_RX=$(cat /sys/class/net/wwan0/statistics/rx_packets 2>/dev/null || echo 0)
            STALL_COUNT=0
            sleep 5
        fi
    fi

    sleep "$CHECK_INTERVAL"
done
