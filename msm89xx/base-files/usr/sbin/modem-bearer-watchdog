#!/bin/sh
# Modem Bearer Stall Watchdog (Option B)
# Recovers from user-plane data stalls cleanly via serialized bearer renegotiation.

LOCKFILE="/var/lock/modem-bearer.lock"
STALL_TIMEOUT=30 # seconds of TX increment without RX
CHECK_INTERVAL=5

LAST_TX=0
LAST_RX=0
STALL_COUNT=0

logger -t modem-stall-watchdog "Started modem bearer stall watchdog (Option B)"

while true; do
    if [ -f /tmp/disable_modem_watchdog ]; then
        STALL_COUNT=0
        sleep "$CHECK_INTERVAL"
        continue
    fi

    # 1. Check if modem remoteproc is running (no SSR present)
    RPROC=$(cat /sys/devices/platform/soc@0/4080000.remoteproc/remoteproc/remoteproc0/state 2>/dev/null)
    if [ "$RPROC" != "running" ]; then
        STALL_COUNT=0
        sleep "$CHECK_INTERVAL"
        continue
    fi

    # 2. Check if wwan0 interface is up in netifd
    IF_UP=$(ubus call network.interface.modem status 2>/dev/null | jsonfilter -e '@.up' 2>/dev/null)
    if [ "$IF_UP" != "true" ]; then
        STALL_COUNT=0
        sleep "$CHECK_INTERVAL"
        continue
    fi

    # 3. Check if WDS remains attached
    WDS_STATUS=$(qmicli -p -d /dev/wwan0qmi0 --wds-get-packet-service-status 2>/dev/null | awk -F"'" '/Connection status:/ {print $2}')
    if [ "$WDS_STATUS" != "connected" ]; then
        STALL_COUNT=0
        sleep "$CHECK_INTERVAL"
        continue
    fi

    # 4. Check packet counters
    CUR_TX=$(cat /sys/class/net/wwan0/statistics/tx_packets 2>/dev/null || echo 0)
    CUR_RX=$(cat /sys/class/net/wwan0/statistics/rx_packets 2>/dev/null || echo 0)

    # Initialize counters on first run
    if [ "$LAST_TX" -eq 0 ] && [ "$LAST_RX" -eq 0 ]; then
        LAST_TX="$CUR_TX"
        LAST_RX="$CUR_RX"
        sleep "$CHECK_INTERVAL"
        continue
    fi

    DELTA_TX=$((CUR_TX - LAST_TX))
    DELTA_RX=$((CUR_RX - LAST_RX))

    LAST_TX="$CUR_TX"
    LAST_RX="$CUR_RX"

    # Condition: TX increased, but RX did not increase
    if [ "$DELTA_TX" -gt 0 ] && [ "$DELTA_RX" -eq 0 ]; then
        STALL_COUNT=$((STALL_COUNT + CHECK_INTERVAL))
        logger -t modem-stall-watchdog "Unbalanced traffic detected: TX+$DELTA_TX, RX+$DELTA_RX (stall duration: ${STALL_COUNT}s/${STALL_TIMEOUT}s)"
        
        if [ "$STALL_COUNT" -ge "$STALL_TIMEOUT" ]; then
            logger -t modem-stall-watchdog "User-plane stall confirmed (${STALL_COUNT}s). Triggering serialized bearer recovery..."
            (
                flock -x 200
                logger -t modem-stall-watchdog "Executing soft bearer reconnect..."
                ubus call network.interface.modem down
                
                # Wait for netifd teardown
                i=0
                while [ "$i" -lt 15 ]; do
                    st=$(ubus call network.interface.modem status 2>/dev/null)
                    u=$(echo "$st" | jsonfilter -e '@.up' 2>/dev/null)
                    p=$(echo "$st" | jsonfilter -e '@.pending' 2>/dev/null)
                    [ "$u" = "false" ] && [ "$p" = "false" ] && break
                    sleep 1
                    i=$((i + 1))
                done
                
                sleep 2
                ubus call network.interface.modem up
                logger -t modem-stall-watchdog "Soft bearer reconnect dispatched cleanly."
            ) 200>"$LOCKFILE"
            
            STALL_COUNT=0
            sleep 10
        fi
    else
        # Normal traffic flow or idle; reset stall counter
        STALL_COUNT=0
    fi

    sleep "$CHECK_INTERVAL"
done
