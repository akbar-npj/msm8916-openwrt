#!/bin/sh
# Modem Bearer Stall Watchdog (Option B)
# Recovers from user-plane data stalls cleanly via serialized bearer renegotiation.

LOCKFILE="/var/lock/modem-bearer.lock"
STALL_TIMEOUT=30 # seconds of TX increment without RX
CHECK_INTERVAL=5

LAST_TX=0
LAST_RX=0
STALL_COUNT=0

logger -t modem-stall-watchdog "Started modem bearer stall watchdog (Option B)"

while true; do
    if [ -f /tmp/disable_modem_watchdog ]; then
        STALL_COUNT=0
        sleep "$CHECK_INTERVAL"
        continue
    fi

    # 1. Check if modem remoteproc is running (no SSR present)
    RPROC=$(cat /sys/devices/platform/soc@0/4080000.remoteproc/remoteproc/remoteproc0/state 2>/dev/null)
    if [ "$RPROC" != "running" ]; then
        STALL_COUNT=0
        sleep "$CHECK_INTERVAL"
        continue
    fi

    # Ensure BAM-DMUX retains 30s autosuspend (proven stability configuration)
    BAM_CTRL="/sys/devices/platform/soc@0/4080000.remoteproc/4080000.remoteproc:bam-dmux/power/control"
    BAM_DELAY="/sys/devices/platform/soc@0/4080000.remoteproc/4080000.remoteproc:bam-dmux/power/autosuspend_delay_ms"
    if [ -f "$BAM_DELAY" ] && [ "$(cat "$BAM_DELAY" 2>/dev/null)" != "30000" ]; then
        echo auto > "$BAM_CTRL" 2>/dev/null || true
        echo 30000 > "$BAM_DELAY" 2>/dev/null || true
        logger -t modem-stall-watchdog "Restored BAM-DMUX control=auto and autosuspend=30000"
    fi

    # 2. Check if wwan0 interface is up in netifd
    IF_UP=$(ubus call network.interface.modem status 2>/dev/null | jsonfilter -e '@.up' 2>/dev/null)
    if [ "$IF_UP" != "true" ]; then
        STALL_COUNT=0
        sleep "$CHECK_INTERVAL"
        continue
    fi

    # 3. Check if WDS remains attached
    WDS_STATUS=$(qmicli -p -d /dev/wwan0qmi0 --wds-get-packet-service-status 2>/dev/null | awk -F"'" '/Connection status:/ {print $2}')
    if [ "$WDS_STATUS" != "connected" ]; then
        STALL_COUNT=0
        sleep "$CHECK_INTERVAL"
        continue
    fi

    # 4. Check packet counters
    CUR_TX=$(cat /sys/class/net/wwan0/statistics/tx_packets 2>/dev/null || echo 0)
    CUR_RX=$(cat /sys/class/net/wwan0/statistics/rx_packets 2>/dev/null || echo 0)

    # Initialize counters on first run
    if [ "$LAST_TX" -eq 0 ] && [ "$LAST_RX" -eq 0 ]; then
        LAST_TX="$CUR_TX"
        LAST_RX="$CUR_RX"
        sleep "$CHECK_INTERVAL"
        continue
    fi

    DELTA_TX=$((CUR_TX - LAST_TX))
    DELTA_RX=$((CUR_RX - LAST_RX))

    LAST_TX="$CUR_TX"
    LAST_RX="$CUR_RX"

    # Condition: TX increased, but RX did not increase
    if [ "$DELTA_TX" -gt 0 ] && [ "$DELTA_RX" -eq 0 ]; then
        STALL_COUNT=$((STALL_COUNT + CHECK_INTERVAL))
        logger -t modem-stall-watchdog "Unbalanced traffic detected: TX+$DELTA_TX, RX+$DELTA_RX (stall duration: ${STALL_COUNT}s/${STALL_TIMEOUT}s)"
        
        if [ "$STALL_COUNT" -ge "$STALL_TIMEOUT" ]; then
            # Verify if Internet connectivity is actually dead before taking action
            if ping -c 1 -W 2 1.1.1.1 >/dev/null 2>&1 || ping -c 1 -W 2 8.8.8.8 >/dev/null 2>&1; then
                logger -t modem-stall-watchdog "Connectivity probe succeeded despite counter imbalance; resetting stall counter."
                STALL_COUNT=0
                sleep "$CHECK_INTERVAL"
                continue
            fi

            logger -t modem-stall-watchdog "User-plane stall confirmed (${STALL_COUNT}s). Triggering coordinated radio recovery..."
            (
                flock -x 200
                logger -t modem-stall-watchdog "Executing coordinated ModemManager radio recovery..."
                ubus call network.interface.modem down
                
                # Wait for netifd teardown
                i=0
                while [ "$i" -lt 15 ]; do
                    st=$(ubus call network.interface.modem status 2>/dev/null)
                    u=$(echo "$st" | jsonfilter -e '@.up' 2>/dev/null)
                    p=$(echo "$st" | jsonfilter -e '@.pending' 2>/dev/null)
                    [ "$u" = "false" ] && [ "$p" = "false" ] && break
                    sleep 1
                    i=$((i + 1))
                done
                
                sleep 2
                mmcli -m any --disable >/dev/null 2>&1 || true
                sleep 2
                mmcli -m any --enable >/dev/null 2>&1 || true
                sleep 3
                ubus call network.interface.modem up
                
                # Wait for netifd bringup
                i=0
                while [ "$i" -lt 20 ]; do
                    st=$(ubus call network.interface.modem status 2>/dev/null)
                    u=$(echo "$st" | jsonfilter -e '@.up' 2>/dev/null)
                    [ "$u" = "true" ] && break
                    sleep 1
                    i=$((i + 1))
                done

                logger -t modem-stall-watchdog "Coordinated radio recovery completed."
            ) 200>"$LOCKFILE"
            
            # Re-read counters post-recovery
            LAST_TX=$(cat /sys/class/net/wwan0/statistics/tx_packets 2>/dev/null || echo 0)
            LAST_RX=$(cat /sys/class/net/wwan0/statistics/rx_packets 2>/dev/null || echo 0)
            STALL_COUNT=0
            sleep 15
        fi
    else
        # Normal traffic flow or idle; reset stall counter
        STALL_COUNT=0
    fi

    sleep "$CHECK_INTERVAL"
done
