#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
#
# modem-a2-hold -- keep the AP's SMSM_A2_POWER_CONTROL vote SET so the modem's
# A2 never powers down.
#
# WHY
#   On HMU05/OpenWrt the modem asserts `a2_power.c:1189` (A2 power-up quiesce
#   timeout) on the A2 power-down/up cycle.  Once a data bearer is up the cycle
#   runs ~once per 8 s and ~8 % of the cycles kill the modem, so `wwan0` flaps
#   with a new IP every ~65-70 s.  Measured 2026-10-07: `control=auto` ->
#   5 fatals / 61 cycles / 488 s; `control=on` -> 0 fatals / 200 s.
#
#   `bam_dmux_runtime_suspend()` is the ONLY writer of `bam_dmux_pc_vote(false)`;
#   with the bam-dmux device pinned runtime-ACTIVE it never runs, so the APPS
#   client (11) never releases and the A2 stays up (ledger H-A2c, re-confirmed).
#
#   This is the `a2_pin=1` lever.  It is a WORKAROUND for an OpenWrt-side
#   handshake defect -- Android lets the A2 collapse (bam_dmux.c
#   ul_powerdown()/ul_wakeup()) and does not assert -- not the root fix.
#
# The pin can self-revert (e.g. a driver runtime-PM reset), so re-assert it.

BAM_CTRL="/sys/devices/platform/soc@0/4080000.remoteproc/4080000.remoteproc:bam-dmux/power/control"
INTERVAL=5
last=""

while :; do
    if [ -f "$BAM_CTRL" ]; then
        cur=$(cat "$BAM_CTRL" 2>/dev/null)
        if [ "$cur" != "on" ]; then
            echo on > "$BAM_CTRL" 2>/dev/null && \
                logger -t modem-a2-hold "held BAM-DMUX control=on (was '${cur:-unknown}')"
        fi
        # Log only transitions, so the ring does not flood.
        [ "$cur" != "$last" ] && last="$cur"
    fi
    sleep "$INTERVAL"
done
