#!/bin/sh

#
#
# Generic modem subsystem health monitor
#
#
# RED LED:
#
#   Modem subsystem healthy  -> OFF
#   Modem starting/unhealthy -> BLINK
#
# Health means:
#
#   - Qualcomm MSS remoteproc exists
#   - MSS is running
#   - WWAN core exists
#   - QMI control port exists
#   - ModemManager sees the modem
#
# An intentional "ifdown modem" does NOT count as a modem failure.
#

LED="/sys/class/leds/red:power"
QMI="/sys/class/wwan/wwan0qmi0"
MSS_NAME="4080000.remoteproc"

CHECK_INTERVAL=2
MODEM_INITIALIZED=0
MODEM_INDEX=""

. /lib/functions.sh 2>/dev/null || true
case "$(board_name 2>/dev/null)" in
        *hmu05*) IS_HMU05=1 ;;
        *) IS_HMU05=0 ;;
esac


set_red()
{
        [ -e "$LED/trigger" ] || return 1

        case "$1" in
                0)
                        #
                        # Modem healthy:
                        # RED OFF
                        #
                        echo none > "$LED/trigger" 2>/dev/null
                        echo 0 > "$LED/brightness" 2>/dev/null
                        ;;

                1)
                        #
                        # Modem unhealthy / starting:
                        # RED BLINK
                        #
                        echo timer > "$LED/trigger" 2>/dev/null
                        echo 500 > "$LED/delay_on" 2>/dev/null
                        echo 500 > "$LED/delay_off" 2>/dev/null
                        ;;
        esac
}


find_mss()
{
        for r in /sys/class/remoteproc/remoteproc*; do
                [ -r "$r/name" ] || continue

                name="$(cat "$r/name" 2>/dev/null)"

                if [ "$name" = "$MSS_NAME" ]; then
                        echo "$r"
                        return 0
                fi
        done

        return 1
}


init_modem_hardware()
{
        command -v mmcli >/dev/null 2>&1 || return 1

        local m_idx="$(mmcli -L 2>/dev/null | grep -m1 -o '/Modem/[0-9]\+' | cut -d/ -f3)"
        [ -n "$m_idx" ] || return 1
        MODEM_INDEX="$m_idx"
        MODEM_INITIALIZED=1
        logger -t modem-init "Modem subsystem initialized at index $MODEM_INDEX"

        # If modem is disabled (firstboot/SIM reset), auto-enable it so cellular connects automatically
        local m_state="$(mmcli -m "$m_idx" 2>/dev/null | grep -i 'state:' | head -n1 | awk '{print $NF}')"
        if [ "$m_state" = "disabled" ]; then
                logger -t modem-auto-enable "Modem $m_idx is in disabled state; automatically enabling..."
                mmcli -m "$m_idx" -e >/dev/null 2>&1 || true
        fi

        # On HMU05, lock band mask to LTE-only ONLY if network is Jio (pure LTE-only network without 2G/3G)
        # Other networks (Airtel, BSNL, Vi, Ncell, NTC, etc.) have active 2G/3G and must keep full bands
        if [ "$IS_HMU05" = "1" ]; then
                local op_code="$(mmcli -m "$m_idx" --output-keyvalue 2>/dev/null | awk -F': ' '/modem.3gpp.operator-code/ {print $2}' | tr -d ' \r\n')"
                local op_name="$(mmcli -m "$m_idx" --output-keyvalue 2>/dev/null | awk -F': ' '/modem.3gpp.operator-name/ {print $2}' | tr -d ' \r\n')"
                local is_jio=0
                case "$op_code" in
                        4058[4-7][0-9]) is_jio=1 ;;
                esac
                case "$op_name" in
                        *[Jj]io*|*[Rr]eliance*|*"IN Loop"*) is_jio=1 ;;
                esac

                if [ "$is_jio" = "1" ]; then
                        local cur_bands="$(mmcli -m "$m_idx" --output-keyvalue 2>/dev/null | awk -F': ' '/modem.generic.current-bands.value/ {print $2}')"
                        if echo "$cur_bands" | grep -qi -E '\<utran|\<geran'; then
                                logger -t modem-band-lock "HMU05 (Jio): Locking bands to LTE-only to eliminate 2G/3G IRAT measurement gap crashes..."
                                mmcli -m "$m_idx" --set-current-bands="eutran-1|eutran-3|eutran-5|eutran-8" >/dev/null 2>&1 || true
                        fi
                fi
        fi

        return 0
}


modem_healthy()
{
        #
        # 1. Find MSS dynamically.
        #
        rproc="$(find_mss)" || { MODEM_INITIALIZED=0; return 1; }

        #
        # MSS must be running.
        #
        [ -r "$rproc/state" ] || { MODEM_INITIALIZED=0; return 1; }
        [ "$(cat "$rproc/state" 2>/dev/null)" = "running" ] || { MODEM_INITIALIZED=0; return 1; }

        # On HMU05, ensure BAM-DMUX runtime power management remains active (no autosuspend)
        if [ "$IS_HMU05" = "1" ]; then
                local bctrl="/sys/devices/platform/soc@0/4080000.remoteproc/4080000.remoteproc:bam-dmux/power/control"
                if [ -f "$bctrl" ] && [ "$(cat "$bctrl" 2>/dev/null)" != "on" ]; then
                        echo on > "$bctrl" 2>/dev/null || true
                fi
        fi

        #
        # 2. WWAN and QMI subsystems must exist in kernel.
        #
        [ -e /sys/class/wwan/wwan0 ] || { MODEM_INITIALIZED=0; return 1; }
        [ -e "$QMI" ] || { MODEM_INITIALIZED=0; return 1; }

        #
        # 3. One-time hardware modem configuration.
        # Subsequent healthy checks run purely against instant kernel sysfs (0 DBus calls).
        #
        if [ "$MODEM_INITIALIZED" != "1" ]; then
                init_modem_hardware || return 1
        fi

        return 0
}


#
# Fail-safe startup state.
#
# DTS also has red:power ON during early boot.
# Once this monitor starts, blink RED until the modem
# subsystem has been confirmed healthy.
#

set_red 1

BLUE_LED="/sys/class/leds/blue:wan"
[ -d "$BLUE_LED" ] || BLUE_LED="/sys/class/leds/blue:wlan"

set_blue_led() {
        local state="$1"
        [ -e "$BLUE_LED/trigger" ] || return 0
        local cur_off="$(cat "$BLUE_LED/delay_off" 2>/dev/null)"

        case "$state" in
                beacon)
                        [ "$cur_off" = "9500" ] && return 0
                        # Disconnected / searching: 500ms ON / 9500ms OFF (10s beacon)
                        echo timer > "$BLUE_LED/trigger" 2>/dev/null
                        echo 500 > "$BLUE_LED/delay_on" 2>/dev/null
                        echo 9500 > "$BLUE_LED/delay_off" 2>/dev/null
                        ;;
                idle)
                        [ "$cur_off" = "1000" ] && return 0
                        # Connected idle: 1000ms ON / 1000ms OFF
                        echo timer > "$BLUE_LED/trigger" 2>/dev/null
                        echo 1000 > "$BLUE_LED/delay_on" 2>/dev/null
                        echo 1000 > "$BLUE_LED/delay_off" 2>/dev/null
                        ;;
                active)
                        [ "$cur_off" = "500" ] && return 0
                        # Connected active traffic: 500ms ON / 500ms OFF
                        echo timer > "$BLUE_LED/trigger" 2>/dev/null
                        echo 500 > "$BLUE_LED/delay_on" 2>/dev/null
                        echo 500 > "$BLUE_LED/delay_off" 2>/dev/null
                        ;;
        esac
}

set_blue_led beacon

LAST=""

# Keepalive and Safe Recovery Architecture parameters
KEEPALIVE_INTERVAL=2
KEEPALIVE_TIMER=0
LAST_RX_PKTS=0
LAST_TX_PKTS=0
FAIL_COUNT=0
MAX_FAILS=5
COOLDOWN_SECS=60
LAST_RECOVERY=0
LOCKFILE="/var/run/modem-recovery.lock"

safe_reconnect_modem() {
        local reason="$1"
        local now="$(date +%s)"

        if [ $((now - LAST_RECOVERY)) -lt "$COOLDOWN_SECS" ]; then
                logger -t modem-recovery "Recovery skipped: within cooldown period ($((now - LAST_RECOVERY))s < ${COOLDOWN_SECS}s)"
                return 0
        fi

        if [ -f "$LOCKFILE" ]; then
                logger -t modem-recovery "Recovery already in progress (lock exists); skipping."
                return 0
        fi

        touch "$LOCKFILE"
        logger -t modem-recovery "Triggering safe synchronized modem reconnection (reason: $reason)..."

        # 1. Asynchronously request netifd teardown
        ifdown modem

        # 2. Synchronously wait for netifd to complete teardown
        local i=0
        while [ "$i" -lt 15 ]; do
                local status="$(ubus call network.interface.modem status 2>/dev/null)"
                local is_up="$(echo "$status" | jsonfilter -e '@.up' 2>/dev/null)"
                local is_pending="$(echo "$status" | jsonfilter -e '@.pending' 2>/dev/null)"
                if [ "$is_up" = "false" ] && [ "$is_pending" = "false" ]; then
                        break
                fi
                sleep 1
                i=$((i + 1))
        done

        # 3. Settling gap to allow QMI and ModemManager to clear session
        sleep 2

        # 4. Bring up interface cleanly
        ifup modem
        logger -t modem-recovery "Modem ifup dispatched cleanly after synchronized teardown."

        rm -f "$LOCKFILE"
        LAST_RECOVERY="$(date +%s)"
        FAIL_COUNT=0
}


run_watchdog_cycle() {
        local iface_status="$(ubus call network.interface.modem status 2>/dev/null)"
        local iface_up="$(echo "$iface_status" | jsonfilter -e '@.up' 2>/dev/null)"
        local iface_uptime="$(echo "$iface_status" | jsonfilter -e '@.uptime' 2>/dev/null)"

        if [ "$iface_up" = "true" ]; then
                # Allow a 15-second settling grace period after link comes up before probing
                if [ "${iface_uptime:-0}" -lt 15 ]; then
                        FAIL_COUNT=0
                        KEEPALIVE_TIMER=0
                        LAST_RX_PKTS="$(cat /sys/class/net/wwan0/statistics/rx_packets 2>/dev/null || echo 0)"
                        LAST_TX_PKTS="$(cat /sys/class/net/wwan0/statistics/tx_packets 2>/dev/null || echo 0)"
                        set_blue_led "idle"
                        return 0
                fi

                # Traffic-aware passive check: track RX and TX packets
                local cur_rx_pkts="$(cat /sys/class/net/wwan0/statistics/rx_packets 2>/dev/null || echo 0)"
                local cur_tx_pkts="$(cat /sys/class/net/wwan0/statistics/tx_packets 2>/dev/null || echo 0)"
                local delta_rx=$((cur_rx_pkts - LAST_RX_PKTS))
                local delta_tx=$((cur_tx_pkts - LAST_TX_PKTS))
                LAST_RX_PKTS="$cur_rx_pkts"
                LAST_TX_PKTS="$cur_tx_pkts"

                # Traffic-aware BLUE LED: active blink (500ms) on data, calm blink (1000ms) on idle
                if [ "$delta_rx" -gt 1 ] || [ "$delta_tx" -gt 1 ]; then
                        set_blue_led "active"
                else
                        set_blue_led "idle"
                fi

                if [ "$delta_rx" -gt 1 ] && [ "$FAIL_COUNT" -eq 0 ]; then
                        KEEPALIVE_TIMER=0
                        return 0
                fi

                KEEPALIVE_TIMER=$((KEEPALIVE_TIMER + CHECK_INTERVAL))

                if [ "$FAIL_COUNT" -gt 0 ] || [ "$KEEPALIVE_TIMER" -ge "$KEEPALIVE_INTERVAL" ]; then
                        KEEPALIVE_TIMER=0
                        # Send lightweight 1-packet heartbeat (1s timeout) to maintain active RRC_CONNECTED
                        if ping -c 1 -W 1 -I wwan0 1.1.1.1 >/dev/null 2>&1 || ping -c 1 -W 1 -I wwan0 8.8.8.8 >/dev/null 2>&1; then
                                if [ "$FAIL_COUNT" -gt 0 ]; then
                                        logger -t modem-keepalive "Modem connectivity restored after $FAIL_COUNT failed probe(s)."
                                fi
                                FAIL_COUNT=0
                        else
                                FAIL_COUNT=$((FAIL_COUNT + 1))
                                logger -t modem-keepalive "Keepalive ping failed ($FAIL_COUNT/$MAX_FAILS)"

                                # Fast check if cellular detached (only on failure)
                                local m_idx="${MODEM_INDEX:-0}"
                                local ps_state=""
                                if [ -n "$m_idx" ]; then
                                        ps_state="$(mmcli -m "$m_idx" --output-keyvalue 2>/dev/null | awk -F': ' '/modem.3gpp.packet-service-state/ {print $2}' | tr -d ' \r\n')"
                                fi
                                if [ "$ps_state" = "detached" ]; then
                                        logger -t modem-keepalive "Packet service detached detected; triggering recovery..."
                                        safe_reconnect_modem "packet service detached"
                                elif [ "$FAIL_COUNT" -ge "$MAX_FAILS" ]; then
                                        safe_reconnect_modem "ping heartbeat stalled"
                                fi
                        fi
                fi
        else
                # Interface is not up (e.g. user ran ifdown modem); reset state
                set_blue_led "beacon"
                KEEPALIVE_TIMER=0
                FAIL_COUNT=0
                LAST_RX_PKTS=0
                LAST_TX_PKTS=0
        fi
}


while true; do

        if modem_healthy; then

                STATE="healthy"
                VALUE=0

        else

                STATE="failed"
                VALUE=1

        fi


        #
        # Only update the LED when the health state changes.
        #

        if [ "$STATE" != "$LAST" ]; then

                set_red "$VALUE"


                logger -t modem-led-monitor \
                        "modem health: $STATE"

                LAST="$STATE"
        fi


        #
        # Two-Pronged Keepalive & Safe Self-Healing Watchdog (HMU05 only)
        #
        if [ "$STATE" = "healthy" ] && [ "$IS_HMU05" = "1" ]; then
                run_watchdog_cycle
        fi


        sleep "$CHECK_INTERVAL"

done
