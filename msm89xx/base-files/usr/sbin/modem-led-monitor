#!/bin/sh

#
#
# Generic modem subsystem health monitor
#
#
# RED LED:
#
#   Modem subsystem healthy  -> OFF
#   Modem starting/unhealthy -> BLINK
#
# Health means:
#
#   - Qualcomm MSS remoteproc exists
#   - MSS is running
#   - WWAN core exists
#   - QMI control port exists
#   - ModemManager sees the modem
#
# An intentional "ifdown modem" does NOT count as a modem failure.
#

LED="/sys/class/leds/red:power"
QMI="/sys/class/wwan/wwan0qmi0"
MSS_NAME="4080000.remoteproc"

CHECK_INTERVAL=5

. /lib/functions.sh 2>/dev/null || true
case "$(board_name 2>/dev/null)" in
        *hmu05*) IS_HMU05=1 ;;
        *) IS_HMU05=0 ;;
esac


set_red()
{
        [ -e "$LED/trigger" ] || return 1

        case "$1" in
                0)
                        #
                        # Modem healthy:
                        # RED OFF
                        #
                        echo none > "$LED/trigger" 2>/dev/null
                        echo 0 > "$LED/brightness" 2>/dev/null
                        ;;

                1)
                        #
                        # Modem unhealthy / starting:
                        # RED BLINK
                        #
                        echo timer > "$LED/trigger" 2>/dev/null
                        echo 500 > "$LED/delay_on" 2>/dev/null
                        echo 500 > "$LED/delay_off" 2>/dev/null
                        ;;
        esac
}


find_mss()
{
        for r in /sys/class/remoteproc/remoteproc*; do
                [ -r "$r/name" ] || continue

                name="$(cat "$r/name" 2>/dev/null)"

                if [ "$name" = "$MSS_NAME" ]; then
                        echo "$r"
                        return 0
                fi
        done

        return 1
}


modem_healthy()
{
        #
        # Find MSS dynamically.
        #
        # Do not assume MSS will always be remoteproc0.
        #

        rproc="$(find_mss)" || return 1


        #
        # MSS must be running.
        #

        [ -r "$rproc/state" ] || return 1

        [ "$(cat "$rproc/state" 2>/dev/null)" = "running" ] || return 1

        # On HMU05, ensure BAM-DMUX runtime power management remains active (no autosuspend)
        if [ "$IS_HMU05" = "1" ]; then
                local bctrl="/sys/devices/platform/soc@0/4080000.remoteproc/4080000.remoteproc:bam-dmux/power/control"
                if [ -f "$bctrl" ] && [ "$(cat "$bctrl" 2>/dev/null)" != "on" ]; then
                        echo on > "$bctrl" 2>/dev/null || true
                fi
        fi


        #
        # WWAN subsystem must exist.
        #

        [ -e /sys/class/wwan/wwan0 ] || return 1


        #
        # QMI control port must exist.
        #

        [ -e "$QMI" ] || return 1


        #
        # ModemManager must see the modem.
        #
        # We deliberately do NOT check bearer/connection state.
        #
        # Therefore:
        #
        #       ifdown modem
        #
        # leaves RED off as long as the modem subsystem itself
        # remains healthy.
        #

        command -v mmcli >/dev/null 2>&1 || return 1

        local m_idx="$(mmcli -L 2>/dev/null | grep -m1 -o '/Modem/[0-9]\+' | cut -d/ -f3)"
        [ -n "$m_idx" ] || return 1

        # If modem is disabled (firstboot/SIM reset), auto-enable it so cellular connects automatically
        local m_state="$(mmcli -m "$m_idx" 2>/dev/null | grep -i 'state:' | head -n1 | awk '{print $NF}')"
        if [ "$m_state" = "disabled" ]; then
                logger -t modem-auto-enable "Modem $m_idx is in disabled state; automatically enabling..."
                mmcli -m "$m_idx" -e >/dev/null 2>&1 || true
        fi

        # On HMU05, lock band mask to LTE-only to eliminate 2G/3G IRAT gap RF tune crashes
        if [ "$IS_HMU05" = "1" ]; then
                local cur_bands="$(mmcli -m "$m_idx" --output-keyvalue 2>/dev/null | awk -F': ' '/modem.generic.current-bands.value/ {print $2}')"
                if echo "$cur_bands" | grep -qi -E 'utran|geran'; then
                        logger -t modem-band-lock "Locking HMU05 bands to LTE-only to eliminate 2G/3G IRAT measurement gap crashes..."
                        mmcli -m "$m_idx" --set-current-bands="eutran-1|eutran-3|eutran-5|eutran-8" >/dev/null 2>&1 || true
                fi
        fi

        return 0
}


#
# Fail-safe startup state.
#
# DTS also has red:power ON during early boot.
# Once this monitor starts, blink RED until the modem
# subsystem has been confirmed healthy.
#

set_red 1


LAST=""

# Keepalive and Safe Recovery Architecture parameters
KEEPALIVE_INTERVAL=45
KEEPALIVE_TIMER=0
FAIL_COUNT=0
MAX_FAILS=4
COOLDOWN_SECS=90
LAST_RECOVERY=0
LOCKFILE="/var/run/modem-recovery.lock"

safe_reconnect_modem() {
        local reason="$1"
        local now="$(date +%s)"

        if [ $((now - LAST_RECOVERY)) -lt "$COOLDOWN_SECS" ]; then
                logger -t modem-recovery "Recovery skipped: within cooldown period ($((now - LAST_RECOVERY))s < ${COOLDOWN_SECS}s)"
                return 0
        fi

        if [ -f "$LOCKFILE" ]; then
                logger -t modem-recovery "Recovery already in progress (lock exists); skipping."
                return 0
        fi

        touch "$LOCKFILE"
        logger -t modem-recovery "Triggering safe synchronized modem reconnection (reason: $reason)..."

        # 1. Asynchronously request netifd teardown
        ifdown modem

        # 2. Synchronously wait for netifd to complete teardown
        local i=0
        while [ "$i" -lt 15 ]; do
                local status="$(ubus call network.interface.modem status 2>/dev/null)"
                local is_up="$(echo "$status" | jsonfilter -e '@.up' 2>/dev/null)"
                local is_pending="$(echo "$status" | jsonfilter -e '@.pending' 2>/dev/null)"
                if [ "$is_up" = "false" ] && [ "$is_pending" = "false" ]; then
                        break
                fi
                sleep 1
                i=$((i + 1))
        done

        # 3. Settling gap to allow QMI and ModemManager to clear session
        sleep 2

        # 4. Bring up interface cleanly
        ifup modem
        logger -t modem-recovery "Modem ifup dispatched cleanly after synchronized teardown."

        rm -f "$LOCKFILE"
        LAST_RECOVERY="$(date +%s)"
        FAIL_COUNT=0
}


run_watchdog_cycle() {
        local iface_status="$(ubus call network.interface.modem status 2>/dev/null)"
        local iface_up="$(echo "$iface_status" | jsonfilter -e '@.up' 2>/dev/null)"

        if [ "$iface_up" = "true" ]; then
                KEEPALIVE_TIMER=$((KEEPALIVE_TIMER + CHECK_INTERVAL))

                # Check 3GPP packet service state
                local m_idx="$(mmcli -L 2>/dev/null | grep -m1 -o '/Modem/[0-9]\+' | cut -d/ -f3)"
                local ps_state=""
                if [ -n "$m_idx" ]; then
                        ps_state="$(mmcli -m "$m_idx" --output-keyvalue 2>/dev/null | awk -F': ' '/modem.3gpp.packet-service-state/ {print $2}' | tr -d ' \r\n')"
                fi

                if [ "$ps_state" = "detached" ]; then
                        FAIL_COUNT=$((FAIL_COUNT + 1))
                        if [ "$FAIL_COUNT" -ge "$MAX_FAILS" ]; then
                                safe_reconnect_modem "packet service detached"
                        fi
                elif [ "$FAIL_COUNT" -gt 0 ] || [ "$KEEPALIVE_TIMER" -ge "$KEEPALIVE_INTERVAL" ]; then
                        KEEPALIVE_TIMER=0
                        # Send lightweight 1-packet heartbeat to keep cell tower in RRC_CONNECTED
                        if ping -c 1 -W 2 -I wwan0 1.1.1.1 >/dev/null 2>&1 || ping -c 1 -W 2 -I wwan0 8.8.8.8 >/dev/null 2>&1; then
                                FAIL_COUNT=0
                        else
                                FAIL_COUNT=$((FAIL_COUNT + 1))
                                logger -t modem-keepalive "Keepalive ping failed ($FAIL_COUNT/$MAX_FAILS)"
                                if [ "$FAIL_COUNT" -ge "$MAX_FAILS" ]; then
                                        safe_reconnect_modem "ping heartbeat stalled"
                                fi
                        fi
                fi
        else
                # Interface is not up (e.g. user ran ifdown modem); reset state
                KEEPALIVE_TIMER=0
                FAIL_COUNT=0
        fi
}


while true; do

        if modem_healthy; then

                STATE="healthy"
                VALUE=0

        else

                STATE="failed"
                VALUE=1

        fi


        #
        # Only update the LED when the health state changes.
        #

        if [ "$STATE" != "$LAST" ]; then

                set_red "$VALUE"


                logger -t modem-led-monitor \
                        "modem health: $STATE"

                LAST="$STATE"
        fi


        #
        # Two-Pronged Keepalive & Safe Self-Healing Watchdog
        #
        if [ "$STATE" = "healthy" ]; then
                run_watchdog_cycle
        fi


        sleep "$CHECK_INTERVAL"

done
