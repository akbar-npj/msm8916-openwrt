#!/bin/sh
#
# sim-hotplug - detect a physical SIM swap and re-announce the card to the
#               baseband on the HMUF02-V5 (MSM8916).
#
# WHY THIS EXISTS
#   The HMUF02-V5 has NO AP-side SIM card-detect line.  GPIO114 (sim_hotplug)
#   is an OUTPUT: the AP drives it LOW ("card present") and toggles it to make
#   the baseband re-read the card.  GPIO119 (esim1_en) is the SIM rail enable.
#
#   ModemManager cannot be used as the detector: its qcom-soc plugin reads the
#   SIM once at modem enable and then CACHES it.  After the card is pulled,
#   mmcli still reports the old IMSI/ICCID (the SIM object never disappears),
#   and "modem.generic.state" only degrades to "searching".
#
#   The one reliable AP-visible presence signal is the modem's own UIM card
#   status (qmicli --uim-get-card-status).  While the card is out - or while
#   the baseband has not re-read a card that is physically back in - the
#   firmware answers "error: possibly-removed (6)" on stderr.
#
# THE CRITICAL ASYMMETRY (measured 2026-10-19)
#   The modem firmware has feature_support_hotswap DISABLED.  It notices a
#   REMOVAL on its own (the card stops answering), but it never notices an
#   INSERTION: with the card physically inserted, UIM kept answering
#   "possibly-removed" for minutes.  One sim_hotplug pulse made it report
#   "present" in <5 s and the modem registered ~10 s later.
#
#   Therefore this service must PULSE WHILE THE CARD IS BELIEVED ABSENT - that
#   pulse is the only way an inserted card is ever discovered.  Conversely it
#   must NOT pulse once UIM reports present: pulsing a working card keeps the
#   baseband from settling on the network (observed: modem stuck "searching"
#   while the service pulsed every 5 s).
#
# DETECTION COST / LATENCY
#   UIM polling is GATED so the QMI bus is almost never touched:
#     * card present + modem registered -> one check per idle_interval (60 s)
#     * card present + modem searching  -> one check per active_interval (5 s)
#     * card absent                      -> pulse + settle + check every
#                                          absent_interval (6 s)
#   "searching" on its own is NEVER treated as evidence of a swap (train /
#   car / reselection) - only the UIM answer decides.
#
#   A pull drops the modem out of "registered" within ~1 s, so removal is
#   caught by the 5 s active check (typ. 5-7 s, worst ~10 s).  An insertion is
#   only seen when we pulse, so it is caught within one absent cycle
#   (6 s wait + 4 s settle, typ. 6-10 s).  A swap of only 3-5 s is still
#   caught: the card is electrically gone, the modem notices immediately, and
#   it does NOT re-read on reinsertion - so it stays unregistered until our
#   next pulse.  The only invisible case is a swap shorter than the modem's
#   own removal debounce, which leaves the modem on its cached card; nothing
#   on the AP side can observe that.
#
# QMI HYGIENE
#   * Always --device-open-proxy: share /dev/wwan0qmi0 with ModemManager
#     through qmi-proxy.  A direct open steals the port from MM.
#   * One qmicli process at a time (busybox flock, no -w) and always under
#     'timeout'.  Concurrent or long-lived clients exhaust the modem's
#     client-ID pool and leave ModemManager failed with 'ClientIdsExhausted'.
#   * Never reset the modem from here (mmcli -r / SSR): it re-enumerates MM and
#     can leave it 'failed'.  The pulse alone is the validated trigger.
#
# Usage:
#   sim-hotplug start     run the poll loop (procd)
#   sim-hotplug rescan    force one re-announce (manual test)
#

SIM_LED="/sys/class/leds/sim_hotplug/brightness"
QMI_DEV="/dev/wwan0qmi0"
LOCK="/var/lock/sim-hotplug.lock"
BEARER_LOCK="/var/lock/modem-bearer.lock"

. /lib/functions.sh

config_load sim-hotplug
config_get_bool ENABLED general enabled 1
config_get IDLE_INTERVAL   general idle_interval 60
config_get ACTIVE_INTERVAL general active_interval 10
config_get ABSENT_INTERVAL general absent_interval 20
config_get PULSE_MS        general pulse_ms 300

# Time for the baseband to re-initialise the card after a pulse.  While the
# re-init runs, UIM still answers "possibly-removed", so querying too early
# just re-arms the pulse loop.
SETTLE=4

log() { logger -t sim-hotplug "$*"; }

pulse_sim() {
    [ -w "$SIM_LED" ] || return 1
    echo 255 > "$SIM_LED" 2>/dev/null
    if command -v usleep >/dev/null 2>&1; then
        usleep $((PULSE_MS * 1000))
    else
        sleep 1
    fi
    echo 0 > "$SIM_LED" 2>/dev/null
    return 0
}

modem_index() {
    mmcli -L 2>/dev/null | sed -n 's|.*/Modem/\([0-9][0-9]*\).*|\1|p' | head -n1
}

# Echo the ModemManager state, e.g. registered / connected / searching / enabled.
modem_state() {
    [ -n "$MODEM_IDX" ] || MODEM_IDX=$(modem_index)
    [ -n "$MODEM_IDX" ] || { echo none; return; }
    st=$(timeout 6 mmcli -m "$MODEM_IDX" -K 2>/dev/null |
         awk '/^modem[.]generic[.]state /{sub(/^[^:]*:[[:space:]]*/, ""); print; exit}')
    if [ -z "$st" ]; then
        MODEM_IDX=$(modem_index)
        echo unknown
        return
    fi
    echo "$st"
}

# Echo: present | absent | exhaust | unknown
uim_state() {
    out=$(timeout 12 flock "$LOCK" qmicli --device-open-proxy -d "$QMI_DEV" \
          --uim-get-card-status 2>&1)
    case "$out" in
        *ClientIdsExhausted*|*client-ids-exhausted*) echo exhaust; return ;;
        *possibly-removed*)                          echo absent;  return ;;
    esac
    card=$(printf '%s\n' "$out" | awk -F"'" '/Card state:/ {print $2; exit}')
    case "$card" in
        present) echo present ;;
        absent)  echo absent  ;;
        *)       echo unknown ;;
    esac
}

# Wait for the modem to register after the card has been re-read.
wait_register() {
    local i=0 st
    while [ "$i" -lt 12 ]; do
        st=$(modem_state)
        case "$st" in
            registered|connected|connecting) return 0 ;;
        esac
        sleep 5
        i=$((i + 1))
    done
    return 1
}

# Force ModemManager to re-read the SIM.  MM caches the SIM object across a
# physical swap, so without this a DIFFERENT card would keep the old IMSI and
# qcom-carrier-autocfg would not re-provision the APN.  Disable/enable is the
# lightest way to make the qcom-soc plugin reload it (~10 s, no SSR).
refresh_modem() {
    [ -n "$MODEM_IDX" ] || MODEM_IDX=$(modem_index)
    [ -n "$MODEM_IDX" ] || return 1
    log "re-reading the SIM through ModemManager"
    timeout 30 mmcli -m "$MODEM_IDX" -d >/dev/null 2>&1
    sleep 3
    timeout 30 mmcli -m "$MODEM_IDX" -e >/dev/null 2>&1
    MODEM_IDX=$(modem_index)
    [ -n "$MODEM_IDX" ] || return 1
    # never leave the modem disabled
    [ "$(modem_state)" = "none" ] && timeout 30 mmcli -m "$MODEM_IDX" -e >/dev/null 2>&1
    return 0
}

# Bring the data bearer up after a swap.  Reuses the bearer lock so we never
# race modem-bearer-watchdog / qcom-carrier-autocfg.
bring_up_bearer() {
    log "bringing the modem bearer up"
    ( timeout 40 flock "$BEARER_LOCK" ifup modem ) >/dev/null 2>&1
}

poll_loop() {
	local removed=0 last now st u iv miss=0 err=0

	# Without a writable sim_hotplug line, hot-swap can never make the modem
	# re-read the slot, so the absent-reannounce loop would spin forever with
	# no way to recover an insertion.  The init script already skips the
	# service in that case; this guards the direct `sim-hotplug start` path.
	if [ ! -w "$SIM_LED" ]; then
		log "no writable sim_hotplug line on this board - hot-swap disabled, monitoring only"
		while true; do
			sleep "$IDLE_INTERVAL"
			uim_state >/dev/null 2>&1
		done
	fi

	# Let ModemManager finish enumerating before the first query.
	sleep 10

    u=$(uim_state)
    case "$u" in
        absent)
            removed=1
            log "no SIM visible to the baseband - will re-announce until it appears"
            ;;
        present)
            log "SIM present at startup"
            ;;
        *)
            log "SIM state unknown at startup ($u)"
            ;;
    esac
    last=$(date +%s)

    while true; do
        if [ "$removed" -eq 1 ]; then
            # Card believed absent: re-announce, then see whether the baseband
            # now sees an inserted card.  This is the ONLY way an insertion is
            # ever noticed on this firmware.
            # Pulse straight away: while the card is out this is harmless, and
            # it means an insertion that happens during this cycle is caught by
            # the NEXT pulse, one absent_interval later.
            pulse_sim
            # The pulse makes the baseband re-initialise the card; while that
            # is in progress UIM answers "possibly-removed" again.
            sleep "$SETTLE"
            u=$(uim_state)
            last=$(date +%s)
            case "$u" in
                present)
                    log "SIM detected after re-announce"
                    removed=0
                    if wait_register; then
                        log "modem registered"
                        refresh_modem
                        wait_register && log "modem re-registered after SIM re-read"
                        bring_up_bearer
                    else
                        log "modem not registered yet - continuing to monitor"
                    fi
                    ;;
                absent)
                    miss=$((miss + 1))
                    if [ $((miss % 3)) -eq 0 ]; then
                        log "card still not visible after re-announce ($miss)"
                    fi
                    ;;
                unknown)
                    miss=$((miss + 1))
                    ;;
                exhaust)
                    log "QMI client IDs exhausted - backing off 60 s"
                    sleep 60
                    last=$(date +%s)
                    ;;
            esac
            [ "$removed" -eq 1 ] && sleep "$ABSENT_INTERVAL"
            continue
        fi

        st=$(modem_state)
        case "$st" in
            registered|connected|connecting) iv=$IDLE_INTERVAL ;;
            *)                               iv=$ACTIVE_INTERVAL ;;
        esac

        now=$(date +%s)
        if [ $((now - last)) -ge "$iv" ]; then
            u=$(uim_state)
            last=$now
            case "$u" in
                absent)
                    log "SIM removed (UIM absent)"
                    removed=1
                    err=0
                    ;;
                unknown)
                    # UIM answered an error (e.g. voltage-mismatch /
                    # UimUninitialized): the baseband could not read the
                    # card.  While the modem is out of service this is the
                    # same situation as a removal - force a re-announce so
                    # the baseband re-initialises the slot.  Only do this
                    # while NOT registered (a transient QMI error on a
                    # healthy link must not clobber it), and require two
                    # consecutive checks (~10 s) to avoid flapping on a blip.
                    if [ "$st" != "registered" ] && [ "$st" != "connected" ] && [ "$st" != "connecting" ]; then
                        err=$((err + 1))
                        if [ "$err" -ge 2 ]; then
                            log "UIM error/uninitialized while searching - forcing re-announce"
                            removed=1
                            err=0
                        fi
                    else
                        err=0
                    fi
                    ;;
                exhaust)
                    log "QMI client IDs exhausted - backing off 60 s"
                    sleep 60
                    last=$(date +%s)
                    ;;
            esac
        fi
        # React quickly while the modem is out of service (a SIM pull shows up
        # as registered -> searching); stay lazy when everything is healthy.
        case "$st" in
            registered|connected|connecting) sleep 5 ;;
            *)                               sleep 2 ;;
        esac
    done
}

arg="$1"
[ -z "$arg" ] && arg=start
case "$arg" in
    rescan)
        pulse_sim && log "manual re-announce (rescan)"
        ;;
    start)
        [ "$ENABLED" -eq 1 ] && poll_loop
        ;;
    -h|--help)
        cat <<'USAGE'
Usage: sim-hotplug {start|rescan} | -h|--help

Detect a physical SIM swap and re-announce the card to the baseband.

The HMUF02-V5 has no AP-side card-detect line and the modem firmware has
hotswap disabled: it notices a REMOVAL but never an INSERTION.  This service
watches the modem's UIM card status and, while the card is believed absent,
pulses the sim_hotplug line (GPIO114) so the baseband re-reads an inserted
card.  It then waits for registration, makes ModemManager re-read the SIM
(so a different card's IMSI/APN is picked up) and brings the bearer up.

Commands:
  start     Run the poll loop (used by procd)
  rescan    Force one re-announce now (manual recovery)

Options:
  -h, --help   Show this help and exit

Configuration (uci, /etc/config/sim-hotplug):
  sim-hotplug.general.enabled          1
  sim-hotplug.general.idle_interval    60   seconds between checks while registered
  sim-hotplug.general.active_interval  5    seconds between checks while searching
  sim-hotplug.general.absent_interval  6    seconds between re-announce cycles
  sim-hotplug.general.pulse_ms         300  sim_hotplug pulse width

Service:  /etc/init.d/sim-hotplug {start|stop|restart|status|rescan}
Log:      logread -e sim-hotplug
USAGE
        exit 0
        ;;
esac
