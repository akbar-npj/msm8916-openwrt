#!/bin/sh

#
# MSM8916 first-boot configuration
#

###############################################################################
# Configure ModemManager WAN interface
###############################################################################

uci set network.modem=interface
uci set network.modem.proto='modemmanager'
uci set network.modem.device='qcom-soc'
uci set network.modem.auth='none'
uci set network.modem.apn='internet'
uci set network.modem.allowedmode='4g|3g'
uci set network.modem.preferredmode='4g'
uci set network.modem.ifname='wwan0'

uci del_list firewall.@zone[1].network='modem'
uci add_list firewall.@zone[1].network='modem'

###############################################################################
# MSM8916 devices do not expose an eth0 interface.
###############################################################################

uci -q del_list network.@device[0].ports='eth0'

sed -i \
    's/"device": "eth0"/"device": "br-lan"/g' \
    /etc/board.json

###############################################################################
# Remove the automatically generated target package feed.
#
# msm89xx is not an official OpenWrt target, therefore:
#
#   https://downloads.openwrt.org/releases/<version>/targets/msm89xx/msm8916/
#
# does not exist.
#
# The generic package feeds remain intact.
#
###############################################################################

sed -i \
    '\|/targets/msm89xx/msm8916/packages|d' \
    /etc/apk/repositories.d/distfeeds.list \
    2>/dev/null || true

###############################################################################

###############################################################################
# Enable Wi-Fi by default
###############################################################################

uci -q set wireless.radio0.disabled='0'
uci -q set wireless.default_radio0.disabled='0'

###############################################################################

uci commit

exit 0
