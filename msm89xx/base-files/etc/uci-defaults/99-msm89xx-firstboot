#!/bin/sh

#
# MSM8916 first-boot configuration
#

###############################################################################
# Configure ModemManager WAN interface
###############################################################################

uci -q batch << 'EOF'
set network.modem=interface
set network.modem.proto='modemmanager'
set network.modem.device='qcom-soc'
set network.modem.auth='none'
set network.modem.apn='jionet'
set network.modem.allowedmode='4g'
set network.modem.preferredmode='none'
set network.modem.ifname='wwan0'
EOF

uci -q del_list firewall.@zone[1].network='modem' 2>/dev/null || true
uci add_list firewall.@zone[1].network='modem'

###############################################################################
# Apply device-specific No-Sleep patch on HMU05 if present
###############################################################################

if [ -x /usr/sbin/hmu05-patch-modem ]; then
    /usr/sbin/hmu05-patch-modem /lib/firmware
fi

###############################################################################
# MSM8916 devices do not expose an eth0 interface.
###############################################################################

uci -q del_list network.@device[0].ports='eth0' 2>/dev/null || true
uci -q del_list network.@device[0].ports='usb0' 2>/dev/null || true
uci add_list network.@device[0].ports='usb0'

sed -i \
    's/"device": "eth0"/"device": "br-lan"/g' \
    /etc/board.json

###############################################################################
# Remove the automatically generated target package feed.
#
# msm89xx is not an official OpenWrt target, therefore:
#
#   https://downloads.openwrt.org/releases/<version>/targets/msm89xx/msm8916/
#
# does not exist.
#
# The generic package feeds remain intact.
#
###############################################################################

sed -i \
    -e '\|/targets/msm89xx/msm8916/packages|d' \
    -e '\|/smsmanager/packages.adb|d' \
    /etc/apk/repositories.d/distfeeds.list \
    2>/dev/null || true

cat << 'EOF' > /etc/apk/repositories.d/customfeeds.list
https://akbar-npj.github.io/msm8916-openwrt/releases/25.12.5/targets/msm89xx/msm8916/packages/packages.adb
https://akbar-npj.github.io/msm8916-openwrt/releases/25.12.5/packages/aarch64_generic/base/packages.adb
https://akbar-npj.github.io/msm8916-openwrt/releases/25.12.5/packages/aarch64_generic/packages/packages.adb
EOF

###############################################################################
# Configure LAN IP Subnet (192.168.8.1 to prevent home Wi-Fi 192.168.1.x conflict)
###############################################################################

uci -q batch << 'EOF'
set network.lan.ipaddr='192.168.8.1'
set network.lan.netmask='255.255.255.0'
EOF

###############################################################################
# Configure USB Gadget (CDC NCM Ethernet)
###############################################################################

uci -q batch << 'EOF'
set usbgadget.usb=device
set usbgadget.usb.enabled='1'
set usbgadget.usb.gadget_name='g1'
set usbgadget.usb.vendor_id='0x1d6b'
set usbgadget.usb.product_id='0x0104'
set usbgadget.usb.device_version='0x0100'
set usbgadget.usb.manufacturer='Linux'
set usbgadget.usb.product='USB Gadget'
set usbgadget.ncm=function
set usbgadget.ncm.enabled='1'
set usbgadget.ncm.description='CDC NCM ethernet (Best Performance)'
set usbgadget.acm=function
set usbgadget.acm.enabled='1'
set usbgadget.acm.description='Serial console'
set usbgadget.acm.shell='1'
EOF

uci commit

exit 0
