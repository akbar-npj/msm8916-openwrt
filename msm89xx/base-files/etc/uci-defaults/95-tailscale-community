#!/bin/sh
# BOARDS: hmuf02v5, jz02, mf800b, mifib-v12, uf02, uf896, ufi001b, ufi003, uz801
#
# Drop the vendored Tailscale LuCI app after the switch to the luci feed's
# luci-app-tailscale-community.
#
# A config-preserving sysupgrade keeps the overlay's package database and
# /etc/apk/world, so on an upgraded unit the old package would survive next to
# the new one: two apps registered on admin/services/tailscale, and its
# renamed /etc/init.d/tailscale would keep shadowing the feed package's own
# init script.  Remove it once.
#
# /etc/config/tailscale is deliberately NOT touched.  It belongs to the feed's
# tailscale package (it is that package's conffile), it holds the node
# settings, and the community app reads the same `settings` section.  The old
# app's extra options (enabled, config_path, accept_dns, ...) are ignored by
# both the app and the init script.  The login state survives as well: the old
# init stored it in /etc/tailscale/tailscaled.state, which is the feed init's
# default --state path.
#
# The shadowed /etc/init.d/tailscale is not removed here: the postinst rename
# left it as an overlay copy of an image file, and apk-overlay-heal already
# drops those at preinit.  Deleting it blindly would whiteout the feed's own
# script on a unit that never had the vendored app.

[ -f /etc/apk/world ] || exit 0
grep -qx 'luci-app-tailscale' /etc/apk/world || exit 0

# World first: leaving the entry behind would make the next
# `apk add $(cat /etc/apk/world)` (or an upgrade) pull the old app back.
sed -i '/^luci-app-tailscale$/d' /etc/apk/world

if ! apk del luci-app-tailscale >/dev/null 2>&1; then
	logger -t tailscale-community "could not uninstall luci-app-tailscale; it is out of the world, remove it by hand"
fi

# The package's file list names tailscale.luci; the postinst had renamed it,
# so the renamed copies are not covered by the uninstall.
rm -f /etc/init.d/tailscale.luci
for link in /etc/rc.d/*tailscale.luci; do
	[ -e "$link" ] || [ -L "$link" ] || continue
	rm -f "$link"
done

# The old script was START=90, the feed's is START=80.  A preserved overlay
# keeps the old S90 link, and with the image's S80 link also present the
# service would be started twice (two tailscaled instances).
rm -f /etc/rc.d/S90tailscale

rm -rf /tmp/luci-indexcache* /tmp/luci-modulecache

exit 0
