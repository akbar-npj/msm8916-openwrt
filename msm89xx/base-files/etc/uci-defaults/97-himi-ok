#!/bin/sh
# Enable the HiMI_OK guard on HMU05 boards (ledger §112.169).
# The modem's RF task memcmp()s NV item 2500 against "HiMI_OK"; the item is
# cleared at every modem boot, so /usr/sbin/himi-ok-guard rewrites it after each
# boot (cold + every SSR/crash restart) and the ~900 s deadline never arms.

. /lib/functions.sh 2>/dev/null

case "$(board_name 2>/dev/null)" in
	*hmu05*)
		[ -x /etc/init.d/himi-ok ] && /etc/init.d/himi-ok enable
		;;
esac

exit 0
