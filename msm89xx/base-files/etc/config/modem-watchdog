config watchdog 'general'
	option enabled '1'
	# Android's DcTracker data-stall alarm defaults: 60000 ms aggressive,
	# 180000 ms non-aggressive.  We use the aggressive default.  The previous
	# 15 s / 2 s settings caused the watchdog to declare a stall on ordinary
	# idle gaps and drive the Stage-1/2/3 recovery ladder unnecessarily --
	# Stage 2 tears the interface down, which used to hit the bam_dmux
	# TX-slot/pm-resume race and wedge RTNL for the rest of the boot.
	option stall_timeout '60'
	option check_interval '10'
	option cooldown_seconds '60'

config keepalive 'keepalive'
	# DISABLED: stock Android has no DNS keepalive.  It relies on the modem's
	# own DRX/paging and on DcTracker's indication-driven dormancy state
	# machine.  The previous interval=2 sent a DNS query -- i.e. a modem TX
	# that resets the BAM-DMUX autosuspend timer -- every 2 seconds while the
	# link was idle.  That is the opposite of Android's behaviour, which
	# explicitly *quiesces* AP-side polling while the bearer is dormant
	# (DcTrackerBase stopNetStatPoll() + stopDataStallAlarm()).
	option enabled '0'
	option interval '60'
	option target 'openwrt.org'

config recovery 'recovery'
	# Stage 3 of the stall ladder: restart the modem subsystem (stop -> start
	# remoteproc0).  Android parity -- stock bam_dmux.c calls
	# subsystem_restart("modem") from every A2 handshake-timeout site.  Set to
	# '0' to keep the modem state frozen for post-mortem analysis instead.
	option ssr_enabled '1'

	# A netifd interface still down this long after a rebuild is STUCK, not
	# transient (the normal post-SSR rebuild is ~16 s).  Re-drive it: `up` +
	# re-arm the proto's `available` flag.
	option bearer_down_recover_secs '30'

	# Post-fatal zombie nudge (ledger §112.161, 2026-10-06).  A modem fatal is
	# followed by a crash-recovery restart that can leave the modem in a
	# low-power ZOMBIE: DMS `shutting-down`, NAS `not-registered-searching`,
	# ModemManager "no modem object".  A modem/SSR restart does NOT clear it, but
	# `qmicli --dms-set-operating-mode=online` does (measured, n = 2).  After this
	# many seconds with the bearer down and NO modem object, the watchdog attempts
	# that nudge (cooldown-bounded).  Set to 0 to disable.  ⚠ Recovers the SHALLOW
	# zombie only; the DEEP one (RF `none`) does not respond.
	option zombie_nudge_secs '60'

	# NOTE: the pre-emptive SSR (preemptive_ssr_enabled / preemptive_ssr_interval)
	# and the himi_ok_* keys are GONE.  The pre-emptive SSR existed only to defer
	# the ~900 s lte_ml1 fatal; the root-cause fix is the HMU05-only HiMI_OK guard
	# (a separate, HMU05-gated service).
	#
	# The A2 pin now lives in the DRIVER (kernel patch 848).  The HMU05 board
	# DTS sets "qcom,a2-pin" on &bam_dmux, so bam_dmux_probe() calls
	# pm_runtime_forbid() (== power/control=on) and the A2 never powers down.
	# There is no userspace holder any more; the runtime knob is the module
	# parameter /sys/module/qcom_bam_dmux/parameters/a2_pin (1 = pinned, 0 =
	# normal runtime suspend), which is how an A/B soak flips it.  Measured
	# 2026-10-07: with the A2 collapsing (`control=auto`) a2_power.c:1189 fires
	# every ~65-70 s once a data bearer is up (wwan0 flaps); pinned, there are
	# no a2_power fatals.  §112.170's "a2_pin=0 is safe" was drawn without data
	# traffic.
