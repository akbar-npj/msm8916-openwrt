#!/bin/sh
# JZ02 only: the usb0 gadget is created by /etc/init.d/usb-gadget at S99,
# after the network service (S20).  bridge_empty=1 lets br-lan come up
# without ports; attach usb0 when it appears so the LAN is reachable after
# every boot.  Other boards bring usb0 up before network and are untouched.
grep -q "jz02,generic" /proc/device-tree/compatible 2>/dev/null || exit 0
[ "$ACTION" = "add" ] && [ "$INTERFACE" = "usb0" ] || exit 0
[ -d /sys/class/net/br-lan ] || exit 0
ip link set usb0 master br-lan 2>/dev/null
