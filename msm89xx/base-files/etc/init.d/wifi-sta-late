#!/bin/sh /etc/rc.common
# Late STA bring-up for concurrent AP+STA on wcn36xx.
#
# The STA is NOT a wifi-iface: netifd restarts the phy when the wireless config
# changes, and a phy restart with a managed iface present crashes the WCNSS
# firmware (Data Abort 0x8b6b301c).  This service waits for the AP to be
# ENABLED and then creates the STA vif with iw -- the verified-safe path.
#
# Two instances, both supervised by procd:
#   sta  - creates the vif, then runs wpa_supplicant in the foreground
#   dhcp - waits for association, then runs udhcpc in the foreground
#
# CAVEAT: "wifi reload" (or saving wireless settings in LuCI) restarts the phy
# while the STA vif exists, which hits the same firmware bug.  Stop this service
# first, reload wifi, then start it again.

START=95
STOP=10
USE_PROCD=1

start_service() {
	config_load wifista
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || return 0

	procd_open_instance sta
	procd_set_param command /usr/sbin/wifi-sta-up sta
	# Restart if it dies; threshold 0 = never give up.
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	config_get_bool dhcp main dhcp 1
	if [ "$dhcp" = 1 ]; then
		procd_open_instance dhcp
		procd_set_param command /usr/sbin/wifi-sta-up dhcp
		procd_set_param respawn 3600 5 0
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance
	fi

	# Watches for a STA that stays down (upstream moved channel, vif lost, ...)
	# and recycles it through procd.
	procd_open_instance watchdog
	procd_set_param command /usr/sbin/wifi-sta-up watchdog
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	local i
	for i in $(iw dev 2>/dev/null | awk '$1 == "Interface" { print $2 }'); do
		case "$i" in
		phy*-sta0)
			iw dev "$i" del 2>/dev/null
			;;
		esac
	done
}

service_triggers() {
	# Save & Apply in LuCI commits /etc/config/wifista; the config.change event
	# then calls reload_service() below.  procd_add_reload_trigger() only works
	# from service_triggers() -- inside start_service() it is silently dropped.
	procd_add_reload_trigger "wifista"
}

reload_service() {
	# procd's default reload is a bare start(), which leaves the already-running
	# instances untouched -- a changed SSID/key would never take effect.
	restart
}
