#!/bin/sh /etc/rc.common
# JZ02 SIM-slot selector.
#
# The board has three SIM lines plus a re-announce pulse, exposed as gpio-leds
# with the stock Android names:
#   sim1_switch_gpio  GPIO22  embedded / solder SIM
#   sim2_switch_gpio  GPIO23  second SIM
#   sim3_switch_gpio  GPIO1   external slot
#   sim_hotdet_gpio   GPIO20  re-announce pulse
#
# Configure with:  uci set sim.slot=3 && uci commit sim
# (1 = embedded, 2 = second, 3 = external; default 3)
#
# BOARDS: jz02 (the three SIM switch lines exist only there)

START=20

# Every board installs S20sim-select; exit before touching uci elsewhere.
grep -q "jz02,generic" /proc/device-tree/compatible 2>/dev/null || exit 0

start() {
	local slot L
	slot="$(uci -q get sim.slot 2>/dev/null)"
	[ -n "$slot" ] || slot=3
	case "$slot" in
		1|2|3) ;;
		*) logger -t sim-select "invalid sim.slot '$slot' (expected 1, 2 or 3); not selecting"
		   return 1 ;;
	esac
	L=/sys/class/leds

	if [ ! -d "$L/sim_hotdet_gpio" ]; then
		logger -t sim-select "SIM switch GPIOs not present; skipping"
		return 0
	fi

	# Stock Android sequence: pulse hot-detect, select one line, release.
	echo 1 > "$L/sim_hotdet_gpio/brightness"
	sleep 1
	echo 0 > "$L/sim1_switch_gpio/brightness"
	echo 0 > "$L/sim2_switch_gpio/brightness"
	echo 0 > "$L/sim3_switch_gpio/brightness"
	case "$slot" in
		1) echo 1 > "$L/sim1_switch_gpio/brightness" ;;
		2) echo 1 > "$L/sim2_switch_gpio/brightness" ;;
		3) echo 1 > "$L/sim3_switch_gpio/brightness" ;;
	esac
	sleep 1
	echo 0 > "$L/sim_hotdet_gpio/brightness"

	logger -t sim-select "selected SIM slot $slot"
}

stop() {
	:
}
