#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
#
# himi-ok -- keep the HMU05 modem NV item 2500 == "HiMI_OK" so the RF task's
# imei memcmp passes and the ~900 s deadline never arms after a WARM modem
# restart.  See /usr/sbin/himi-ok-guard and ledger §112.165-§112.169.

START=97
STOP=10
USE_PROCD=1

start_service() {
	. /lib/functions.sh
	case "$(board_name)" in
		*hmu05*) ;;
		*) return 0 ;;
	esac
	procd_open_instance
	procd_set_param command /usr/sbin/himi-ok-guard
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
