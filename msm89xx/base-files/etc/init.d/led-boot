#!/bin/sh /etc/rc.common
# Early boot LED feedback (capacity-aware battery blink).
# Runs post-overlay (START=01) so it works when deployed via scp, unlike the
# preinit diag.sh path which runs from the squashfs. The battery-led-monitor
# (S96) overrides the blink with the steady state when it starts.
USE_PROCD=1
START=01
STOP=10

start_service() {
    procd_open_instance
    procd_set_param command /sbin/led-boot
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    :
}
