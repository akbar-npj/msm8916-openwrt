#!/bin/sh /etc/rc.common
# /etc/init.d/modem-keepalive
# Qualcomm MSM8916 Pure-Software Cellular Keepalive Service

START=95
STOP=10

USE_PROCD=1
PROG=/usr/sbin/modem-keepalive

start_service() {
	local enabled
	config_load modem-keepalive 2>/dev/null || return 0
	config_get_bool enabled general enabled 1
	[ "$enabled" -eq 1 ] || return 0

	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	killall modem-keepalive 2>/dev/null || true
}
