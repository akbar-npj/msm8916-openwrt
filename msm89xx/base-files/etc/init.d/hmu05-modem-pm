#!/bin/sh /etc/rc.common

START=96

boot() {
	start
}

start() {
	. /lib/functions.sh
	local board="$(board_name)"
	case "$board" in
		*hmu05*)
			;;
		*)
			return 0
			;;
	esac

	logger -t hmu05-modem-pm "HMU05 runtime PM: locking control=on and disabling autosuspend (stock Android parity)"
	local bctrl="/sys/devices/platform/soc@0/4080000.remoteproc/4080000.remoteproc:bam-dmux/power/control"
	local bdelay="/sys/devices/platform/soc@0/4080000.remoteproc/4080000.remoteproc:bam-dmux/power/autosuspend_delay_ms"
	[ -f "$bctrl" ] && echo on > "$bctrl" 2>/dev/null || true
	[ -f "$bdelay" ] && echo -1 > "$bdelay" 2>/dev/null || true
}
