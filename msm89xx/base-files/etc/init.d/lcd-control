#!/bin/sh /etc/rc.common
# BOARDS: mifid
# lcd-control - LCD idle blanking and power-button toggle (HM-MIFIB-V18).
# The sysfs gate in start_service() keeps this inert on every other board.

USE_PROCD=1
START=95
STOP=10

start_service() {
	. /lib/functions.sh
	config_load lcd-control
	config_get_bool enabled general enabled 1
	[ "$enabled" -eq 0 ] && return 0

	[ -w /sys/class/backlight/backlight-lcd/brightness ] || {
		logger -t lcd-control "no backlight-lcd on this board - disabled"
		return 0
	}

	procd_open_instance
	procd_set_param command /usr/sbin/lcd-control start
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

extra_command status "Print LCD state and idle timer"
status() {
	/usr/sbin/lcd-control status
}
