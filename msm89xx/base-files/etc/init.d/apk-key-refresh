#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
#
# apk-key-refresh -- keep the custom-feed signing key in sync with the
# canonical key published at a stable URL.  See /usr/sbin/apk-key-refresh.

START=98
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/apk-key-refresh
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
