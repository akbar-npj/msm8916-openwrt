#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
#
# modem-a2-hold -- hold the AP's A2 power-control vote SET so the modem's A2
# never powers down (prevents the `a2_power.c:1189` fatal).  See
# /usr/sbin/modem-a2-hold and ledger 2026-10-07.

START=98
STOP=10
USE_PROCD=1

start_service() {
	. /lib/functions.sh
	case "$(board_name)" in
		*hmu05*) ;;
		*) return 0 ;;
	esac
	procd_open_instance
	procd_set_param command /usr/sbin/modem-a2-hold
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
