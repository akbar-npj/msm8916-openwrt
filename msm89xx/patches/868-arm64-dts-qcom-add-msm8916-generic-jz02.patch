--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/msm8916-generic-jz02.dts
@@ -0,0 +1,240 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * JZ02 — generic 3-SIM battery MiFi, Qualcomm MSM8916.
+ *
+ * Hardware facts recovered from the stock Android 4.4.4 firmware
+ * (eng.richal.20250520) on 2026-11-03:
+ *   - stock DTB: arch/arm64/boot/dts/qcom/msm8916-generic-jz02.dts
+ *     (the vendor ships the plain "MSM 8916 MTP" DTB, board-id <0x08 0x00>)
+ *   - GPIO map read live from /sys/kernel/debug/gpio and confirmed against
+ *     the stock DTB's /soc/gpio-leds and /soc/gpio_keys nodes
+ *   - SIM switch semantics documented at https://softs.im/jz02/
+ *
+ * SIM slots (stock Android names, kept verbatim so userspace can drive them):
+ *   sim1_switch_gpio  GPIO22  embedded / solder SIM
+ *   sim2_switch_gpio  GPIO23  second SIM
+ *   sim3_switch_gpio  GPIO1   external slot
+ *   sim_hotdet_gpio   GPIO20  re-announce pulse
+ *
+ * To select a slot: pulse sim_hotdet high, set exactly one switch high,
+ * wait, drop sim_hotdet.  See base-files/etc/init.d/sim-select.
+ */
+
+/dts-v1/;
+
+#include "msm8916-ufi.dtsi"
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/leds/common.h>
+
+/ {
+	model = "JZ02 4G LTE MiFi";
+	compatible = "jz02,generic", "qcom,msm8916";
+
+	/*
+	 * 2100 mAh 4.35 V LiPo cell, per the pack label (505060AR).  The stock
+	 * Android DT carries a generic "palladium_1500mah" profile (4.2 V /
+	 * 1500 mAh) that does not match the hardware; the gauge then reports
+	 * an over-voltage condition.  Match the real cell instead.
+	 *
+	 * voltage-min-design-microvolt is the stock qcom,v-cutoff-uv.  No
+	 * ocv-capacity-table: pm8916_bms_vm exposes no CAPACITY property and
+	 * reads none.
+	 */
+	battery: battery {
+		compatible = "simple-battery";
+		device-chemistry = "lithium-ion-polymer";
+
+		voltage-min-design-microvolt = <3350000>;
+		voltage-max-design-microvolt = <4350000>;
+		charge-full-design-microamp-hours = <2100000>;
+
+		constant-charge-current-max-microamp = <1000000>;
+		constant-charge-voltage-max-microvolt = <4350000>;
+	};
+};
+
+/* Persistent kernel log (ramoops) — same region as every other board. */
+&reserved_memory {
+	ramoops@8db00000 {
+		compatible = "ramoops";
+		reg = <0x0 0x8db00000 0x0 0x00100000>;
+		record-size = <0x00040000>;
+		console-size = <0x00040000>;
+		pmsg-size = <0x00040000>;
+		ecc-size = <16>;
+	};
+};
+
+/*
+ * Status LEDs, mapped by physically toggling each GPIO on the board
+ * (2026-11-03).  The stock Android labels are misleading; the real
+ * populated lamps are:
+ *
+ *   network  green  gpio11    red  gpio31    yellow  gpio9
+ *   wi-fi    green  gpio120   red  gpio6
+ *   battery  green  gpio8     red  gpio10
+ *
+ * Unpopulated in the stock DTB: gpio7 (hidden, not visible), gpio36,
+ * gpio117, gpio119, gpio121.
+ *
+ * The monitor scripts pick LEDs by name, so these names are what
+ * modem-led-monitor (red:wan/green:wan), wifi-led-monitor
+ * (green:wlan/red:wlan) and battery-led-monitor (green:bat/red:bat)
+ * expect.  The scripts set the timer triggers at runtime; the DTS
+ * starts with no trigger.
+ */
+&{/leds} {
+	/delete-node/ led-r;
+	/delete-node/ led-g;
+	/delete-node/ led-b;
+
+	led-wan-green {
+		function = LED_FUNCTION_WAN;
+		color = <LED_COLOR_ID_GREEN>;
+		gpios = <&tlmm 11 GPIO_ACTIVE_HIGH>;
+		default-state = "off";
+		retain-state-suspended;
+	};
+
+	led-wan-red {
+		function = LED_FUNCTION_WAN;
+		color = <LED_COLOR_ID_RED>;
+		gpios = <&tlmm 31 GPIO_ACTIVE_HIGH>;
+		default-state = "off";
+		retain-state-suspended;
+	};
+
+	led-wan-yellow {
+		label = "yellow:wan";
+		gpios = <&tlmm 9 GPIO_ACTIVE_HIGH>;
+		default-state = "off";
+		retain-state-suspended;
+	};
+
+	led-wlan-green {
+		function = LED_FUNCTION_WLAN;
+		color = <LED_COLOR_ID_GREEN>;
+		gpios = <&tlmm 120 GPIO_ACTIVE_HIGH>;
+		default-state = "off";
+		retain-state-suspended;
+	};
+
+	led-wlan-red {
+		function = LED_FUNCTION_WLAN;
+		color = <LED_COLOR_ID_RED>;
+		gpios = <&tlmm 6 GPIO_ACTIVE_HIGH>;
+		default-state = "off";
+		retain-state-suspended;
+	};
+
+	led-bat-green {
+		label = "green:bat";
+		gpios = <&tlmm 8 GPIO_ACTIVE_HIGH>;
+		default-state = "off";
+		retain-state-suspended;
+	};
+
+	led-bat-red {
+		label = "red:bat";
+		gpios = <&tlmm 10 GPIO_ACTIVE_HIGH>;
+		default-state = "off";
+		retain-state-suspended;
+	};
+
+	/*
+	 * SIM switch lines.  Keep the exact stock labels: userspace writes
+	 * /sys/class/leds/sim1_switch_gpio/brightness etc.
+	 */
+	led-sim1 {
+		label = "sim1_switch_gpio";
+		gpios = <&tlmm 22 GPIO_ACTIVE_HIGH>;
+		default-state = "off";
+		retain-state-suspended;
+	};
+	led-sim2 {
+		label = "sim2_switch_gpio";
+		gpios = <&tlmm 23 GPIO_ACTIVE_HIGH>;
+		default-state = "off";
+		retain-state-suspended;
+	};
+	led-sim3 {
+		label = "sim3_switch_gpio";
+		gpios = <&tlmm 1 GPIO_ACTIVE_HIGH>;
+		default-state = "off";
+		retain-state-suspended;
+	};
+	led-sim-hotdet {
+		label = "sim_hotdet_gpio";
+		gpios = <&tlmm 20 GPIO_ACTIVE_HIGH>;
+		default-state = "off";
+		retain-state-suspended;
+	};
+};
+
+&gpio_leds_default {
+	pins = "gpio1", "gpio6", "gpio8", "gpio9", "gpio10",
+	       "gpio11", "gpio20", "gpio22", "gpio23", "gpio31",
+	       "gpio120";
+};
+
+/*
+ * Buttons (from the stock DTB's /soc/gpio_keys):
+ *   key_f2  GPIO37  active-high  linux,code 60
+ *   key_f3  GPIO107 active-low   linux,code 61
+ *
+ * The physical "Reset" pinhole is one of these two.  Confirm on hardware
+ * with `evtest` / `getevent`; button_restart is mapped to key_f2 for now.
+ */
+&button_restart {
+	gpios = <&tlmm 37 GPIO_ACTIVE_HIGH>;
+};
+
+&button_default {
+	pins = "gpio37";
+	bias-pull-down;
+};
+
+/*
+ * PM8916 linear charger + VM-BMS.  The stock DT enables both
+ * (qcom,qpnp-linear-charger / qcom,qpnp-vm-bms) and reports
+ * battery-type "palladium_1500mah".
+ */
+&pm8916_usbin {
+	status = "disabled";
+};
+
+&pm8916_charger {
+	monitored-battery = <&battery>;
+
+	qcom,fast-charge-safe-voltage = <4350000>;
+	qcom,fast-charge-safe-current = <1000000>;
+
+	status = "okay";
+};
+
+&pm8916_bms {
+	monitored-battery = <&battery>;
+	power-supplies = <&pm8916_charger>;
+
+	status = "okay";
+};
+
+&usb {
+	dr_mode = "peripheral";
+	extcon = <&pm8916_charger>;
+};
+
+&usb_hs_phy {
+	extcon = <&pm8916_charger>;
+};
+
+/*
+ * Hold the modem A2 power rail on.  Without this the modem asserts
+ * a2_power and enters an SSR crash loop ("modem pc-ack timeout during
+ * resume") as soon as the BAM channels go idle.  The property makes the
+ * bam-dmux driver call pm_runtime_forbid(), keeping power/control=on.
+ */
+&bam_dmux {
+	qcom,a2-pin;
+};
