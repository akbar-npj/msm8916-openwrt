--- /dev/null
+++ b/drivers/leds/leds-pm8916-mpp.c
@@ -0,0 +1,123 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Minimal current-sink LED driver for the PM8916 MPP used as the LCD
+ * backlight on MSM8916 MiFi boards.  Only the vendor's "manual" mode is
+ * implemented: 5..40 mA in 5 mA steps, no PWM/blinking.
+ */
+
+#include <linux/leds.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+
+#define PM8916_MPP_MODE_CTL	0x40
+#define PM8916_MPP_EN_CTL	0x46
+#define PM8916_MPP_SINK_CTL	0x4c
+
+#define PM8916_MPP_MODE_SINK	(6 << 4)
+/* Source select 1 connects the current sink to the LED string.  The vendor
+ * driver sets this by default (MODE_CTL 0x61); clearing it with the mode
+ * write makes the sink run but leaves the panel dark. */
+#define PM8916_MPP_MODE_SOURCE	0x01
+#define PM8916_MPP_MODE_MASK	0x7f
+#define PM8916_MPP_EN_MASK	0x80
+#define PM8916_MPP_SINK_MASK	0x07
+
+#define PM8916_MPP_CURRENT_MIN	5
+#define PM8916_MPP_CURRENT_MAX	40
+
+struct pm8916_mpp_led {
+	struct led_classdev cdev;
+	struct regmap *map;
+	unsigned int base;
+};
+
+static int pm8916_mpp_led_set(struct led_classdev *cdev,
+			      enum led_brightness brightness)
+{
+	struct pm8916_mpp_led *led =
+		container_of(cdev, struct pm8916_mpp_led, cdev);
+	int ret;
+
+	if (brightness == LED_OFF) {
+		ret = regmap_update_bits(led->map, led->base + PM8916_MPP_MODE_CTL,
+					 PM8916_MPP_MODE_MASK, 0);
+		if (ret)
+			return ret;
+		return regmap_update_bits(led->map, led->base + PM8916_MPP_EN_CTL,
+					  PM8916_MPP_EN_MASK, 0);
+	}
+
+	if (brightness < PM8916_MPP_CURRENT_MIN)
+		brightness = PM8916_MPP_CURRENT_MIN;
+	if (brightness > PM8916_MPP_CURRENT_MAX)
+		brightness = PM8916_MPP_CURRENT_MAX;
+
+	ret = regmap_update_bits(led->map, led->base + PM8916_MPP_MODE_CTL,
+				 PM8916_MPP_MODE_MASK,
+				 PM8916_MPP_MODE_SINK | PM8916_MPP_MODE_SOURCE);
+	if (ret)
+		return ret;
+	ret = regmap_update_bits(led->map, led->base + PM8916_MPP_SINK_CTL,
+				 PM8916_MPP_SINK_MASK,
+				 brightness / PM8916_MPP_CURRENT_MIN - 1);
+	if (ret)
+		return ret;
+	return regmap_update_bits(led->map, led->base + PM8916_MPP_EN_CTL,
+				  PM8916_MPP_EN_MASK, PM8916_MPP_EN_MASK);
+}
+
+static int pm8916_mpp_led_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct pm8916_mpp_led *led;
+	struct led_init_data init_data = {};
+	u32 base;
+	int ret;
+
+	ret = of_property_read_u32(dev->of_node, "reg", &base);
+	if (ret)
+		return dev_err_probe(dev, ret, "missing MPP register base\n");
+
+	led = devm_kzalloc(dev, sizeof(*led), GFP_KERNEL);
+	if (!led)
+		return -ENOMEM;
+
+	led->map = dev_get_regmap(dev->parent, NULL);
+	if (!led->map)
+		return dev_err_probe(dev, -ENODEV, "parent has no regmap\n");
+	led->base = base;
+
+	led->cdev.max_brightness = PM8916_MPP_CURRENT_MAX;
+	led->cdev.brightness_set_blocking = pm8916_mpp_led_set;
+
+	/* led_bl resolves the LED through its DT phandle, so the class device
+	 * must carry the firmware node (plain _register() does not). */
+	init_data.fwnode = of_fwnode_handle(dev->of_node);
+	ret = devm_led_classdev_register_ext(dev, &led->cdev, &init_data);
+	if (ret)
+		return ret;
+
+	/* Match the vendor's default state: full current at boot. */
+	led_set_brightness(&led->cdev, PM8916_MPP_CURRENT_MAX);
+	return 0;
+}
+
+static const struct of_device_id pm8916_mpp_led_of_match[] = {
+	{ .compatible = "qcom,pm8916-mpp-led" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, pm8916_mpp_led_of_match);
+
+static struct platform_driver pm8916_mpp_led_driver = {
+	.probe = pm8916_mpp_led_probe,
+	.driver = {
+		.name = "pm8916-mpp-led",
+		.of_match_table = pm8916_mpp_led_of_match,
+	},
+};
+module_platform_driver(pm8916_mpp_led_driver);
+
+MODULE_DESCRIPTION("PM8916 MPP current sink LED (LCD backlight)");
+MODULE_LICENSE("GPL");
