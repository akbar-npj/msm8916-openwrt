 /*
+ * The pack thermistor is wired to the PMIC VADC rather than to the BMS
+ * block, so it has to be sampled separately.  The channel is optional: a
+ * board that leaves "batt-therm" out of the BMS node simply does not get
+ * a temperature and keeps using the room-temperature OCV table.
+ */
+static void pm8916_bms_vm_update_temp(struct pm8916_bms_vm_battery *bat)
+{
+	int temp;
+
+	if (!bat->batt_therm)
+		return;
+
+	if (iio_read_channel_processed(bat->batt_therm, &temp))
+		return;
+
+	bat->temp = temp;
+}
+
+/*
  * The VM-BMS is voltage-only: there is no coulomb counter and no current
  * sense, so the state of charge has to be derived from the voltage.
  *
@@ -111,7 +133,7 @@
 
 		val->intval = power_supply_batinfo_ocv2cap(info,
 							   pm8916_bms_vm_get_ocv(bat),
-							   25);
+							   bat->temp / 1000);
 		if (val->intval < 0)
 			return val->intval;
 
@@ -142,6 +164,14 @@
 		val->intval = bat->last_ocv;
 		return 0;
 
+	case POWER_SUPPLY_PROP_TEMP:
+		if (!bat->batt_therm)
+			return -ENODATA;
+
+		/* power_supply reports tenths of a degree Celsius */
+		val->intval = bat->temp / 100;
+		return 0;
+
 	default:
 		return -EINVAL;
 	}
