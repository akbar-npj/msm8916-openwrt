+/*
+ * bam_dmux_account_deferred_wipe - Count a deferred-TX bitmap about to be
+ * discarded (patch 811 diagnostics).
+ *
+ * The two callers that throw deferred work away -- bam_dmux_power_off() (SSR,
+ * where dropping is correct) and bam_dmux_pm_restart() (an A2 wake, where it
+ * is not) -- call this just before zeroing tx_deferred_skb, while the slots
+ * are still populated.  tx_defer_wiped_live counts real packets destroyed;
+ * tx_defer_wiped minus tx_defer_wiped_live counts stale bits.
+ */
+static void bam_dmux_account_deferred_wipe(struct bam_dmux *dmux,
+					   unsigned long bits)
+{
+	int i;
+
+	if (!bits)
+		return;
+
+	atomic64_add(hweight_long(bits), &dmux->tx_defer_wiped);
+	for_each_set_bit(i, &bits, BAM_DMUX_NUM_SKB)
+		if (dmux->tx_skbs[i].skb)
+			atomic64_inc(&dmux->tx_defer_wiped_live);
+}
