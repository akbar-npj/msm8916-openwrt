+/*
+ * The hardware only captures a true open-circuit voltage while the system
+ * is off or suspended.  A sample older than this is no longer
+ * representative of the current state of charge.
+ */
+#define PM8916_BMS_VM_OCV_TIMEOUT_S 180
+
 struct pm8916_bms_vm_battery {
 	struct device *dev;
 	struct power_supply *battery;
@@ -55,6 +62,24 @@
 	unsigned int vbat_now;
 };
 
+/*
+ * The VM-BMS is voltage-only: there is no coulomb counter and no current
+ * sense, so the state of charge has to be derived from the voltage.
+ *
+ * Prefer the OCV captured by the hardware while the system was off or
+ * suspended; it is the only sample that is not distorted by the system
+ * load.  Once it goes stale, fall back to the running voltage.  That one
+ * sits below the true OCV while discharging, so the resulting capacity is
+ * a conservative (low) estimate rather than an optimistic one.
+ */
+static int pm8916_bms_vm_get_ocv(struct pm8916_bms_vm_battery *bat)
+{
+	if (ktime_get_seconds() - bat->last_ocv_time <= PM8916_BMS_VM_OCV_TIMEOUT_S)
+		return bat->last_ocv;
+
+	return bat->vbat_now;
+}
