+static void q6v5_restart_debugfs_add(struct q6v5 *qproc)
+{
+	if (!q6v5_msm_subsys_dir)
+		q6v5_msm_subsys_dir = debugfs_create_dir("msm_subsys", NULL);
+	if (IS_ERR_OR_NULL(q6v5_msm_subsys_dir))
+		return;
+
+	qproc->restart_dentry = debugfs_create_file("modem", 0644,
+						    q6v5_msm_subsys_dir,
+						    qproc, &q6v5_restart_fops);
+}
+
+static void q6v5_restart_debugfs_remove(struct q6v5 *qproc)
+{
+	debugfs_remove(qproc->restart_dentry);
+	qproc->restart_dentry = NULL;
+}
