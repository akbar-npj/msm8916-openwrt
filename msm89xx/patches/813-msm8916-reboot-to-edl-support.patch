+/*
+ * qcom_scm_set_edload_mode - Set TCSR_BOOT_MISC_DETECT for Emergency Download.
+ *
+ * Writes SCM_EDLOAD_MODE (0x01) directly to bit[0] of the TCSR boot-misc
+ * register (0x193D100), matching lk2nd's scm_dload_mode(EMERGENCY_DLOAD).
+ *
+ * The QCOM_DLOAD_FULLDUMP path must NOT be used for EDL: Linux encodes it
+ * into bits[5:4] (value 0x10), whereas MSM8916 PBL checks bit[0] (value 0x01).
+ */
+int qcom_scm_set_edload_mode(void)
+{
+	if (!__scm || !__scm->dload_mode_addr)
+		return -ENODEV;
+
+	/* Raw write: SCM_EDLOAD_MODE = 0x01 to TCSR_BOOT_MISC_DETECT */
+	return qcom_scm_io_writel(__scm->dload_mode_addr, 0x01);
+}
+EXPORT_SYMBOL_GPL(qcom_scm_set_edload_mode);
