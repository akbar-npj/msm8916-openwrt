diff -u -N -r a/drivers/power/reset/qcom-pon.c b/drivers/power/reset/qcom-pon.c
--- a/drivers/power/reset/qcom-pon.c	2026-08-25 04:26:06.148180805 +0545
+++ b/drivers/power/reset/qcom-pon.c	2026-08-25 04:26:12.134407834 +0545
@@ -27,6 +27,95 @@
 	long reason_shift;
 };
 
+#define QPNP_PON_REVISION2_OFF		0x01
+#define QPNP_PON_WD_RST_S2_CTL2		0x57
+#define QPNP_PON_PS_HOLD_RST_CTL	0x5A
+#define QPNP_PON_PS_HOLD_RST_CTL2	0x5B
+#define QPNP_PON_RESET_EN		BIT(7)
+#define QPNP_PON_POWER_OFF_MASK		0x0F
+#define PON_POWER_OFF_WARM_RESET	0x01
+#define QPNP_PON_WD_EN			BIT(7)
+
+int pm8916_pon_configure_warm_reset(void);
+
+int pm8916_pon_configure_warm_reset(void)
+{
+	struct device_node *np;
+	struct platform_device *pdev;
+	struct pm8916_pon *pon;
+	u32 rev2 = 0;
+	u32 rst_en_reg;
+	int ret;
+
+	np = of_find_compatible_node(NULL, NULL, "qcom,pm8916-pon");
+	if (!np)
+		return -ENODEV;
+
+	pdev = of_find_device_by_node(np);
+	of_node_put(np);
+	if (!pdev)
+		return -ENODEV;
+
+	pon = platform_get_drvdata(pdev);
+	if (!pon || !pon->regmap) {
+		put_device(&pdev->dev);
+		return -ENODEV;
+	}
+
+	ret = regmap_read(pon->regmap,
+			  pon->baseaddr + QPNP_PON_REVISION2_OFF,
+			  &rev2);
+	if (ret) {
+		put_device(&pdev->dev);
+		return ret;
+	}
+
+	rst_en_reg = (rev2 == 0) ?
+		     (pon->baseaddr + QPNP_PON_PS_HOLD_RST_CTL) :
+		     (pon->baseaddr + QPNP_PON_PS_HOLD_RST_CTL2);
+
+	ret = regmap_update_bits(pon->regmap,
+				 rst_en_reg,
+				 QPNP_PON_RESET_EN,
+				 0);
+	if (ret) {
+		put_device(&pdev->dev);
+		return ret;
+	}
+
+	udelay(500);
+
+	ret = regmap_update_bits(
+		pon->regmap,
+		pon->baseaddr + QPNP_PON_PS_HOLD_RST_CTL,
+		QPNP_PON_POWER_OFF_MASK,
+		PON_POWER_OFF_WARM_RESET);
+	if (ret) {
+		put_device(&pdev->dev);
+		return ret;
+	}
+
+	ret = regmap_update_bits(pon->regmap,
+				 rst_en_reg,
+				 QPNP_PON_RESET_EN,
+				 QPNP_PON_RESET_EN);
+	if (ret) {
+		put_device(&pdev->dev);
+		return ret;
+	}
+
+	ret = regmap_update_bits(
+		pon->regmap,
+		pon->baseaddr + QPNP_PON_WD_RST_S2_CTL2,
+		QPNP_PON_WD_EN,
+		0);
+
+	put_device(&pdev->dev);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(pm8916_pon_configure_warm_reset);
