+#define MSM_IMEM_EDL_MAGIC1 0x322A4F99
+#define MSM_IMEM_EDL_MAGIC2 0xC67E4350
+#define MSM_IMEM_EDL_MAGIC3 0x77777777
+
+#define IMEM_RESTART_REASON_OFFSET 0x65C
+#define IMEM_EDL_COOKIES_OFFSET    0xFE0
+
+static void msm_write_emergency_dload_magic(void)
+{
+	if (!msm_imem_base)
+		return;
+
+	/* 1. Write Restart Reason to 0x0860065C */
+	writel(0x00000001, msm_imem_base + IMEM_RESTART_REASON_OFFSET);
+
+	/* 2. Write 3 Magic Cookies to 0x08600FE0 */
+	writel(MSM_IMEM_EDL_MAGIC1, msm_imem_base + IMEM_EDL_COOKIES_OFFSET + 0x00);
+	writel(MSM_IMEM_EDL_MAGIC2, msm_imem_base + IMEM_EDL_COOKIES_OFFSET + 0x04);
+	writel(MSM_IMEM_EDL_MAGIC3, msm_imem_base + IMEM_EDL_COOKIES_OFFSET + 0x08);
+	mb();
+}
 
