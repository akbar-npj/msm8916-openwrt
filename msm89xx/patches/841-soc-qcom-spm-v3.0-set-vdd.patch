+static void smp_set_vdd_v3_0(void *data)
+{
+	struct spm_driver_data *drv = data;
+	unsigned int vctl, data3, sts;
+	unsigned int vlevel = drv->volt_sel;
+
+	/* Kick the state machine back to idle */
+	spm_register_write(drv, SPM_REG_RST, 1);
+
+	/*
+	 * VCTL_PORT must be 0 for the PMIC_STS register to be updated, so the
+	 * vlevel is placed in bits [7:0] and the port field [18:16] is cleared.
+	 */
+	vctl = spm_register_read(drv, SPM_REG_VCTL);
+	vctl &= ~0x700FF;
+	vctl |= vlevel;
+	spm_register_write(drv, SPM_REG_VCTL, vctl);
+
+	data3 = spm_register_read(drv, SPM_REG_PMIC_DATA_3);
+	data3 &= ~0x700FF;
+	data3 |= vlevel;
+	spm_register_write(drv, SPM_REG_PMIC_DATA_3, data3);
+
+	if (read_poll_timeout_atomic(spm_register_read,
+				     sts, (sts & 0xFF) == vlevel,
+				     1, 1000, false,
+				     drv, SPM_REG_PMIC_STS))
+		dev_err_ratelimited(drv->dev,
+				    "timeout setting the voltage (%x %x)!\n",
+				    sts, vlevel);
+}
