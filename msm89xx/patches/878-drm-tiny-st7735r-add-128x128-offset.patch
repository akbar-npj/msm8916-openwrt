--- a/drivers/gpu/drm/tiny/st7735r.c
+++ b/drivers/gpu/drm/tiny/st7735r.c
@@ -149,6 +149,19 @@
 	.rgb		= true,
 };
 
+/*
+ * 1.44" 128x128 ST7735S panel on the MSM8916 MiFi boards.  With the address
+ * mode this driver programs (MX | MY | RGB) the panel maps GRAM rows 0..127
+ * onto the glass, so no row offset is needed here.  The vendor driver sets a
+ * different address mode (MADCTL 0xd8) and compensates with RASET 0x20..0x9f.
+ */
+static const struct st7735r_cfg st7735s_128128_cfg = {
+	.mode		= { DRM_SIMPLE_MODE(128, 128, 25, 26) },
+	.left_offset	= 0,
+	.top_offset	= 0,
+	.rgb		= true,
+};
+
 DEFINE_DRM_GEM_DMA_FOPS(st7735r_fops);
 
 static const struct drm_driver st7735r_driver = {
@@ -166,6 +179,7 @@
 static const struct of_device_id st7735r_of_match[] = {
 	{ .compatible = "jianda,jd-t18003-t01", .data = &jd_t18003_t01_cfg },
 	{ .compatible = "okaya,rh128128t", .data = &rh128128t_cfg },
+	{ .compatible = "sitronix,st7735s-128128", .data = &st7735s_128128_cfg },
 	{ },
 };
 MODULE_DEVICE_TABLE(of, st7735r_of_match);
@@ -173,6 +187,7 @@
 static const struct spi_device_id st7735r_id[] = {
 	{ "jd-t18003-t01", (uintptr_t)&jd_t18003_t01_cfg },
 	{ "rh128128t", (uintptr_t)&rh128128t_cfg },
+	{ "st7735s-128128", (uintptr_t)&st7735s_128128_cfg },
 	{ },
 };
 MODULE_DEVICE_TABLE(spi, st7735r_id);
