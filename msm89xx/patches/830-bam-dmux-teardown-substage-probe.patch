--- a/drivers/net/wwan/qcom_bam_dmux.c
+++ b/drivers/net/wwan/qcom_bam_dmux.c
@@ -1598,6 +1598,8 @@
 	unsigned long flags;
 	int i;
 
+	dev_err(dmux->dev, "bam-dmux PS0 enter power_off\n");
+
 	/* 1. Idempotency check: if already torn down, return immediately */
 	spin_lock_irqsave(&dmux->rx_lock, flags);
 	if (dmux->rx_tearing_down && !dmux->rx && !dmux->tx) {
@@ -1625,14 +1627,18 @@
 	 */
 	cancel_delayed_work_sync(&dmux->rx_rearm_work);
 	cancel_delayed_work(&dmux->rx_watchdog_work);
+	dev_err(dmux->dev, "bam-dmux PS1 rearm cancelled\n");
 
 	/* 3. Drain submitters; no DMA termination yet to prevent racing with prep/submit */
 	wait_event(dmux->rx_submit_wait,
 		   atomic_read(&dmux->rx_active_submitters) == 0);
+	dev_err(dmux->dev, "bam-dmux PS2 submitters drained\n");
 
 	/* 4. Safely terminate and release RX DMA */
 	if (dmux->rx) {
+		dev_err(dmux->dev, "bam-dmux PS3a terminating rx\n");
 		dmaengine_terminate_sync(dmux->rx);
+		dev_err(dmux->dev, "bam-dmux PS3b rx terminated, releasing\n");
 		dma_release_channel(dmux->rx);
 		spin_lock_irqsave(&dmux->rx_lock, flags);
 		dmux->rx = NULL;
