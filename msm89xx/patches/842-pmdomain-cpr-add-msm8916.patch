+/*
+ * MSM8916 uses a single APC rail (PM8916 S2, SAW/SPM controlled) with three
+ * CPR fuse corners.  The per-chip voltages live in row 27 of the QFPROM and
+ * the quotient-offset fuse is not present, so the offset is derived from the
+ * difference between adjacent fuse corner quotients (cpr_calculate_scaling()).
+ * The ring-oscillator select fuse is 3 bits wide, hence 8 step-quotient
+ * entries (all 26, matching the downstream qcom,cpr-step-quotient = <26>).
+ */
+static const struct cpr_desc msm8916_cpr_desc = {
+	.num_fuse_corners = 3,
+	.min_diff_quot = CPR_FUSE_MIN_QUOT_DIFF,
+	.step_quot = (int []){ 26, 26, 26, 26, 26, 26, 26, 26 },
+	.timer_delay_us = 5000,
+	.timer_cons_up = 0,
+	.timer_cons_down = 2,
+	.up_threshold = 0,
+	.down_threshold = 2,
+	.idle_clocks = 15,
+	.gcnt_us = 1,
+	.vdd_apc_step_up_limit = 1,
+	.vdd_apc_step_down_limit = 1,
+	.no_quotient_offset = true,
+	.cpr_fuses = {
+		.init_voltage_step = 10000,
+		.init_voltage_width = 6,
+		.fuse_corner_data = (struct fuse_corner_data[]){
+			/* SVS */
+			{
+				.ref_uV = 1100000,
+				.max_uV = 1100000,
+				/* Phase 3b: floor lowered 1100000 -> 1050000 so the
+				 * closed loop may step down to Android's ~1.05 V. */
+				.min_uV = 1050000,
+				.max_volt_scale = 0,
+				.max_quot_scale = 0,
+				.quot_offset = 0,
+				.quot_scale = 1,
+				.quot_adjust = 0,
+				.quot_offset_scale = 1,
+				.quot_offset_adjust = 0,
+			},
+			/* NORMAL */
+			{
+				.ref_uV = 1150000,
+				.max_uV = 1150000,
+				/* Phase 3b: floor lowered 1100000 -> 1050000 so the
+				 * closed loop may step down to Android's ~1.05 V. */
+				.min_uV = 1050000,
+				.max_volt_scale = 0,
+				.max_quot_scale = 650,
+				.quot_offset = 0,
+				.quot_scale = 1,
+				.quot_adjust = 0,
+				.quot_offset_scale = 1,
+				.quot_offset_adjust = 0,
+			},
+			/* TURBO */
+			{
+				.ref_uV = 1350000,
+				.max_uV = 1350000,
+				.min_uV = 1200000,
+				.max_volt_scale = 0,
+				.max_quot_scale = 650,
+				.quot_offset = 0,
+				.quot_scale = 1,
+				.quot_adjust = 0,
+				.quot_offset_scale = 1,
+				.quot_offset_adjust = 0,
+			},
+		},
+	},
+};
+
+/* mem-acc (ACC) is not wired up for msm8916 yet */
+static const struct acc_desc msm8916_acc_desc = {
+	.num_regs_per_fuse = 0,
+};
+
+static const struct cpr_acc_desc msm8916_cpr_acc_desc = {
+	.cpr_desc = &msm8916_cpr_desc,
+	.acc_desc = &msm8916_acc_desc,
+};
