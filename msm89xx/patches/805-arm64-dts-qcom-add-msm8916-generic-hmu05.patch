--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/msm8916-generic-hmu05.dts
@@ -0,0 +1,211 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+/dts-v1/;
+
+#include "msm8916-ufi.dtsi"
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/leds/common.h>
+
+/ {
+    model = "HMU05 4G Modem Stick";
+    compatible = "hmu05,250605v0s", "qcom,msm8916";
+};
+
+/*
+ * Persistent kernel logging for debugging.
+ *
+ * This region is shared with the UFI001B memory layout and has been
+ * verified as System RAM on these MSM8916 devices.
+ */
+&reserved_memory {
+    ramoops@8db00000 {
+        compatible = "ramoops";
+        reg = <0x0 0x8db00000 0x0 0x00100000>;
+        record-size = <0x00040000>;
+        console-size = <0x00040000>;
+        pmsg-size = <0x00040000>;
+    };
+};
+
+/*
+ * HMU05 reset button
+ *
+ * Original Android firmware:
+ *
+ *   GPIO37 = key_freset
+ *   direction = input
+ *   polarity = active-low
+ *   bias = pull-up
+ */
+&button_restart {
+    gpios = <&tlmm 37 GPIO_ACTIVE_LOW>;
+};
+
+&button_default {
+    pins = "gpio37";
+    bias-pull-up;
+};
+
+/*
+ * HMU05 LEDs
+ *
+ * Original Android GPIO mapping:
+ *
+ *   GPIO71 = 4g_1
+ *   GPIO72 = 4g_type
+ *   GPIO73 = wifistatus
+ *
+ * Physical LEDs identified on HMU05:
+ *
+ *   GPIO71 = GREEN
+ *   GPIO72 = RED
+ *   GPIO73 = BLUE
+ *
+ * Intended OpenWrt behaviour:
+ *
+ * GREEN:
+ *   LTE/netdev activity.
+ *   The netdev trigger is selected here. The actual WWAN
+ *   interface can be selected from userspace once we determine
+ *   which BAM-DMUX netdev carries the LTE data connection.
+ *
+ * RED:
+ *   Modem status/fault LED.
+ *   Starts ON during boot.
+ *   Userspace will turn it OFF when the modem is connected and
+ *   turn it ON again if the modem/remoteproc disconnects.
+ *
+ * BLUE:
+ *   Wi-Fi status.
+ */
+
+&led_g {
+    function = LED_FUNCTION_WLAN;
+    gpios = <&tlmm 71 GPIO_ACTIVE_HIGH>;
+    default-state = "on";
+};
+
+&led_r {
+    function = LED_FUNCTION_POWER;
+    gpios = <&tlmm 72 GPIO_ACTIVE_HIGH>;
+    default-state = "off";
+};
+
+&led_b {
+    function = LED_FUNCTION_WAN;
+    gpios = <&tlmm 73 GPIO_ACTIVE_HIGH>;
+    default-state = "on";
+};
+
+/*
+ * LED pin configuration.
+ *
+ * GPIO71 = green
+ * GPIO72 = red
+ * GPIO73 = blue
+ */
+&gpio_leds_default {
+    pins = "gpio71", "gpio72", "gpio73";
+};
+
+/*
+ * HMU05 board-specific GPIO initialization
+ *
+ * These GPIO states were recovered from the original Android
+ * firmware and verified against the running Android system.
+ *
+ * Android runtime state:
+ *
+ *   GPIO12   esim3_en       output LOW
+ *   GPIO14   esim2_en       output LOW
+ *   GPIO36   bat1           output LOW
+ *   GPIO106  ftest          output LOW
+ *   GPIO114  sim_hotplug    output LOW
+ *   GPIO119  esim1_en       output HIGH
+ *
+ * OpenWrt originally left several of these GPIOs as inputs.
+ *
+ * Keep them as GPIO hogs so that the board-specific electrical
+ * state is established early during TLMM initialization and
+ * retained independently of userspace.
+ */
+
+&tlmm {
+
+    /*
+     * Primary physical SIM enable.
+     *
+     * Android:
+     *   GPIO119 = output HIGH
+     */
+    sim1_en {
+        gpio-hog;
+        gpios = <119 GPIO_ACTIVE_HIGH>;
+        output-high;
+        line-name = "sim1_en";
+    };
+
+    /*
+     * Secondary SIM/eSIM control.
+     *
+     * Android:
+     *   GPIO14 = output LOW
+     */
+    sim2_en {
+        gpio-hog;
+        gpios = <14 GPIO_ACTIVE_HIGH>;
+        output-low;
+        line-name = "sim2_en";
+    };
+
+    /*
+     * Third SIM/eSIM control.
+     *
+     * Android:
+     *   GPIO12 = output LOW
+     */
+    sim3_en {
+        gpio-hog;
+        gpios = <12 GPIO_ACTIVE_HIGH>;
+        output-low;
+        line-name = "sim3_en";
+    };
+
+    /*
+     * SIM hotplug/control line.
+     *
+     * Despite its Android name "sim_hotplug", Android drives
+     * this GPIO as an output rather than configuring it as
+     * an interrupt/input.
+     *
+     * Android:
+     *   GPIO114 = output LOW
+     */
+    sim_hotplug {
+        gpio-hog;
+        gpios = <114 GPIO_ACTIVE_HIGH>;
+        output-low;
+        line-name = "sim_hotplug";
+    };
+
+    /*
+     * Android "bat1" GPIO.
+     */
+    bat1 {
+        gpio-hog;
+        gpios = <36 GPIO_ACTIVE_HIGH>;
+        output-low;
+        line-name = "bat1";
+    };
+
+    /*
+     * Factory-test GPIO.
+     */
+    ftest {
+        gpio-hog;
+        gpios = <106 GPIO_ACTIVE_HIGH>;
+        output-low;
+        line-name = "ftest";
+    };
+};
