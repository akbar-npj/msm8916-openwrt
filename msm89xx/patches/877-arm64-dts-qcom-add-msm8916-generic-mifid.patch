+
+&reserved_memory {
+	ramoops@8db00000 {
+		compatible = "ramoops";
+		reg = <0x0 0x8db00000 0x0 0x00100000>;
+		record-size = <0x00040000>;
+		console-size = <0x00040000>;
+		pmsg-size = <0x00040000>;
+		ecc-size = <16>;
+	};
+};
+
+/*
+ * This unit has NO physical LEDs.  The stock Android DTB declares these
+ * GPIOs as gpio-leds only so userspace can drive functional SIM lines via
+ * /sys/class/leds/<label>/brightness.  Keep those control lines (and their
+ * stock "keep" state) but do not drive any lamps.  The wifistatus / 4g_* /
+ * bat* nodes from the generic stock DTB are NOT populated here.
+ */
+&{/leds} {
+	/delete-node/ led-r;
+	/delete-node/ led-g;
+	/delete-node/ led-b;
+
+	/* eSIM / SIM rail enables - functional outputs, not lamps. */
+	led-esim1-en {
+		label = "esim1_en";
+		gpios = <&tlmm 119 GPIO_ACTIVE_HIGH>;
+		default-state = "keep";
+	};
+	led-esim2-en {
+		label = "esim2_en";
+		gpios = <&tlmm 112 GPIO_ACTIVE_HIGH>;
+		default-state = "keep";
+	};
+	led-esim3-en {
+		label = "esim3_en";
+		gpios = <&tlmm 12 GPIO_ACTIVE_HIGH>;
+		default-state = "keep";
+	};
+
+	/* SIM re-announce pulse.  The sim-hotplug service opens exactly
+	 * /sys/class/leds/sim_hotplug/brightness - do not rename. */
+	led-sim-hotplug {
+		label = "sim_hotplug";
+		gpios = <&tlmm 114 GPIO_ACTIVE_HIGH>;
+		default-state = "keep";
+	};
+};
+
+&gpio_leds_default {
+	pins = "gpio12", "gpio112", "gpio114", "gpio119";
+};
+
+&{/gpio-keys} {
+	key-key-wps {
+		label = "key_wps";
+		gpios = <&tlmm 27 GPIO_ACTIVE_LOW>;
+		linux,code = <KEY_WPS_BUTTON>;
+	};
+};
+
+&button_restart {
+	gpios = <&tlmm 102 GPIO_ACTIVE_LOW>;
+};
+
+/* TODO verify the reset pin's bias on the board. */
+&button_default {
+	pins = "gpio102";
+	bias-pull-up;
+};
+
+/* pm8916_usbin and pm8916_charger both claim SPMI 0x1300 and
+ * the VBUS interrupt. Bind the charger: it also supplies the
+ * extcon the MSM HS PHY needs to enumerate the gadget. */
+&pm8916_usbin {
+	status = "disabled";
+};
+
+&pm8916_charger {
+	monitored-battery = <&battery>;
+
+	/* TODO verify these limits against the fitted cell. */
+	qcom,fast-charge-safe-voltage = <4200000>;
+	qcom,fast-charge-safe-current = <1000000>;
+
+	status = "okay";
+};
+
+&usb {
+	dr_mode = "peripheral";
+	extcon = <&pm8916_charger>;
+};
+
+&usb_hs_phy {
+	extcon = <&pm8916_charger>;
+};
+
+&pm8916_bms {
+	monitored-battery = <&battery>;
+	power-supplies = <&pm8916_charger>;
+	status = "okay";
+};
+
+/* LCD panel: this unit has a 128x128 SPI display (the stock DTB is the
+ * generic MTP and lists several panels; the selected one is
+ * qcom,mdss_spi_st7735s_128128_cmd, "st7735s 128128 command mode spi panel",
+ * pref-prim-intf = "spi", on /soc/spi@78b9000/qcom,mdss_spi_client@0).
+ * The vendor init sequence lives in that node's qcom,mdss-spi-on-command
+ * blob.  Live Android reports fb0 name mdssfb_d0000, mode U:128x128p-0,
+ * virtual 128,256.  Mainline uses the st7735r drm panel driver with a
+ * different binding from qcom,mdss_spi_*, so wiring this panel is left as
+ * a hardware-verified follow-up: enable CONFIG_DRM_PANEL_SITRONIX_ST7735R
+ * and the MDSS SPI host, add the panel node on &spi0 with the correct
+ * reset/backlight GPIOs, then confirm on the device before claiming LCD
+ * support.  Until then the display is intentionally left unconfigured.
+ */
