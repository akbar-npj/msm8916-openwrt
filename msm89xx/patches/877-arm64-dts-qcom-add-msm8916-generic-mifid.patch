--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/msm8916-generic-mifid.dts
@@ -0,0 +1,273 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * HM-MIFIB-V18 - Generic MSM8916 board.
+ *
+ * Generated by scripts/new-board.py from mifid.dtb.
+ * Review every TODO and verify the GPIOs on hardware before
+ * calling the board supported.
+ */
+
+/dts-v1/;
+
+#include "msm8916-ufi.dtsi"
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/leds/common.h>
+#include <dt-bindings/input/linux-event-codes.h>
+
+/ {
+	model = "HM-MIFIB-V18";
+	compatible = "mifid,generic", "qcom,msm8916";
+
+	/*
+	 * Values taken from the stock profile 'qrd_4v2_2000mah'.  Check them
+	 * against the pack label: vendors ship a reference profile that
+	 * often does not match the fitted cell.
+	 */
+	battery: battery {
+		compatible = "simple-battery";
+		voltage-min-design-microvolt = <3350000>;
+		voltage-max-design-microvolt = <4200000>;
+		charge-full-design-microamp-hours = <2150000>;
+		charge-term-current-microamp = <100000>;
+		constant-charge-voltage-max-microvolt = <4200000>;
+		ocv-capacity-celsius = <(-20) 0 25 40 60>;
+		ocv-capacity-table-0 =
+			<4150000 100>, <4120000 95>, <4085000 90>, <4050000 85>,
+			<4015000 80>, <3950000 75>, <3906000 70>, <3864000 65>,
+			<3826000 60>, <3809000 55>, <3798000 50>, <3787000 45>,
+			<3776000 40>, <3755000 35>, <3735000 30>, <3715000 25>,
+			<3680000 20>, <3620000 16>, <3583000 13>, <3563000 11>,
+			<3553000 10>, <3533000 9>, <3520000 8>, <3490000 7>,
+			<3460000 6>, <3440000 5>, <3410000 4>, <3390000 3>,
+			<3370000 2>, <3360000 1>, <3350000 0>;
+		ocv-capacity-table-1 =
+			<4150000 100>, <4125000 95>, <4090000 90>, <4065000 85>,
+			<4022000 80>, <3989000 75>, <3949000 70>, <3902000 65>,
+			<3877000 60>, <3837000 55>, <3810000 50>, <3789000 45>,
+			<3776000 40>, <3755000 35>, <3735000 30>, <3715000 25>,
+			<3680000 20>, <3620000 16>, <3583000 13>, <3563000 11>,
+			<3553000 10>, <3533000 9>, <3520000 8>, <3490000 7>,
+			<3460000 6>, <3440000 5>, <3410000 4>, <3390000 3>,
+			<3370000 2>, <3360000 1>, <3350000 0>;
+		ocv-capacity-table-2 =
+			<4150000 100>, <4125000 95>, <4090000 90>, <4065000 85>,
+			<4022000 80>, <3989000 75>, <3949000 70>, <3902000 65>,
+			<3877000 60>, <3837000 55>, <3810000 50>, <3789000 45>,
+			<3776000 40>, <3755000 35>, <3735000 30>, <3715000 25>,
+			<3680000 20>, <3620000 16>, <3583000 13>, <3563000 11>,
+			<3553000 10>, <3533000 9>, <3520000 8>, <3490000 7>,
+			<3460000 6>, <3440000 5>, <3410000 4>, <3390000 3>,
+			<3370000 2>, <3360000 1>, <3350000 0>;
+		ocv-capacity-table-3 =
+			<4150000 100>, <4125000 95>, <4090000 90>, <4065000 85>,
+			<4022000 80>, <3989000 75>, <3949000 70>, <3902000 65>,
+			<3877000 60>, <3837000 55>, <3810000 50>, <3789000 45>,
+			<3776000 40>, <3755000 35>, <3735000 30>, <3715000 25>,
+			<3680000 20>, <3620000 16>, <3583000 13>, <3563000 11>,
+			<3553000 10>, <3533000 9>, <3520000 8>, <3490000 7>,
+			<3460000 6>, <3440000 5>, <3410000 4>, <3390000 3>,
+			<3370000 2>, <3360000 1>, <3350000 0>;
+		ocv-capacity-table-4 =
+			<4149000 100>, <4125000 95>, <4090000 90>, <4065000 85>,
+			<4022000 80>, <3989000 75>, <3949000 70>, <3902000 65>,
+			<3877000 60>, <3837000 55>, <3810000 50>, <3789000 45>,
+			<3776000 40>, <3755000 35>, <3735000 30>, <3715000 25>,
+			<3680000 20>, <3620000 16>, <3583000 13>, <3563000 11>,
+			<3553000 10>, <3533000 9>, <3520000 8>, <3490000 7>,
+			<3460000 6>, <3440000 5>, <3410000 4>, <3390000 3>,
+			<3370000 2>, <3360000 1>, <3350000 0>;
+	};
+
+	/* Backlight on PMIC MPP4: the LED-class driver (patch 879) reports
+	 * 5..40 mA, and led-backlight maps eight sysfs levels onto it. */
+	lcd_backlight: backlight-lcd {
+		compatible = "led-backlight";
+		leds = <&lcd_wled>;
+		brightness-levels = <0 5 10 15 20 25 30 35 40>;
+		default-brightness-level = <8>;
+	};
+};
+
+&reserved_memory {
+	ramoops@8db00000 {
+		compatible = "ramoops";
+		reg = <0x0 0x8db00000 0x0 0x00100000>;
+		record-size = <0x00040000>;
+		console-size = <0x00040000>;
+		pmsg-size = <0x00040000>;
+		ecc-size = <16>;
+	};
+};
+
+/*
+ * This unit has NO physical LEDs.  The stock Android DTB declares these
+ * GPIOs as gpio-leds only so userspace can drive functional SIM lines via
+ * /sys/class/leds/<label>/brightness.  Keep those control lines (and their
+ * stock "keep" state) but do not drive any lamps.  The wifistatus / 4g_* /
+ * bat* nodes from the generic stock DTB are NOT populated here.
+ */
+&{/leds} {
+	/delete-node/ led-r;
+	/delete-node/ led-g;
+	/delete-node/ led-b;
+
+	/* eSIM / SIM rail enables - functional outputs, not lamps. */
+	led-esim1-en {
+		label = "esim1_en";
+		gpios = <&tlmm 119 GPIO_ACTIVE_HIGH>;
+		default-state = "keep";
+	};
+	led-esim2-en {
+		label = "esim2_en";
+		gpios = <&tlmm 112 GPIO_ACTIVE_HIGH>;
+		default-state = "keep";
+	};
+	led-esim3-en {
+		label = "esim3_en";
+		gpios = <&tlmm 12 GPIO_ACTIVE_HIGH>;
+		default-state = "keep";
+	};
+
+	/* SIM re-announce pulse.  The sim-hotplug service opens exactly
+	 * /sys/class/leds/sim_hotplug/brightness - do not rename. */
+	led-sim-hotplug {
+		label = "sim_hotplug";
+		gpios = <&tlmm 114 GPIO_ACTIVE_HIGH>;
+		default-state = "keep";
+	};
+};
+
+&gpio_leds_default {
+	pins = "gpio12", "gpio112", "gpio114", "gpio119";
+};
+
+&{/gpio-keys} {
+	key-key-wps {
+		label = "key_wps";
+		gpios = <&tlmm 27 GPIO_ACTIVE_LOW>;
+		linux,code = <KEY_WPS_BUTTON>;
+	};
+};
+
+&button_restart {
+	gpios = <&tlmm 102 GPIO_ACTIVE_LOW>;
+};
+
+/* TODO verify the reset pin's bias on the board. */
+&button_default {
+	pins = "gpio102";
+	bias-pull-up;
+};
+
+/* pm8916_usbin and pm8916_charger both claim SPMI 0x1300 and
+ * the VBUS interrupt. Bind the charger: it also supplies the
+ * extcon the MSM HS PHY needs to enumerate the gadget. */
+&pm8916_usbin {
+	status = "disabled";
+};
+
+&pm8916_charger {
+	monitored-battery = <&battery>;
+
+	/* TODO verify these limits against the fitted cell. */
+	qcom,fast-charge-safe-voltage = <4200000>;
+	qcom,fast-charge-safe-current = <1000000>;
+
+	status = "okay";
+};
+
+&usb {
+	dr_mode = "peripheral";
+	extcon = <&pm8916_charger>;
+};
+
+&usb_hs_phy {
+	extcon = <&pm8916_charger>;
+};
+
+&pm8916_bms {
+	monitored-battery = <&battery>;
+	power-supplies = <&pm8916_charger>;
+	status = "okay";
+};
+
+/*
+ * LCD: 1.44" 128x128 ST7735S on BLSP SPI5 (spi@78b9000), 16 MHz, native CS.
+ * reset = TLMM 11, dc = TLMM 30 (both active-high).  Driven by the mainline
+ * tinydrm st7735r driver; "sitronix,st7735s-128128" is added by patch 878
+ * with no row offset (mainline MX|MY|RGB maps GRAM rows 0..127 to the glass).
+ *
+ * Supplies: VDD 2.85 V (8916_l17), VDDIO 1.8 V (8916_l6).  The DRM panel
+ * driver does not consume regulators, so both rails are held always-on.
+ * l6 is only wired to DSI in the shared dtsi, which this board does not use.
+ *
+ * Backlight: PMIC MPP4 current sink.  Patch 879 adds the small LED-class
+ * driver and enables the led-backlight bridge, so brightness is available
+ * at /sys/class/backlight/backlight-lcd/brightness in eight 5 mA steps.
+ */
+&pm8916_0 {
+	/* MPP4 (SPMI 0xa300, stock "lcdwled-backlight") belongs to PMIC@0 /
+	 * SID 0, the same slave as &pm8916_mpps.  Putting this node on
+	 * PMIC@1 makes every SPMI write hit a non-existent peripheral and
+	 * fail with -ENODEV, leaving the panel stuck at the pinctrl default. */
+	lcd_wled: lcd-wled@a300 {
+		compatible = "qcom,pm8916-mpp-led";
+		reg = <0xa300>;
+		label = "lcdwled-backlight";
+		status = "okay";
+	};
+};
+
+&pm8916_rpm_regulators {
+	pm8916_l17: l17 {
+		regulator-min-microvolt = <2850000>;
+		regulator-max-microvolt = <2850000>;
+		regulator-always-on;
+	};
+};
+
+&pm8916_l6 {
+	regulator-always-on;
+};
+
+&pm8916_mpps {
+	pm8916_mpp4_sink: mpp4-sink-state {
+		pins = "mpp4";
+		function = "sink";
+		/* Stock: qcom,source-sel = <1>, brightness 5-40 mA.  Mainline
+		 * pinctrl writes drive-strength raw into the 3-bit SINK_CTL
+		 * field (0=5 mA .. 7=40 mA), so this is a register value,
+		 * not a current in mA.  Keep it at full scale: the LED driver
+		 * takes over brightness changes at runtime. */
+		power-source = <1>;
+		drive-strength = <7>;
+		output-high;
+	};
+};
+
+&blsp_spi5 {
+	status = "okay";
+
+	/*
+	 * The SoC dtsi muxes SPI5's chip-select pad (gpio18) as a GPIO held
+	 * high and expects the board to drive it.  Without this the QUP uses
+	 * its internal CS, which never reaches the pad, so the panel is
+	 * deselected for every transfer: backlight on, nothing on screen.
+	 * Stock drives the same pad as blsp_spi5 hardware CS.
+	 */
+	cs-gpios = <&tlmm 18 GPIO_ACTIVE_LOW>;
+
+	panel@0 {
+		compatible = "sitronix,st7735s-128128";
+		reg = <0>;
+		spi-max-frequency = <16000000>;
+		reset-gpios = <&tlmm 11 GPIO_ACTIVE_HIGH>;
+		dc-gpios = <&tlmm 30 GPIO_ACTIVE_HIGH>;
+		rotation = <0>;
+		backlight = <&lcd_backlight>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&pm8916_mpp4_sink>;
+	};
+};
