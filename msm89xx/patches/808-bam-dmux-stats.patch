--- a/drivers/net/wwan/qcom_bam_dmux.c
+++ b/drivers/net/wwan/qcom_bam_dmux.c
@@ -14,6 +14,7 @@
 #include <linux/mod_devicetable.h>
 #include <linux/module.h>
 #include <linux/netdevice.h>
+#include <linux/of.h>
 #include <linux/platform_device.h>
 #include <linux/pm_runtime.h>
 #include <linux/soc/qcom/smem_state.h>
@@ -200,6 +201,10 @@ static bool bam_dmux_skb_dma_submit_tx(
 	desc->callback = bam_dmux_tx_callback;
 	desc->callback_param = skb_dma;
 	desc->cookie = dmaengine_submit(desc);
+	if (dma_submit_error(desc->cookie)) {
+		dev_err(dmux->dev, "Failed to submit TX DMA descriptor: %d\n", desc->cookie);
+		return false;
+	}
 	return true;
 }
 
@@ -307,7 +312,7 @@ static int bam_dmux_tx_prepare_skb(stru
 				   struct sk_buff *skb)
 {
 	unsigned int head = needed_room(skb_headroom(skb), BAM_DMUX_HDR_SIZE);
-	unsigned int pad = sizeof(u32) - skb->len % sizeof(u32);
+	unsigned int pad = (sizeof(u32) - (skb->len % sizeof(u32))) % sizeof(u32);
 	unsigned int tail = needed_room(skb_tailroom(skb), pad);
 	struct bam_dmux_hdr *hdr;
 	int ret;
@@ -359,6 +364,8 @@ static netdev_tx_t bam_dmux_netdev_star
 		if (!atomic_long_fetch_or(BIT(skb_dma - dmux->tx_skbs),
 					  &dmux->tx_deferred_skb))
 			queue_pm_work(&dmux->tx_wakeup_work);
+		DEV_STATS_INC(netdev, tx_packets);
+		DEV_STATS_ADD(netdev, tx_bytes, skb->len);
 		return NETDEV_TX_OK;
 	}
 
@@ -366,9 +373,12 @@ static netdev_tx_t bam_dmux_netdev_star
 		goto drop;
 
 	dma_async_issue_pending(dmux->tx);
+	DEV_STATS_INC(netdev, tx_packets);
+	DEV_STATS_ADD(netdev, tx_bytes, skb->len);
 	return NETDEV_TX_OK;
 
 drop:
+	DEV_STATS_INC(netdev, tx_dropped);
 	bam_dmux_tx_done(skb_dma);
 	dev_kfree_skb_any(skb);
 	return NETDEV_TX_OK;
@@ -536,6 +546,8 @@ static void bam_dmux_cmd_data(struct bam
 		break;
 	}
 
+	DEV_STATS_INC(netdev, rx_packets);
+	DEV_STATS_ADD(netdev, rx_bytes, skb->len);
 	netif_receive_skb(skb);
 }
 
@@ -620,6 +632,10 @@ static bool bam_dmux_power_on(struct bam
 		.direction = DMA_DEV_TO_MEM,
 		.src_maxburst = BAM_DMUX_BUFFER_SIZE,
 	};
+	struct dma_slave_config dma_tx_conf = {
+		.direction = DMA_MEM_TO_DEV,
+		.dst_maxburst = BAM_DMUX_BUFFER_SIZE,
+	};
 	int i;
 
 	dmux->rx = dma_request_chan(dev, "rx");
@@ -630,6 +646,16 @@ static bool bam_dmux_power_on(struct bam
 	}
 	dmaengine_slave_config(dmux->rx, &dma_rx_conf);
 
+	if (!dmux->tx) {
+		dmux->tx = dma_request_chan(dev, "tx");
+		if (IS_ERR(dmux->tx)) {
+			dev_err(dev, "Failed to request TX DMA channel: %pe\n", dmux->tx);
+			dmux->tx = NULL;
+			return false;
+		}
+	}
+	dmaengine_slave_config(dmux->tx, &dma_tx_conf);
+
 	for (i = 0; i < BAM_DMUX_NUM_SKB; i++) {
 		if (!bam_dmux_skb_dma_queue_rx(&dmux->rx_skbs[i], GFP_KERNEL))
 			return false;
@@ -671,6 +697,10 @@ static void bam_dmux_power_off(struct ba
 	}
 
 	bam_dmux_free_skbs(dmux->rx_skbs, DMA_FROM_DEVICE);
+	bam_dmux_free_skbs(dmux->tx_skbs, DMA_TO_DEVICE);
+	dmux->tx_next_skb = 0;
+	atomic_long_set(&dmux->tx_deferred_skb, 0);
+	bitmap_zero(dmux->remote_channels, BAM_DMUX_NUM_CH);
 }
 
 static irqreturn_t bam_dmux_pc_irq(int irq, void *data)
@@ -681,13 +711,17 @@ static irqreturn_t bam_dmux_pc_irq(int i
 	dev_dbg(dmux->dev, "pc: %u\n", new_state);
 
 	if (new_state) {
-		if (bam_dmux_power_on(dmux))
+		if (bam_dmux_power_on(dmux)) {
 			bam_dmux_pc_ack(dmux);
-		else
+			pm_runtime_set_active(dmux->dev);
+		} else {
 			bam_dmux_power_off(dmux);
+		}
 	} else {
 		bam_dmux_power_off(dmux);
 		bam_dmux_pc_ack(dmux);
+		if (!of_machine_is_compatible("qcom,msm8916-generic-hmu05"))
+			pm_runtime_set_suspended(dmux->dev);
 	}
 
 	dmux->pc_state = new_state;
@@ -761,6 +795,13 @@ static int __maybe_unused bam_dmux_runti
 		bam_dmux_runtime_suspend(dev);
 		return -ENXIO;
 	}
+	{
+		struct dma_slave_config dma_tx_conf = {
+			.direction = DMA_MEM_TO_DEV,
+			.dst_maxburst = BAM_DMUX_BUFFER_SIZE,
+		};
+		dmaengine_slave_config(dmux->tx, &dma_tx_conf);
+	}
 
 	return 0;
 }
@@ -819,6 +860,12 @@ static int bam_dmux_probe(struct platfor
 	pm_runtime_set_autosuspend_delay(dev, BAM_DMUX_AUTOSUSPEND_DELAY);
 	pm_runtime_use_autosuspend(dev);
 	pm_runtime_enable(dev);
+	/*
+	 * Scope BAM-DMUX "always active / no autosuspend" strictly to HMU05
+	 * at driver probe time to prevent baseband DMA sleep stalls.
+	 */
+	if (of_machine_is_compatible("qcom,msm8916-generic-hmu05"))
+		pm_runtime_forbid(dev);
 
 	ret = devm_request_threaded_irq(dev, pc_ack_irq, NULL, bam_dmux_pc_ack_irq,
 					IRQF_ONESHOT, NULL, dmux);
