+static bool bam_dmux_check_invariants(struct bam_dmux *dmux)
+{
+	unsigned long flags;
+	int i, mapped = 0, queued = 0;
+	bool chan_ok, desc_ok;
+	bool pc_st;
+	u8 pc_ack;
+
+	/* 1. Verify channels allocated and not tearing down under rx_lock */
+	spin_lock_irqsave(&dmux->rx_lock, flags);
+	chan_ok = (dmux->rx != NULL && dmux->tx != NULL && !dmux->rx_tearing_down);
+	if (!chan_ok) {
+		spin_unlock_irqrestore(&dmux->rx_lock, flags);
+		dev_dbg(dmux->dev, "invariants: channels not allocated or tearing down\n");
+		return false;
+	}
+
+	/* 2. Verify descriptors mapped and submitted under rx_lock */
+	for (i = 0; i < BAM_DMUX_NUM_SKB; i++) {
+		if (dmux->rx_skbs[i].addr && dmux->rx_skbs[i].skb)
+			mapped++;
+		if (dmux->rx_skbs[i].rx_state == BAM_DMUX_RX_SLOT_SUBMITTED)
+			queued++;
+	}
+	pc_st = READ_ONCE(dmux->pc_state);
+	pc_ack = dmux->pc_ack_state;
+	spin_unlock_irqrestore(&dmux->rx_lock, flags);
+
+	desc_ok = (mapped == BAM_DMUX_NUM_SKB && queued > 0);
+	if (!desc_ok) {
+		dev_warn(dmux->dev,
+			 "invariants: rx descriptors degraded (mapped=%d/32, queued=%d/32, pc=%d, ack=%d)\n",
+			 mapped, queued, pc_st, pc_ack);
+		return false;
+	}
+
+	dev_dbg(dmux->dev,
+		"invariants: OK (mapped=%d, queued=%d, pc=%d, ack=%d)\n",
+		mapped, queued, pc_st, pc_ack);
+	return true;
+}
