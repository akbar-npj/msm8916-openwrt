+	bitmap_zero(dmux->remote_channels, BAM_DMUX_NUM_CH);
 }
 
 static irqreturn_t bam_dmux_pc_irq(int irq, void *data)
@@ -681,13 +699,17 @@
 	dev_dbg(dmux->dev, "pc: %u\n", new_state);
 
 	if (new_state) {
-		if (bam_dmux_power_on(dmux))
+		if (bam_dmux_power_on(dmux)) {
 			bam_dmux_pc_ack(dmux);
-		else
+			pm_runtime_set_active(dmux->dev);
+		} else {
 			bam_dmux_power_off(dmux);
+		}
 	} else {
 		bam_dmux_power_off(dmux);
 		bam_dmux_pc_ack(dmux);
+		if (!of_machine_is_compatible("qcom,msm8916-generic-hmu05"))
+			pm_runtime_set_suspended(dmux->dev);
 	}
 
 	dmux->pc_state = new_state;
@@ -819,6 +841,12 @@
 	pm_runtime_set_autosuspend_delay(dev, BAM_DMUX_AUTOSUSPEND_DELAY);
 	pm_runtime_use_autosuspend(dev);
 	pm_runtime_enable(dev);
