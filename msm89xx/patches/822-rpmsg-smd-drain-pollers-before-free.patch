+#include <linux/delay.h>
 #include <linux/interrupt.h>
 #include <linux/io.h>
 #include <linux/mailbox_client.h>
@@ -1532,6 +1533,66 @@
 	return 0;
 }
 
+/*
+ * qcom_smd_drain_channel_pollers() - let outstanding pollers unlink first
+ *
+ * A task blocked in poll()/ppoll() on an rpmsg endpoint of this edge holds a
+ * poll_table_entry linked in channel->fblockread_event (see qcom_smd_poll()).
+ * That entry is only unlinked by poll_freewait(), i.e. once the woken task is
+ * scheduled again.  The device_for_each_child() call above wakes such a task
+ * (rpmsg_wwan_ctrl_remove() -> wwan_remove_port() -> wake_up_interruptible())
+ * but does not wait for it, while the edge release callback that frees the
+ * channels runs synchronously in this thread a few lines further down.
+ *
+ * Without this barrier the channel is freed while the poller still points into
+ * it, and poll_freewait() then walks a wait-queue head whose memory has been
+ * recycled by the slab allocator.  Observed on msm8916/HMU05 as
+ *
+ *   list_del corruption. prev->next should be <entry>, but was <freelist ptr>
+ *   WARNING: CPU: 1 PID: 4836 at lib/list_debug.c:62
+ *     __list_del_entry_valid_or_report
+ *     remove_wait_queue <- poll_freewait <- do_sys_poll <- __arm64_sys_ppoll
+ *
+ * followed by an AP reset.  The clobbered word is exactly
+ * &channel->fblockread_event.head.next, which for the kmalloc-192 object that
+ * holds struct qcom_smd_channel coincides with the SLUB freelist pointer.
+ *
+ * The wait is bounded so that a poller which somehow never wakes cannot hang
+ * the SSR teardown.
+ */
+static void qcom_smd_drain_channel_pollers(struct qcom_smd_edge *edge)
+{
+	struct qcom_smd_channel *channel;
+
+	list_for_each_entry(channel, &edge->channels, list) {
+		unsigned long deadline;
+
+		if (!waitqueue_active(&channel->fblockread_event))
+			continue;
+
+		/*
+		 * The task is parked on this queue, so a wakeup guarantees it
+		 * runs poll_freewait() even if nothing else woke it.
+		 */
+		wake_up_all(&channel->fblockread_event);
+
+		/*
+		 * Bound the wait by wall time rather than by an iteration
+		 * count: msleep(1) can sleep for a full tick or longer, so a
+		 * retry counter would bound this only very loosely.
+		 */
+		deadline = jiffies + msecs_to_jiffies(2000);
+		while (waitqueue_active(&channel->fblockread_event) &&
+		       time_before(jiffies, deadline))
+			msleep(1);
+
+		if (waitqueue_active(&channel->fblockread_event))
+			dev_warn(&edge->dev,
+				 "channel '%s' still has pollers after 2s\n",
+				 channel->name);
+	}
+}
+
 /**
  * qcom_smd_unregister_edge() - release an edge and its children
  * @edge:      edge reference acquired from qcom_smd_register_edge
@@ -1548,6 +1609,7 @@
 	if (ret)
 		dev_warn(&edge->dev, "can't remove smd device: %d\n", ret);
 
+	qcom_smd_drain_channel_pollers(edge);
 	mbox_free_channel(edge->mbox_chan);
 	device_unregister(&edge->dev);
 }
