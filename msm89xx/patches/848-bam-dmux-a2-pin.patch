--- a/drivers/net/wwan/qcom_bam_dmux.c
+++ b/drivers/net/wwan/qcom_bam_dmux.c
@@ -17,6 +17,7 @@
 #include <linux/of.h>
 #include <linux/platform_device.h>
 #include <linux/pm_runtime.h>
+#include <linux/property.h>
 #include <linux/soc/qcom/smem.h>
 #include <linux/soc/qcom/smem_state.h>
 #include <linux/remoteproc/qcom_rproc.h>
@@ -177,6 +178,19 @@
 	u64 cmd_open_no_a2_pc_count;
 	u64 cmd_unknown_count;
 	bool a2_pc_disabled;
+	/*
+	 * Set from the "qcom,a2-pin" device-tree property.  Only the boards
+	 * that need the modem's A2 kept powered (HMU05) set it; the A2 pin
+	 * itself is applied through pm_runtime_forbid() -- see the module
+	 * parameter and bam_dmux_apply_a2_pin() below.
+	 */
+	bool a2_pin_capable;
+	/*
+	 * Set in probe() when the board is pin-capable; the pin is applied from
+	 * bam_dmux_netdev_open() once the device is runtime-ACTIVE, so the
+	 * forbid's resume is a no-op and cannot race the boot handshake.
+	 */
+	bool a2_pin_pending;
 	atomic_t rx_queued_buffers;
 	struct delayed_work rx_rearm_work;
 	struct delayed_work rx_watchdog_work;
@@ -318,6 +332,54 @@
 	return level;
 }
 
+/*
+ * Board-gated A2 pin.
+ *
+ * The modem's A2 (BAM) power domain is voted DOWN in
+ * bam_dmux_runtime_suspend() -- the only caller of bam_dmux_pc_vote(dmux,
+ * false) -- one second after the last TX (the autosuspend delay).  On the
+ * HMU05 modem that power-collapse occasionally wedges the modem's internal
+ * quiesce handshake and it asserts a2_power.c:1189, so the userspace image
+ * used to hold power/control=on forever (the modem-a2-hold init script).
+ *
+ * Enforce the same invariant in the driver instead: pm_runtime_forbid() is
+ * exactly what writing "on" to power/control does -- it clears
+ * dev->power.runtime_auto and bumps the usage count, so the PM core never
+ * calls bam_dmux_runtime_suspend() and the A2 vote is never released.
+ *
+ * The pin is applied only on boards whose DT sets "qcom,a2-pin" (HMU05);
+ * the other boards' firmware (UFI001B = HIMU_U01_MODEM_V2.0, UZ801, ...)
+ * does not need it and must keep the normal runtime-suspend behaviour.
+ * The a2_pin module parameter flips the pin at run time for A/B soaks
+ * without reflashing:
+ *
+ *     echo 0 > /sys/module/qcom_bam_dmux/parameters/a2_pin   # control=auto
+ *     echo 1 > /sys/module/qcom_bam_dmux/parameters/a2_pin   # control=on
+ *
+ * The effective pin is a2_pin_capable (DT) && a2_pin (parameter).
+ *
+ * pm_runtime_forbid() is only cheap when the device is already runtime-ACTIVE
+ * (its rpm_resume() is then a no-op).  If the device is still RPM_SUSPENDED
+ * the forbid forces a resume, and that resume's up-vote is only acked once the
+ * modem's A2 is up and stable -- so the pin is applied from
+ * bam_dmux_netdev_open() (after its pm_runtime_resume_and_get()), never from
+ * probe or the pc-line assert.  See the callers for the boot-time details.
+ */
+static bool a2_pin = true;
+static DEFINE_MUTEX(bam_dmux_pin_lock);
+static struct bam_dmux *bam_dmux_pin_dmux;
+
+static void bam_dmux_apply_a2_pin(struct bam_dmux *dmux)
+{
+	if (!dmux || !dmux->a2_pin_capable)
+		return;
+
+	if (a2_pin)
+		pm_runtime_forbid(dmux->dev);
+	else
+		pm_runtime_allow(dmux->dev);
+}
+
 static bool bam_dmux_skb_dma_map(struct bam_dmux_skb_dma *skb_dma,
 				 enum dma_data_direction dir)
 {
@@ -583,6 +645,23 @@
 	if (ret < 0)
 		return ret;
 
+	/*
+	 * Apply the board-gated A2 pin (see bam_dmux_apply_a2_pin()).  Do it
+	 * here, AFTER the resume: the device is now runtime-ACTIVE, so
+	 * pm_runtime_forbid() is a no-op resume and cannot collide with the
+	 * boot power-control handshake.  Applying it earlier -- at probe, or on
+	 * the pc-line assert -- forces a resume whose up-vote the modem, still
+	 * bringing its A2 up, does not re-ack, logging a spurious 2 s "pc-ack
+	 * timeout during resume" at every boot.  The userspace pin this
+	 * replaces likewise took effect only once the interface was up.
+	 */
+	if (READ_ONCE(bndev->dmux->a2_pin_pending)) {
+		WRITE_ONCE(bndev->dmux->a2_pin_pending, false);
+		mutex_lock(&bam_dmux_pin_lock);
+		bam_dmux_apply_a2_pin(bndev->dmux);
+		mutex_unlock(&bam_dmux_pin_lock);
+	}
+
 	ret = bam_dmux_send_cmd(bndev, BAM_DMUX_CMD_OPEN);
 	if (ret) {
 		pm_runtime_put(bndev->dmux->dev);
@@ -2726,6 +2805,27 @@
 	if (ret)
 		dev_warn(dev, "Failed to create rx_telemetry sysfs: %d\n", ret);
 
+	/*
+	 * Arm the board-gated A2 pin (see bam_dmux_apply_a2_pin()).  On a board
+	 * whose DT sets "qcom,a2-pin" this is equivalent to the userspace
+	 * `echo on > power/control`: the device is forced active and the A2
+	 * down vote in bam_dmux_runtime_suspend() can never run.
+	 *
+	 * Do NOT apply it here: the device is not runtime-ACTIVE yet (nothing
+	 * has resumed it), so pm_runtime_forbid() would force a resume whose up
+	 * vote the not-yet-booted modem cannot ack, logging a spurious 2 s
+	 * "pc-ack timeout during resume".  Defer to bam_dmux_netdev_open(),
+	 * which resumes the device first and then applies the pin -- a no-op
+	 * resume at that point.
+	 */
+	dmux->a2_pin_capable = device_property_read_bool(dev, "qcom,a2-pin");
+	if (dmux->a2_pin_capable) {
+		mutex_lock(&bam_dmux_pin_lock);
+		bam_dmux_pin_dmux = dmux;
+		WRITE_ONCE(dmux->a2_pin_pending, true);
+		mutex_unlock(&bam_dmux_pin_lock);
+	}
+
 	return 0;
 
 err_disable_pm:
@@ -2776,6 +2876,13 @@
 	cancel_delayed_work_sync(&dmux->tx_retry_work);
 	cancel_work_sync(&dmux->tx_wakeup_work);
 
+	/* Release the A2 pin (pm_runtime_allow() balances the forbid's count) */
+	mutex_lock(&bam_dmux_pin_lock);
+	if (bam_dmux_pin_dmux == dmux)
+		bam_dmux_pin_dmux = NULL;
+	mutex_unlock(&bam_dmux_pin_lock);
+	pm_runtime_allow(dev);
+
 	/* Drop our own power vote */
 	pm_runtime_disable(dev);
 	pm_runtime_dont_use_autosuspend(dev);
@@ -2832,6 +2939,36 @@
 		.of_match_table = bam_dmux_of_match,
 	},
 };
+
+static int bam_dmux_a2_pin_set(const char *val, const struct kernel_param *kp)
+{
+	bool enable;
+	int ret = kstrtobool(val, &enable);
+
+	if (ret)
+		return ret;
+
+	mutex_lock(&bam_dmux_pin_lock);
+	a2_pin = enable;
+	bam_dmux_apply_a2_pin(bam_dmux_pin_dmux);
+	mutex_unlock(&bam_dmux_pin_lock);
+
+	return 0;
+}
+
+static int bam_dmux_a2_pin_get(char *buf, const struct kernel_param *kp)
+{
+	return sprintf(buf, "%d\n", a2_pin ? 1 : 0);
+}
+
+static const struct kernel_param_ops bam_dmux_a2_pin_ops = {
+	.set = bam_dmux_a2_pin_set,
+	.get = bam_dmux_a2_pin_get,
+};
+module_param_cb(a2_pin, &bam_dmux_a2_pin_ops, &a2_pin, 0644);
+MODULE_PARM_DESC(a2_pin,
+	"Hold the modem A2 powered on boards whose DT sets qcom,a2-pin (default 1)");
+
 module_platform_driver(bam_dmux_driver);
 
 MODULE_LICENSE("GPL v2");
