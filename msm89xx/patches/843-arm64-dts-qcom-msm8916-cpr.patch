+			/*
+			 * CPR (Core Power Reduction) fuse corner data, QFPROM
+			 * row 27 (byte offset 0xd8).  The three fuse corners are
+			 * SVS/NORMAL/TURBO; each has a 6-bit initial-voltage field
+			 * (MSB is a sign bit, step 10 mV off the corner ceiling)
+			 * and a 12-bit target quotient, plus a shared 3-bit ring
+			 * oscillator select.
+			 */
+			cpr_init_voltage1: init-voltage1@dc {
+				reg = <0xdc 0x4>;
+				bits = <4 6>;
+			};
+
+			cpr_init_voltage2: init-voltage2@da {
+				reg = <0xda 0x4>;
+				bits = <2 6>;
+			};
+
+			cpr_init_voltage3: init-voltage3@d8 {
+				reg = <0xd8 0x4>;
+				bits = <0 6>;
+			};
+
+			cpr_quotient1: quotient1@dd {
+				reg = <0xdd 0x4>;
+				bits = <2 12>;
+			};
+
+			cpr_quotient2: quotient2@db {
+				reg = <0xdb 0x4>;
+				bits = <0 12>;
+			};
+
+			cpr_quotient3: quotient3@d8 {
+				reg = <0xd8 0x4>;
+				bits = <6 12>;
+			};
