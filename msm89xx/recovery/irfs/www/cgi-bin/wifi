#!/bin/busybox sh
# Recovery web UI: WiFi station (AP+STA).
#
# The recovery image always runs an AP on wlan0 (hostapd -> br0, 192.168.10.1).
# It can ALSO join an existing network on a second vif, wlan1, so the box is
# reachable on the user's LAN without a USB cable.  The profile is
# /etc/wifi-sta.conf (wpa_supplicant format) and /init supervises the daemon
# and the DHCP client around it.
#
#   GET  ?action=status  -> one line: state \t ssid \t signal \t ip
#   GET  ?action=scan    -> one BSS per line: ssid \t bssid \t signal \t freq \t security
#   POST ?action=join    -> body IS the wpa_supplicant config; becomes the profile
#   POST ?action=leave   -> remove the profile and drop the link
#
# Tab-separated, not JSON: SSIDs are arbitrary bytes and quoting them into JSON
# in shell is where this would go wrong.  A 'join' body is built by the browser
# because the initramfs has no URL decoder and no wpa_passphrase - and building
# it client-side lets the SSID be sent as a hex string (wpa_supplicant's
# 'ssid=0011aabb' form), which sidesteps quoting entirely.
. /www/cgi-bin/lib.sh

PROFILE=/etc/wifi-sta.conf
IFACE=wlan1
PHY=phy0

hdr text/plain

# The station vif only exists while a profile does, so a scan from the UI has
# to create it.  AP+STA on one phy needs wcn36xx patch 452, which the recovery
# kernel carries.
ensure_iface() {
	[ -d "/sys/class/net/$IFACE" ] && return 0
	[ -d "/sys/class/net/$PHY" ] || return 1
	iw phy "$PHY" interface add "$IFACE" type managed 2>/dev/null || return 1
	ip link set "$IFACE" up 2>/dev/null
	# wcn36xx publishes the netdev before its firmware bring-up settles.
	sleep 2
	return 0
}

case "$(qs_get action)" in

status)
	link=$(iw dev "$IFACE" link 2>/dev/null)
	state=off
	ssid=""
	sig=""
	if printf '%s\n' "$link" | grep -q '^Connected to'; then
		state=connected
		ssid=$(printf '%s\n' "$link" | sed -n 's/^[[:space:]]*SSID: //p' | head -1)
		sig=$(printf '%s\n' "$link" | sed -n 's/^[[:space:]]*signal: \([-0-9.]*\) dBm/\1/p' | head -1)
	elif [ -s "$PROFILE" ]; then
		state=connecting
	fi
	ip4=$(ip -4 -o addr show dev "$IFACE" 2>/dev/null | awk '{print $4; exit}')
	printf '%s\t%s\t%s\t%s\n' "$state" "${ssid:--}" "${sig:--}" "${ip4:--}"
	;;

scan)
	ensure_iface || { echo "ERROR: $PHY not present (wcn36xx did not load)"; exit 0; }
	# A scan takes 2-5 s.  Cap it: a lost scan-completion event leaves
	# wcn36xx returning -EBUSY forever, and that must not hang the web UI.
	out=$(timeout 20 iw dev "$IFACE" scan 2>&1)
	if ! printf '%s\n' "$out" | grep -q '^BSS '; then
		msg=$(printf '%s\n' "$out" | grep -v '^[[:space:]]*$' | head -1)
		printf 'ERROR: %s\n' "${msg:-scan returned nothing}"
		exit 0
	fi
	printf '%s\n' "$out" | awk '
	function flush() {
		if (bssid == "") return
		gsub(/[[:cntrl:]]/, " ", ssid)
		if (ssid == "") ssid = "<hidden>"
		if (sig == "") sig = 0
		printf "%s\t%s\t%s\t%s\t%s\n", ssid, bssid, sig, freq, sec
	}
	/^BSS / {
		flush()
		bssid = $2; sub(/\(.*/, "", bssid)
		ssid = ""; sig = ""; freq = ""; sec = "open"; rsn = 0
		next
	}
	{
		line = $0
		sub(/^[[:space:]]+/, "", line)
		if (line ~ /^SSID: /)   { ssid = substr(line, 7); next }
		if (line ~ /^signal: /) { split(substr(line, 9), a, " "); sig = a[1]; next }
		if (line ~ /^freq: /)   { freq = substr(line, 7); next }
		if (line ~ /^RSN:/)     { rsn = 1; sec = "WPA2"; next }
		if (line ~ /^WPA:/)     { if (!rsn) sec = "WPA"; next }
		if (rsn && line ~ /Authentication suites:.*SAE/) sec = "WPA3"
	}
	END { flush() }'
	;;

join)
	[ "$REQUEST_METHOD" = POST ] || { echo "ERROR: POST required"; exit 0; }
	len=${CONTENT_LENGTH:-0}
	case "$len" in ''|*[!0-9]*) len=0 ;; esac
	if [ "$len" -lt 16 ] || [ "$len" -gt 4096 ]; then
		echo "ERROR: bad body length ($len)"
		exit 0
	fi
	tmp="/tmp/wifi-sta.conf.$$"
	dd bs=1 count="$len" of="$tmp" 2>/dev/null
	if ! grep -q '^network=' "$tmp" || ! grep -q 'ssid=' "$tmp"; then
		rm -f "$tmp"
		echo "ERROR: body is not a wpa_supplicant network block"
		exit 0
	fi
	chmod 600 "$tmp"
	mv "$tmp" "$PROFILE"
	# Make the daemon re-read the profile.  A no-op when nothing runs yet:
	# /init polls for the profile every 5 s and brings the link up then.
	killall -q wpa_supplicant
	echo "OK: profile saved, associating..."
	;;

leave)
	[ "$REQUEST_METHOD" = POST ] || { echo "ERROR: POST required"; exit 0; }
	rm -f "$PROFILE"
	killall -q wpa_supplicant
	killall -q udhcpc
	# /init flushes the address and deletes wlan1 once the profile is gone.
	echo "OK: left the network"
	;;

*)
	echo "ERROR: unknown action"
	;;
esac
