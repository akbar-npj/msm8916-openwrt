#!/bin/busybox sh
# MSM8916 recovery initramfs init (PID 1).
#
# Console : USB ACM  -> host /dev/ttyACM0  (no auth, physical access only)
# Network : br0 (USB NCM + WiFi AP) -> 192.168.10.1, one dnsmasq for both,
#           ssh root@192.168.10.1 with NO password
#                     (OpenWrt 600-allow-blank-root-password.patch; /etc/passwd
#                      field 2 must be empty, dropbear never reads /etc/shadow
#                      because musl has no getspnam())
# Escape  : /sbin/reboot-edl  -> Qualcomm EDL (05c6:9008)
#
# Never use 'exec' for redirection here: a redirection failure terminates a
# non-interactive shell, which would kill PID 1.

export PATH=/bin:/sbin:/usr/bin:/usr/sbin
/bin/busybox --install -s /bin 2>/dev/null

say() {
	echo "recovery: $*" >/dev/ttyGS0 2>/dev/null
	echo "recovery: $*" >/dev/kmsg 2>/dev/null
}
led() {
	for l in /sys/class/leds/*; do
		case "$l" in *"$1"*) echo "$2" >"$l/brightness" 2>/dev/null ;; esac
	done
}

mkdir -p /dev /proc /sys /tmp /var/run /etc/dropbear /root
# The OpenWrt kernel is built WITHOUT devtmpfs (CONFIG_DEVTMPFS is not set -
# OpenWrt populates /dev with mdev), so a devtmpfs mount fails and /dev stays
# empty.  That breaks everything that needs a node, silently:
#   * dnsmasq dies with "failed to seed the random number generator" (/dev/urandom
#     missing) -> no DHCP on USB or WiFi,
#   * the console shell's '>/dev/ttyGS0' creates a REGULAR FILE and the console
#     stays dead,
#   * every '2>/dev/null' in this script creates a file called 'null'.
# So: tmpfs + mdev -s, which builds the nodes from /sys.
if ! mount -t devtmpfs devtmpfs /dev 2>/dev/null; then
	mount -t tmpfs tmpfs /dev 2>/dev/null
	mdev -s 2>/dev/null
fi
mkdir -p /dev/pts
mount -t devpts devpts /dev/pts 2>/dev/null
mount -t proc     none /proc 2>/dev/null
mount -t sysfs    none /sys  2>/dev/null
mount -t tmpfs    none /tmp  2>/dev/null
mkdir -p /sys/kernel/config
mount -t configfs none /sys/kernel/config 2>/dev/null
chmod 700 /root

led red 1

G=/sys/kernel/config/usb_gadget/g1
if [ ! -d "$G" ]; then
	mkdir -p "$G"
	echo 0x1d6b >"$G/idVendor"; echo 0x0104 >"$G/idProduct"
	echo 0x0100 >"$G/bcdDevice"; echo 0xef >"$G/bDeviceClass"
	echo 0x02 >"$G/bDeviceSubClass"; echo 0x01 >"$G/bDeviceProtocol"
	mkdir -p "$G/strings/0x409"
	echo 0000000000 >"$G/strings/0x409/serialnumber"
	echo OpenWrt    >"$G/strings/0x409/manufacturer"
	echo "OpenWrt Recovery" >"$G/strings/0x409/product"
	mkdir -p "$G/configs/c.1/strings/0x409"
	echo recovery >"$G/configs/c.1/strings/0x409/configuration"
	echo 0xe0 >"$G/configs/c.1/bmAttributes"
	echo 250  >"$G/configs/c.1/MaxPower"
	mkdir -p "$G/functions/ncm.usb0"
	echo 02:1d:6b:00:00:01 >"$G/functions/ncm.usb0/dev_addr"
	echo 02:1d:6b:00:00:02 >"$G/functions/ncm.usb0/host_addr"
	ln -sf "$G/functions/ncm.usb0" "$G/configs/c.1/"
	mkdir -p "$G/functions/acm.GS0"
	ln -sf "$G/functions/acm.GS0" "$G/configs/c.1/"
	udc=$(ls /sys/class/udc 2>/dev/null | head -1)
	[ -n "$udc" ] && echo "$udc" >"$G/UDC"
fi

# The gadget's nodes (/dev/ttyGS0, the NCM netdev) only exist now - refresh
# /dev again, or the console below finds no ttyGS0 and never starts.
mdev -s 2>/dev/null

# Kernel modules.  The production kernel builds the wireless stack as MODULES
# (only configfs, the USB gadget and the WCNSS/SMD plumbing are built in), so
# there is no wlan0 - and therefore no AP - until they are loaded.  The
# initramfs has no kmodloader, so load them by hand in dependency order:
#
#   wcn36xx        -> mac80211 -> cfg80211 -> compat
#   qcom_wcnss_pil -> qcom_common, qcom_pil_info, mdt_loader  (WCNSS firmware)
#
# Best-effort by design: a kernel with these built in has no /lib/modules and
# simply skips the step, and any failure only costs the WiFi AP - the USB
# console, DHCP and SSH must never depend on it.  Started before the console
# because the WCNSS firmware boot is the long pole (~5 s).
if [ -d /lib/modules ]; then
	for m in mdt_loader qcom_common qcom_pil_info qcom_wcnss_pil \
		 compat cfg80211 mac80211 wcn36xx; do
		f=$(ls /lib/modules/*/"$m".ko 2>/dev/null | head -1)
		[ -n "$f" ] || continue
		insmod "$f" 2>>/tmp/modules.err
	done
fi

# Console. setsid -c gives the shell a controlling tty; the [ -c ] guard keeps
# a redirection failure from aborting the spawner subshell.
(
	while true; do
		if [ -c /dev/ttyGS0 ]; then
			setsid -c /bin/ash -l </dev/ttyGS0 >/dev/ttyGS0 2>&1
		fi
		sleep 1
	done
) &

i=0
while [ $i -lt 10 ]; do
	nd=$(cat "$G/functions/ncm.usb0/ifname" 2>/dev/null)
	[ -n "$nd" ] && [ -d "/sys/class/net/$nd" ] && break
	i=$((i+1)); sleep 1
done
[ -n "$nd" ] || nd=usb0

# Network: ONE bridge (br0) carrying the USB NCM link and, once the WiFi AP
# comes up, wlan0 as well - the same shape as OpenWrt's br-lan.  A single
# dnsmasq on br0 then serves USB and WiFi clients out of one pool, so a WiFi
# client gets 192.168.10.x exactly like a USB host does, with no routing or
# second subnet involved.
BR=br0
ip link set lo up 2>/dev/null
ip link set "$nd" up 2>/dev/null
if ip link add name "$BR" type bridge 2>/dev/null; then
	ip link set "$BR" up 2>/dev/null
	ip addr add 192.168.10.1/24 dev "$BR" 2>/dev/null
	ip link set "$nd" master "$BR" 2>/dev/null
	DHCP_IF="$BR"
else
	# No bridge support in the kernel: address the USB link directly so the
	# rescue path never depends on the bridge.
	ip addr add 192.168.10.1/24 dev "$nd" 2>/dev/null
	DHCP_IF="$nd"
fi

mkdir -p /tmp
# DHCP + DNS (dnsmasq) so a client on USB *or* WiFi gets 192.168.10.2-20 with
# no manual configuration.  /etc/dnsmasq.conf names br0; the interface is
# substituted so the no-bridge fallback still serves DHCP on usb0.
# dnsmasq, not busybox udhcpd: udhcpd always broadcasts its reply and wcn36xx
# AP mode drops group-addressed frames on an encrypted BSS, so only a unicast
# DHCP reply reaches a WPA2/WPA3 station.  -u root: the initramfs has no
# 'nobody' account for dnsmasq to drop privileges to.
sed "s|^interface=.*|interface=$DHCP_IF|" /etc/dnsmasq.conf >/tmp/dnsmasq.conf
dnsmasq -C /tmp/dnsmasq.conf -u root -k 2>/tmp/dnsmasq.err &

# Best-effort WiFi AP so the box is reachable without a USB cable.  A failure
# here MUST NOT block the USB/SSH rescue path: everything runs in a detached
# subshell, and wlan0 may never appear (no wcn36xx driver / no firmware).
# hostapd joins wlan0 to br0 itself ('bridge=br0' in hostapd.conf), so there is
# no separate 'ip link set wlan0 master' step and no second DHCP server.
(
	n=0
	while [ $n -lt 30 ]; do
		[ -d /sys/class/ieee80211/phy0 ] && break
		n=$((n+1)); sleep 1
	done
	[ -d /sys/class/ieee80211/phy0 ] || exit 0
	# The backports mac80211 the production kernel uses does NOT create a
	# default netdev, so the AP interface has to be made explicitly - a wiphy
	# alone gives 'iw dev' nothing and hostapd no interface.  '__ap' (not 'AP')
	# is the type hostapd expects.
	[ -d /sys/class/net/wlan0 ] || iw phy phy0 interface add wlan0 type __ap 2>/dev/null
	[ -d /sys/class/net/wlan0 ] || exit 0
	# wcn36xx publishes wlan0 ~2 s before its firmware bring-up settles;
	# starting hostapd in that window makes it enable the AP and then tear it
	# down again ~200 ms later.  Settle first, then keep hostapd in the
	# FOREGROUND under a restart loop: 'hostapd -B' closes stderr, so a
	# daemonized failure leaves no log at all.
	sleep 3
	ip link set wlan0 up 2>/dev/null
	while true; do
		hostapd /etc/hostapd.conf >>/tmp/hostapd.log 2>&1
		echo "--- hostapd exited, retrying ---" >>/tmp/hostapd.log
		sleep 5
	done
) &

# ---- WiFi station (AP+STA) -------------------------------------------------
# Joins an existing network so the box is reachable on the user's LAN without a
# USB cable.  The profile is /etc/wifi-sta.conf (wpa_supplicant format), written
# by the web UI; with no profile the station stays off and the AP runs alone.
#
# Deliberately NOT bridged into br0: br0 is 192.168.10.1/24 with its own DHCP
# server, so bridging an upstream LAN into it would answer DHCP on someone
# else's network.  The station takes its own lease instead, and the box ends up
# with a second address on the upstream.
(
	while true; do
		# Nothing to do until a profile exists (the web UI writes it).
		while [ ! -s /etc/wifi-sta.conf ]; do sleep 5; done

		# The AP has to be beaconing first: starting the station while hostapd
		# is still configuring the AP is what loses the wcn36xx scan state,
		# after which the radio answers every scan with -EBUSY until the next
		# boot.  Wait for wlan0, then let the firmware settle (same 3 s as the
		# AP path above).
		n=0
		while [ $n -lt 60 ]; do
			[ -d /sys/class/net/wlan0 ] && break
			n=$((n+1)); sleep 1
		done
		if [ ! -d /sys/class/net/wlan0 ]; then
			sleep 10
			continue
		fi
		sleep 3

		# wpa_supplicant cannot create its own interface; one vif is enough.
		iw dev wlan1 del 2>/dev/null
		iw phy phy0 interface add wlan1 type managed 2>/dev/null
		ip link set wlan1 up 2>/dev/null

		# Run until the profile is removed (leave) or the daemon exits.
		while [ -s /etc/wifi-sta.conf ]; do
			wpa_supplicant -D nl80211 -i wlan1 -c /etc/wifi-sta.conf \
				>>/tmp/wpa.log 2>&1
			echo "--- wpa_supplicant exited, retrying ---" >>/tmp/wpa.log
			sleep 5
		done

		# Profile gone: drop the link and go back to waiting.
		ip addr flush dev wlan1 2>/dev/null
		iw dev wlan1 del 2>/dev/null
	done
) &

# DHCP on the station link, once it associates.  busybox udhcpc needs a hook
# script and the initramfs ships none by default; ours is
# irfs/usr/share/udhcpc/default.script.
(
	while true; do
		i=0
		while [ $i -lt 150 ]; do
			# No station vif at all (no profile / left the network): nothing
			# to wait for, so don't spin through the whole 300 s window.
			[ -d /sys/class/net/wlan1 ] || { i=150; break; }
			iw dev wlan1 link 2>/dev/null | grep -q "Connected to" && break
			i=$((i+1)); sleep 2
		done
		if [ $i -lt 150 ]; then
			if udhcpc -i wlan1 -q -n -t 5 -T 3 >>/tmp/udhcpc.log 2>&1; then
				sleep 600
			else
				sleep 15
			fi
		else
			sleep 10
		fi
	done
) &

# The eMMC is probed ~1 s AFTER this init starts, so the mdev -s near the top
# ran too early to create /dev/mmcblk0*.  Without those nodes nothing can read
# or write the flash: the web UI's "write a partition" fails, and so does any
# hand-run dd.  Wait for the block device, then rescan /dev once.
i=0
while [ $i -lt 20 ]; do
	[ -d /sys/block/mmcblk0 ] && break
	i=$((i+1)); sleep 1
done
mdev -s 2>/dev/null

# Web UI: http://192.168.10.1/ - sysupgrade (-n), write a single partition, or
# reboot into EDL.  Independent of the other services; -f keeps httpd in the
# foreground so its log is captured (the applet would otherwise daemonize and
# close stderr).
(
	httpd -f -p 80 -h /www 2>/tmp/httpd.log
) &


if [ ! -f /etc/dropbear/dropbear_ed25519_host_key ]; then
	dropbearkey -t ed25519 -f /etc/dropbear/dropbear_ed25519_host_key >/tmp/dbk.log 2>&1
fi
dropbear -p 22 -r /etc/dropbear/dropbear_ed25519_host_key -P /var/run/dropbear.pid >/tmp/db.log 2>&1

# Re-emitted every 5 s: boot-time output is lost when the host is not reading
# the ACM port yet.
(
	while true; do
		sleep 5
		{
			echo "=== OpenWrt recovery ==="
			echo "kernel:  $(uname -r)"
			echo "console: /dev/ttyGS0 $([ -c /dev/ttyGS0 ] && echo ready || echo MISSING)"
			echo "network: $(ip -br addr show 2>/dev/null | tr '\n' ' ')"
			echo "ssh:     root@192.168.10.1 (no password)"
		echo "web:     http://192.168.10.1/ (sysupgrade -n, flash a partition, EDL)"
		echo "dhcp:    dnsmasq on $DHCP_IF (192.168.10.2-20)"
		echo "wifi:    hostapd wlan0 -> $BR, OpenWrt-Recovery (WPA2/WPA3, pass 'recovery')"
		_link=$(iw dev wlan1 link 2>/dev/null)
		_sta=$(printf '%s\n' "$_link" | sed -n 's/^[[:space:]]*SSID: //p' | head -1)
		_sig=$(printf '%s\n' "$_link" | sed -n 's/^[[:space:]]*signal: \([-0-9.]*\) dBm/\1/p' | head -1)
		if [ -n "$_sta" ]; then
			echo "sta:     connected to '$_sta' ($_sig dBm)"
		elif [ -s /etc/wifi-sta.conf ]; then
			echo "sta:     connecting..."
		else
			echo "sta:     off (join a network from the web UI)"
		fi
		echo "edl:     run /sbin/reboot-edl"
			echo "=== end ==="
		} >/dev/ttyGS0 2>&1
	done
) &

# This shell is PID 1.  busybox 'reboot' without -f only signals PID 1 and
# waits for init to act, which this init has no shutdown path for - a plain
# 'reboot' over ssh (or on the console) would silently do nothing.  A trap on
# PID 1 is not reliable here, so replace the applets with wrappers that force
# the syscall.  The symlinks created by 'busybox --install -s' must be removed
# first: '>' would otherwise follow them into the busybox binary itself.
for _a in reboot poweroff halt; do
	rm -f "/bin/$_a"
	printf '#!/bin/busybox sh\nsync\nexec /bin/busybox %s -f "$@"\n' "$_a" > "/bin/$_a"
	chmod +x "/bin/$_a"
done

while true; do
	led green 1; sleep 1; led green 0; sleep 1
done
