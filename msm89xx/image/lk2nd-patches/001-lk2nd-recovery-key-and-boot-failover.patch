+#ifdef RECOVERY_KEY_GPIO
+	/* Board reset button on a TLMM GPIO (mf800b/mifib-v12: key_freset =
+	 * GPIO 102, active low, unused by every other board in this project).
+	 * Held at power-on it is reported as VOLUMEUP so that aboot's stock
+	 * key handling boots the recovery partition. */
+	gpio_tlmm_config(RECOVERY_KEY_GPIO, 0, GPIO_INPUT, GPIO_PULL_UP,
+			 GPIO_2MA, GPIO_ENABLE);
+
+	/* Let the TLMM config take effect before sampling.  Without this the
+	 * first read after the config returns 0, which the active-low test
+	 * below reports as "pressed" - every boot would land in recovery.
+	 * The stock target_volume_up() waits for the same reason. */
+	udelay(10000);
+
+#if defined(RECOVERY_KEY_ACTIVE_LOW) && RECOVERY_KEY_ACTIVE_LOW
+	if (!gpio_status(RECOVERY_KEY_GPIO))
+#else
+	if (gpio_status(RECOVERY_KEY_GPIO))
+#endif
+	{
+		dprintf(ALWAYS, "recovery key pressed");
+		keys_post_event(KEY_VOLUMEUP, 1);
+	}
+#endif
 }
 LK2ND_INIT(lk2nd_keys_publish);
 
