+#if defined(BOOT_FAILOVER_COUNT) && BOOT_FAILOVER_COUNT > 0
+	/* Boot-failover: count consecutive boots that never reach userspace
+	 * (OpenWrt clears the counter in S99recovery-bootcount once the
+	 * system is up). After BOOT_FAILOVER_COUNT attempts, boot the
+	 * recovery partition instead - the only rescue path for a board
+	 * whose boot partition is broken and which has no dedicated key.
+	 * Runs before the reboot-reason check so an explicit reboot into
+	 * recovery is never counted. */
+	if (!boot_into_recovery && !boot_into_fastboot)
+	{
+		if (boot_failover_check())
+			boot_into_recovery = 1;
+	}
+#endif
