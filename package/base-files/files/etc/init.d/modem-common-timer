#!/bin/sh /usr/share/procd/init.d
# -*- scheme -*-
# OpenWrt init script for the user‑space common‑timer daemon

START=95
STOP=10
PROG=/usr/sbin/modem-common-timer.sh

start_service() {
    procd_open_instance
    procd_set_param command $PROG
    procd_set_param respawn "$PROG"
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param limit nofile 1024 1024
    procd_set_param environment INTERVAL STALL_TIMEOUT SLEEP_TIMEOUT ISP_DNS IFACE
    procd_close_instance
}

stop_service() {
    killall modem-common-timer.sh 2>/dev/null || true
}
