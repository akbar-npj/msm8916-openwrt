# Failsafe mode: 7 s preinit window (single button press) + the preinit
# USB-gadget IP used to reach the device while in failsafe.  IMAGEOPT and
# PREINITOPT must BOTH be enabled, or the TARGET_PREINIT_* symbols stay
# invisible and `make defconfig` resets them to the defaults (4 s /
# 192.168.1.1).  IMAGEOPT gates PREINITOPT's prompt; PREINITOPT gates the
# TARGET_PREINIT_* prompts.
CONFIG_IMAGEOPT=y
CONFIG_PREINITOPT=y
CONFIG_TARGET_PREINIT_TIMEOUT=7
CONFIG_TARGET_PREINIT_IP="192.168.10.1"
CONFIG_TARGET_PREINIT_NETMASK="255.255.255.0"
CONFIG_TARGET_PREINIT_BROADCAST="192.168.10.255"

