/dts-v1/;

/ {
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	interrupt-parent = <0x01>;
	model = "Qualcomm Technologies, Inc. MSM8939 QRD SKUK";
	compatible = "qcom,msm8939-qrd-skuk", "qcom,msm8939-qrd", "qcom,msm8939", "qcom,qrd";
	qcom,msm-id = <0xe9 0x00 0xf0 0x00 0xf2 0x00>;
	qcom,board-id = <0x1000b 0x05>;

	chosen {
		bootargs = "boot_cpus=0,1 sched_enable_hmp=1";
	};

	aliases {
		sdhc1 = "/soc/sdhci@7824000";
		sdhc2 = "/soc/sdhci@7864000";
		smd0 = "/soc/qcom,smdtty/qcom,smdtty-ds";
		smd1 = "/soc/qcom,smdtty/qcom,smdtty-apps-fm";
		smd2 = "/soc/qcom,smdtty/smdtty-apps-riva-bt-acl";
		smd3 = "/soc/qcom,smdtty/qcom,smdtty-apps-riva-bt-cmd";
		smd5 = "/soc/qcom,smdtty/smdtty-apps-riva-ant-cmd";
		smd6 = "/soc/qcom,smdtty/smdtty-apps-riva-ant-data";
		smd7 = "/soc/qcom,smdtty/qcom,smdtty-data1";
		smd8 = "/soc/qcom,smdtty/qcom,smdtty-data4";
		smd11 = "/soc/qcom,smdtty/qcom,smdtty-data11";
		smd21 = "/soc/qcom,smdtty/qcom,smdtty-data21";
		smd36 = "/soc/qcom,smdtty/smdtty-loopback";
		i2c0 = "/soc/i2c@78b6000";
		i2c4 = "/soc/i2c@78b8000";
		i2c5 = "/soc/i2c@78b9000";
		i2c6 = "/soc/i2c@78ba000";
		spi0 = "/soc/spi@78b7000";
	};

	memory {
		device_type = "memory";
		reg = <0x00 0x00 0x00 0x00>;
		#address-cells = <0x02>;
		#size-cells = <0x02>;

		external_image__region@0 {
			linux,reserve-contiguous-region;
			linux,reserve-region;
			linux,remove-completely;
			reg = <0x00 0x86000000 0x00 0x800000>;
			label = "external_image_mem";
		};

		modem_adsp_region@0 {
			linux,reserve-contiguous-region;
			linux,reserve-region;
			linux,remove-completely;
			reg = <0x00 0x86800000 0x00 0x5500000>;
			label = "modem_adsp_mem";
			linux,phandle = <0x06>;
			phandle = <0x06>;
		};

		pheripheral_region@0 {
			linux,reserve-contiguous-region;
			linux,reserve-region;
			linux,remove-completely;
			reg = <0x00 0x8bd00000 0x00 0x600000>;
			label = "peripheral_mem";
			linux,phandle = <0x05>;
			phandle = <0x05>;
		};

		venus_region@0 {
			linux,reserve-contiguous-region;
			linux,memory-limit = <0x90000000>;
			reg = <0x00 0x00 0x00 0x500000>;
			label = "venus_mem";
			linux,phandle = <0xc8>;
			phandle = <0xc8>;
		};

		secure_region@0 {
			linux,reserve-contiguous-region;
			reg = <0x00 0x00 0x00 0x6d00000>;
			label = "secure_mem";
			linux,phandle = <0x02>;
			phandle = <0x02>;
		};

		qseecom_region@0 {
			linux,reserve-contiguous-region;
			reg = <0x00 0x00 0x00 0x1000000>;
			label = "qseecom_mem";
			linux,phandle = <0x03>;
			phandle = <0x03>;
		};

		audio_region@0 {
			linux,reserve-contiguous-region;
			reg = <0x00 0x00 0x00 0x314000>;
			label = "audio_mem";
			linux,phandle = <0x04>;
			phandle = <0x04>;
		};
	};

	soc {
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges = <0x00 0x00 0x00 0xffffffff>;
		compatible = "simple-bus";

		qcom,ipc_router {
			compatible = "qcom,ipc_router";
			qcom,node-id = <0x01>;
		};

		qcom,ipc_router_modem_xprt {
			compatible = "qcom,ipc_router_smd_xprt";
			qcom,ch-name = "IPCRTR";
			qcom,xprt-remote = "modem";
			qcom,xprt-linkid = <0x01>;
			qcom,xprt-version = <0x01>;
			qcom,fragmented-data;
		};

		qcom,ipc_router_wcnss_xprt {
			compatible = "qcom,ipc_router_smd_xprt";
			qcom,ch-name = "IPCRTR";
			qcom,xprt-remote = "wcnss";
			qcom,xprt-linkid = <0x01>;
			qcom,xprt-version = <0x01>;
			qcom,fragmented-data;
		};

		qcom,ion {
			compatible = "qcom,msm-ion";
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			qcom,ion-heap@25 {
				reg = <0x19>;
				qcom,ion-heap-type = "SYSTEM";
			};

			qcom,ion-heap@21 {
				reg = <0x15>;
				qcom,ion-heap-type = "SYSTEM_CONTIG";
			};

			qcom,ion-heap@8 {
				compatible = "qcom,msm-ion-reserve";
				reg = <0x08>;
				qcom,heap-align = <0x1000>;
				linux,contiguous-region = <0x02>;
				qcom,ion-heap-type = "SECURE_DMA";
			};

			qcom,ion-heap@27 {
				compatible = "qcom,msm-ion-reserve";
				reg = <0x1b>;
				linux,contiguous-region = <0x03>;
				qcom,ion-heap-type = "DMA";
			};

			qcom,ion-heap@28 {
				compatible = "qcom,msm-ion-reserve";
				reg = <0x1c>;
				linux,contiguous-region = <0x04>;
				qcom,ion-heap-type = "DMA";
			};

			qcom,ion-heap@23 {
				compatible = "qcom,msm-ion-reserve";
				reg = <0x17>;
				linux,contiguous-region = <0x05>;
				qcom,ion-heap-type = "DMA";
			};

			qcom,ion-heap@26 {
				compatible = "qcom,msm-ion-reserve";
				reg = <0x1a>;
				linux,contiguous-region = <0x06>;
				qcom,ion-heap-type = "DMA";
			};
		};

		qcom,iommu@1f00000 {
			compatible = "qcom,msm-smmu-v2", "qcom,msm-mmu-500";
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			ranges;
			reg = <0x1f00000 0x10000>;
			reg-names = "iommu_base";
			interrupts = <0x00 0x2b 0x00 0x00 0x2a 0x00>;
			interrupt-names = "global_cfg_NS_irq", "global_cfg_S_irq";
			label = "gfx_iommu";
			qcom,iommu-secure-id = <0x12>;
			clocks = <0x07 0x75eaefa5 0x07 0x59505e55>;
			clock-names = "iface_clk", "core_clk";
			status = "ok";
			linux,phandle = <0xd9>;
			phandle = <0xd9>;

			qcom,iommu-ctx@1f09000 {
				compatible = "qcom,msm-smmu-v2-ctx";
				reg = <0x1f09000 0x1000>;
				interrupts = <0x00 0xf1 0x00>;
				qcom,iommu-ctx-sids = <0x00>;
				label = "gfx3d_user";
			};

			qcom,iommu-ctx@1f0a000 {
				compatible = "qcom,msm-smmu-v2-ctx";
				reg = <0x1f0a000 0x1000>;
				interrupts = <0x00 0xf2 0x00>;
				qcom,iommu-ctx-sids = <0x01>;
				label = "gfx3d_priv";
			};
		};

		qcom,iommu@1e00000 {
			compatible = "qcom,msm-smmu-v2", "qcom,msm-mmu-500";
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			ranges;
			reg = <0x1e00000 0x40000>;
			reg-names = "iommu_base";
			interrupts = <0x00 0x2b 0x00 0x00 0x2a 0x00>;
			interrupt-names = "global_cfg_NS_irq", "global_cfg_S_irq";
			label = "apps_iommu";
			qcom,iommu-secure-id = <0x11>;
			clocks = <0x07 0x75eaefa5 0x07 0xaf56a329>;
			clock-names = "iface_clk", "core_clk";
			qcom,cb-base-offset = <0x20000>;
			status = "ok";

			qcom,iommu-ctx@1e22000 {
				compatible = "qcom,msm-smmu-v2-ctx";
				reg = <0x1e22000 0x1000>;
				interrupts = <0x00 0x35 0x00>;
				qcom,iommu-ctx-sids = <0x2000>;
				label = "jpeg_enc0";
			};

			qcom,iommu-ctx@1e23000 {
				compatible = "qcom,msm-smmu-v2-ctx";
				reg = <0x1e23000 0x1000>;
				interrupts = <0x00 0x36 0x00>;
				qcom,iommu-ctx-sids = <0x400>;
				label = "vfe";
			};

			qcom,iommu-ctx@1e24000 {
				compatible = "qcom,msm-smmu-v2-ctx";
				reg = <0x1e24000 0x1000>;
				interrupts = <0x00 0x3a 0x00>;
				qcom,iommu-ctx-sids = <0xc00 0x2800>;
				label = "mdp_0";
			};

			qcom,iommu-ctx@1e25000 {
				compatible = "qcom,msm-smmu-v2-ctx";
				reg = <0x1e25000 0x1000>;
				interrupts = <0x00 0x3c 0x00>;
				qcom,iommu-ctx-sids = <0x800 0x801 0x802 0x803 0x804 0x805 0x807>;
				label = "venus_ns";
				linux,phandle = <0x62>;
				phandle = <0x62>;
			};

			qcom,iommu-ctx@1e26000 {
				compatible = "qcom,msm-smmu-v2-ctx";
				reg = <0x1e26000 0x1000>;
				interrupts = <0x00 0x3d 0x00>;
				qcom,iommu-ctx-sids = <0x2400>;
				label = "cpp";
			};

			qcom,iommu-ctx@1e27000 {
				compatible = "qcom,msm-smmu-v2-ctx";
				reg = <0x1e27000 0x1000>;
				interrupts = <0x00 0x4c 0x00>;
				qcom,iommu-ctx-sids = <0x1000>;
				label = "mDSP";
			};

			qcom,iommu-ctx@1e28000 {
				compatible = "qcom,msm-smmu-v2-ctx";
				reg = <0x1e28000 0x1000>;
				interrupts = <0x00 0x4d 0x00>;
				qcom,iommu-ctx-sids = <0x1400>;
				label = "gss";
			};

			qcom,iommu-ctx@1e29000 {
				compatible = "qcom,msm-smmu-v2-ctx";
				reg = <0x1e29000 0x1000>;
				interrupts = <0x00 0x50 0x00>;
				qcom,iommu-ctx-sids = <0x1800>;
				label = "a2";
			};

			qcom,iommu-ctx@1e32000 {
				compatible = "qcom,msm-smmu-v2-ctx";
				qcom,secure-context;
				reg = <0x1e32000 0x1000>;
				interrupts = <0x00 0x6e 0x00 0x00 0x6e 0x00>;
				qcom,iommu-ctx-sids = <0xc01 0x2801>;
				label = "mdp_1";
			};

			qcom,iommu-ctx@1e33000 {
				compatible = "qcom,msm-smmu-v2-ctx";
				qcom,secure-context;
				reg = <0x1e33000 0x1000>;
				interrupts = <0x00 0x6f 0x00 0x00 0x6f 0x00>;
				qcom,iommu-ctx-sids = <0x885>;
				label = "venus_sec_pixel";
				linux,phandle = <0x64>;
				phandle = <0x64>;
			};

			qcom,iommu-ctx@1e34000 {
				compatible = "qcom,msm-smmu-v2-ctx";
				qcom,secure-context;
				reg = <0x1e34000 0x1000>;
				interrupts = <0x00 0x70 0x00 0x00 0x70 0x00>;
				qcom,iommu-ctx-sids = <0x880 0x881 0x882 0x883 0x884>;
				label = "venus_sec_bitstream";
				linux,phandle = <0x63>;
				phandle = <0x63>;
			};

			qcom,iommu-ctx@1e35000 {
				compatible = "qcom,msm-smmu-v2-ctx";
				qcom,secure-context;
				reg = <0x1e35000 0x1000>;
				interrupts = <0x00 0x71 0x00 0x00 0x71 0x00>;
				qcom,iommu-ctx-sids = <0x887 0x8a0>;
				label = "venus_sec_non_pixel";
				linux,phandle = <0x65>;
				phandle = <0x65>;
			};

			qcom,iommu-ctx@1e36000 {
				compatible = "qcom,msm-smmu-v2-ctx";
				qcom,secure-context;
				reg = <0x1e36000 0x1000>;
				interrupts = <0x00 0x72 0x00 0x00 0x72 0x00>;
				qcom,iommu-ctx-sids = <0x8c0 0x8c6>;
				label = "venus_fw";
			};

			qcom,iommu-ctx@1e37000 {
				compatible = "qcom,msm-smmu-v2-ctx";
				qcom,secure-context;
				reg = <0x1e37000 0x1000>;
				interrupts = <0x00 0x73 0x00 0x00 0x73 0x00>;
				qcom,iommu-ctx-sids = <0x40>;
				label = "periph_rpm";
			};

			qcom,iommu-ctx@1e38000 {
				compatible = "qcom,msm-smmu-v2-ctx";
				reg = <0x1e38000 0x1000>;
				interrupts = <0x00 0x74 0x00>;
				qcom,iommu-ctx-sids = <0xc0 0xc4 0xc8 0xcc 0xd0 0xd3 0xd4 0xd7 0xd8 0xdb 0xdc 0xdf 0xf0 0xf3 0xf4 0xf7 0xf8 0xfb 0xfc 0xff>;
				label = "periph_CE";
			};

			qcom,iommu-ctx@1e39000 {
				compatible = "qcom,msm-smmu-v2-ctx";
				reg = <0x1e39000 0x1000>;
				interrupts = <0x00 0x75 0x00>;
				qcom,iommu-ctx-sids = <0x280 0x283 0x284 0x287 0x288 0x28b 0x28c 0x28f 0x290 0x293 0x294 0x297 0x298 0x29b 0x29c 0x29f>;
				label = "periph_BLSP";
			};

			qcom,iommu-ctx@1e3a000 {
				compatible = "qcom,msm-smmu-v2-ctx";
				reg = <0x1e3a000 0x1000>;
				interrupts = <0x00 0x76 0x00>;
				qcom,iommu-ctx-sids = <0x100>;
				label = "periph_SDC1";
			};

			qcom,iommu-ctx@1e3b000 {
				compatible = "qcom,msm-smmu-v2-ctx";
				reg = <0x1e3b000 0x1000>;
				interrupts = <0x00 0x77 0x00>;
				qcom,iommu-ctx-sids = <0x140>;
				label = "periph_SDC2";
			};

			qcom,iommu-ctx@1e3c000 {
				compatible = "qcom,msm-smmu-v2-ctx";
				reg = <0x1e3c000 0x1000>;
				interrupts = <0x00 0x78 0x00>;
				qcom,iommu-ctx-sids = <0x1c0>;
				label = "periph_audio";
			};

			qcom,iommu-ctx@1e3d000 {
				compatible = "qcom,msm-smmu-v2-ctx";
				reg = <0x1e3d000 0x1000>;
				interrupts = <0x00 0x79 0x00>;
				qcom,iommu-ctx-sids = <0x2c0>;
				label = "periph_USB_HS1";
			};
		};

		qcom,gdsc@184c018 {
			compatible = "qcom,gdsc";
			regulator-name = "gdsc_venus";
			reg = <0x184c018 0x04>;
			status = "okay";
			clock-names = "bus_clk", "core_clk";
			clocks = <0x07 0xcdf4c8f6 0x07 0xf76a02bb>;
			linux,phandle = <0xc7>;
			phandle = <0xc7>;
		};

		qcom,gdsc@184d078 {
			compatible = "qcom,gdsc";
			regulator-name = "gdsc_mdss";
			reg = <0x184d078 0x04>;
			status = "okay";
			clock-names = "core_clk", "bus_clk";
			clocks = <0x07 0x22f3521f 0x07 0x668f51de>;
			linux,phandle = <0x52>;
			phandle = <0x52>;
		};

		qcom,gdsc@185701c {
			compatible = "qcom,gdsc";
			regulator-name = "gdsc_jpeg";
			reg = <0x185701c 0x04>;
			status = "okay";
			clock-names = "core_clk", "bus_clk";
			clocks = <0x07 0x1ed3f032 0x07 0x3e278896>;
			linux,phandle = <0x67>;
			phandle = <0x67>;
		};

		qcom,gdsc@1858034 {
			compatible = "qcom,gdsc";
			regulator-name = "gdsc_vfe";
			reg = <0x1858034 0x04>;
			status = "okay";
			clock-names = "core_clk", "bus_clk", "micro_clk", "cpp_clk", "csi_clk";
			clocks = <0x07 0xaaa3cd97 0x07 0x77fe2384 0x07 0xfbbee8cf 0x07 0x7118a0de 0x07 0xcc73453c>;
			linux,phandle = <0x66>;
			phandle = <0x66>;
		};

		qcom,gdsc@185901c {
			compatible = "qcom,gdsc";
			regulator-name = "gdsc_oxili_gx";
			reg = <0x185901c 0x04>;
			status = "okay";
			clock-names = "core_root_clk", "core_clk", "gmem_clk";
			clocks = <0x07 0x917f76ef 0x07 0x49a51fd9 0x07 0x5620913a>;
			qcom,enable-root-clk;
			linux,phandle = <0xd8>;
			phandle = <0xd8>;
		};

		qcom,gdsc@184c028 {
			compatible = "qcom,gdsc";
			regulator-name = "gdsc_venus_core0";
			reg = <0x184c028 0x04>;
			status = "okay";
			qcom,support-hw-trigger;
			clock-names = "core0_clk";
			clocks = <0x07 0x83a7f549>;
			linux,phandle = <0xcd>;
			phandle = <0xcd>;
		};

		qcom,gdsc@184c030 {
			compatible = "qcom,gdsc";
			regulator-name = "gdsc_venus_core1";
			reg = <0x184c030 0x04>;
			status = "okay";
			qcom,support-hw-trigger;
			clock-names = "core1_clk";
			clocks = <0x07 0xa0813de6>;
			linux,phandle = <0xce>;
			phandle = <0xce>;
		};

		ad-hoc-bus@580000 {
			compatible = "qcom,msm-bus-device";
			reg = <0x580000 0x14080 0x580000 0x14080 0x400000 0x62000 0x500000 0x11000>;
			reg-names = "snoc-base", "snoc-mm-base", "bimc-base", "pnoc-base";

			fab-snoc {
				cell-id = <0x400>;
				label = "fab-snoc";
				qcom,fab-dev;
				qcom,base-name = "snoc-base";
				qcom,base-offset = <0x7000>;
				qcom,qos-off = <0x1000>;
				qcom,bus-type = <0x01>;
				clock-names = "bus_clk", "bus_a_clk";
				clocks = <0x08 0xe6900bb6 0x08 0x5d4683bd>;
				coresight-id = <0x32>;
				coresight-name = "coresight-snoc";
				coresight-nr-inports = <0x00>;
				coresight-outports = <0x00>;
				coresight-child-list = <0x09>;
				coresight-child-ports = <0x05>;
				linux,phandle = <0x12>;
				phandle = <0x12>;
			};

			fab-snoc-mm {
				cell-id = <0x800>;
				label = "fab-snoc-mm";
				qcom,fab-dev;
				qcom,base-name = "snoc-mm-base";
				qcom,base-offset = <0x7000>;
				qcom,qos-off = <0x1000>;
				qcom,bus-type = <0x01>;
				clock-names = "bus_clk", "bus_a_clk";
				clocks = <0x08 0xd61e5721 0x08 0x50600f1b>;
				linux,phandle = <0x0c>;
				phandle = <0x0c>;
			};

			fab-bimc {
				cell-id = <0x00>;
				label = "fab-bimc";
				qcom,fab-dev;
				qcom,base-name = "bimc-base";
				qcom,bus-type = <0x02>;
				clock-names = "bus_clk", "bus_a_clk";
				clocks = <0x08 0xd212feea 0x08 0x71d1a499>;
				coresight-id = <0x37>;
				coresight-name = "coresight-bimc";
				coresight-nr-inports = <0x00>;
				coresight-outports = <0x00>;
				coresight-child-list = <0x09>;
				coresight-child-ports = <0x03>;
				linux,phandle = <0x24>;
				phandle = <0x24>;
			};

			fab-pnoc {
				cell-id = <0x1000>;
				label = "fab-pnoc";
				qcom,fab-dev;
				qcom,base-name = "pnoc-base";
				qcom,base-offset = <0x7000>;
				qcom,qos-delta = <0x1000>;
				qcom,bus-type = <0x01>;
				clock-names = "bus_clk", "bus_a_clk";
				clocks = <0x08 0x2b53b688 0x08 0x9753a54f>;
				coresight-id = <0x36>;
				coresight-name = "coresight-pnoc";
				coresight-nr-inports = <0x00>;
				coresight-outports = <0x00>;
				coresight-child-list = <0x09>;
				coresight-child-ports = <0x06>;
				linux,phandle = <0x27>;
				phandle = <0x27>;
			};

			mas-video {
				cell-id = <0x3f>;
				label = "mas-video";
				qcom,qport = <0x08>;
				qcom,ap-owned;
				qcom,connections = <0x0a 0x0b>;
				qcom,bus-dev = <0x0c>;
				qcom,qos-mode = "bypass";
