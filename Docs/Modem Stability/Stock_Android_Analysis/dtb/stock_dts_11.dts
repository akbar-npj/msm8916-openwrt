		gpio_keys {
			compatible = "gpio-keys";
			input-name = "gpio-keys";
			pinctrl-names = "tlmm_gpio_key_active", "tlmm_gpio_key_suspend";
			pinctrl-0 = <0x113>;
			pinctrl-1 = <0x114>;

			vol_up {
				label = "volume_up";
				gpios = <0x5e 0x6b 0x01>;
				linux,input-type = <0x01>;
				linux,code = <0x73>;
				gpio-key,wakeup;
				debounce-interval = <0x0f>;
			};
		};

		flashlight {
			compatible = "qcom,leds-gpio-flash";
			status = "okay";
			pinctrl-names = "flash_default";
			pinctrl-0 = <0x115>;
			qcom,flash-en = <0x5e 0x1f 0x00>;
			qcom,flash-now = <0x5e 0x20 0x00>;
			qcom,op-seq = "flash_en", "flash_now";
			qcom,torch-seq-val = <0x01 0x00>;
			qcom,flash-seq-val = <0x00 0x01>;
			linux,name = "flashlight";
			linux,default-trigger = "flashlight-trigger";
			linux,phandle = <0x116>;
			phandle = <0x116>;
		};

		qcom,camera-led-flash {
			cell-index = <0x00>;
			compatible = "qcom,camera-led-flash";
			qcom,flash-type = <0x03>;
			qcom,flash-source = <0x116>;
			qcom,torch-source = <0x116>;
			linux,phandle = <0x74>;
			phandle = <0x74>;
		};

		gen-vkeys {
			compatible = "qcom,gen-vkeys";
			label = "ft5x06_ts";
			qcom,disp-maxx = <0x438>;
			qcom,disp-maxy = <0x780>;
			qcom,panel-maxx = <0x438>;
			qcom,panel-maxy = <0x832>;
			qcom,key-codes = <0x8b 0xac 0x9e>;
			qcom,y-offset = <0x00>;
		};

		sound {
			compatible = "qcom,msm8x16-audio-codec";
			qcom,model = "msm8939-snd-card-skuk";
			qcom,msm-snd-card-id = <0x00>;
			qcom,msm-codec-type = "internal";
			qcom,msm-ext-pa = "primary";
			qcom,msm-mbhc-hphl-swh = <0x01>;
			qcom,msm-mbhc-gnd-swh = <0x00>;
			qcom,msm-micbias1-ext-cap;
			qcom,msm-hs-micbias-type = "internal";
			qcom,audio-routing = "RX_BIAS", "MCLK", "SPK_RX_BIAS", "MCLK", "INT_LDO_H", "MCLK", "MIC BIAS External", "Handset Mic", "MIC BIAS Internal2", "Headset Mic", "MIC BIAS External", "Secondary Mic", "AMIC1", "MIC BIAS External", "AMIC2", "MIC BIAS Internal2", "AMIC3", "MIC BIAS External";
			pinctrl-names = "cdc_lines_act", "cdc_lines_sus";
			pinctrl-0 = <0x117>;
			pinctrl-1 = <0x118>;
		};
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x00>;
			enable-method = "qcom,arm-cortex-acc";
			qcom,acc = <0x119>;
			next-level-cache = <0x11a>;
			linux,phandle = <0x102>;
			phandle = <0x102>;

			l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				power-domain = <0x11b>;
				linux,phandle = <0x11a>;
				phandle = <0x11a>;
			};
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x01>;
			enable-method = "qcom,arm-cortex-acc";
			qcom,acc = <0x11c>;
			next-level-cache = <0x11a>;
			linux,phandle = <0x103>;
			phandle = <0x103>;
		};

		cpu@2 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x02>;
			enable-method = "qcom,arm-cortex-acc";
			qcom,acc = <0x11d>;
			next-level-cache = <0x11a>;
			linux,phandle = <0x104>;
			phandle = <0x104>;
		};

		cpu@3 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x03>;
			enable-method = "qcom,arm-cortex-acc";
			qcom,acc = <0x11e>;
			next-level-cache = <0x11a>;
			linux,phandle = <0x105>;
			phandle = <0x105>;
		};
	};
};
