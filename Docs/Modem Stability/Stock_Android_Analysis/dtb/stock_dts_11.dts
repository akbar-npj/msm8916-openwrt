			qcom,iris-vddpa-supply = <0x7a>;
			qcom,iris-vdddig-supply = <0x7b>;
			pinctrl-names = "wcnss_default", "wcnss_sleep", "wcnss_gpio_default";
			pinctrl-0 = <0x7c>;
			pinctrl-1 = <0x7d>;
			pinctrl-2 = <0x7e>;
			gpios = <0x5e 0x28 0x00 0x5e 0x29 0x00 0x5e 0x2a 0x00 0x5e 0x2b 0x00 0x5e 0x2c 0x00>;
			clocks = <0x08 0x116b76f 0x08 0x24a30992 0x7f 0x8121ac15 0x07 0x709f430b>;
			clock-names = "xo", "rf_clk", "measure", "wcnss_debug";
