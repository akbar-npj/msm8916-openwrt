--- a/drivers/net/wwan/qcom_bam_dmux.c
+++ b/drivers/net/wwan/qcom_bam_dmux.c
@@ -1900,6 +1900,27 @@
 	if (new_state == READ_ONCE(dmux->pc_state))
 		return IRQ_HANDLED;
 
+	/*
+	 * *** TEMPORARY TEST BUILD (not patch 814) ***
+	 * Simulate a LOST pc-line assert edge.  The modem's SMEM state word
+	 * says the line is high, but this handler deliberately does nothing
+	 * at all, exactly as if the edge had never reached SMSM -- the
+	 * failure mode Doc 157 section 5.1 observed live (pc_irq_count
+	 * frozen while the parent GIC line kept firing).  Only the SSR
+	 * powerup retry and the RX watchdog poll paths can then rebuild the
+	 * channels, which is precisely the code path this test exists to
+	 * exercise.  The pc IRQ is edge-triggered (`smsm 1 Edge`) and SMSM's
+	 * cascade handler is edge-based on a cached value, so dropping the
+	 * edge here cannot cause an interrupt storm.
+	 * REVERT THIS before rebuilding the production module.
+	 */
+	if (new_state && (!READ_ONCE(dmux->rx) || !READ_ONCE(dmux->tx))) {
+		dev_warn(dmux->dev,
+			 "bam_dmux: TEST: pc assert edge DROPPED (rx=%px tx=%px) -- only the poll path can recover now\n",
+			 dmux->rx, dmux->tx);
+		return IRQ_HANDLED;
+	}
+
 	mutex_lock(&dmux->state_lock);
 	if (new_state) {
 		WRITE_ONCE(dmux->pm_suspend_start_ns, 0);
